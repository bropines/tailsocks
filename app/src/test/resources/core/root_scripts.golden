    i=$((i+1))
    top=""
    while read -r f1 f2 f3 root mnt rest; do
        if [ "$mnt" = /system/etc/hosts ]; then top="$root"; fi
    done < /proc/self/mountinfo
    ours=0
    case "$top" in '<HOSTS>'|'<HOSTS-REL>') ours=1;; esac
    [ $ours = 1 ] || grep -qxF '# TailSocks MagicDNS names, <HOSTS>' /system/etc/hosts 2>/dev/null || break
    umount /system/etc/hosts 2>/dev/null || break
done

=== launchLockDir ===
/data/user/0/app/files/root-daemon-launch.lock
=== launchGuardScript ===
TS_LAUNCH_LOCK='/data/user/0/app/files/root-daemon-launch.lock'
TS_LAUNCH_PAT='--socket=/data/user/0/app/files/tailscaled.sock'
ts_launch_lock() {
    mkdir "$TS_LAUNCH_LOCK" 2>/dev/null && (set -C; echo $$ > "$TS_LAUNCH_LOCK/pid") 2>/dev/null && return 0
    h=$(cat "$TS_LAUNCH_LOCK/pid" 2>/dev/null)
    b=$(stat -c %Y "$TS_LAUNCH_LOCK" 2>/dev/null) || b=$(date +%s)
    if [ $(($(date +%s) - b)) -le 60 ]; then
        [ -z "$h" ] && return 1
        kill -0 "$h" 2>/dev/null && return 1
    fi
    rm -rf "$TS_LAUNCH_LOCK"
    mkdir "$TS_LAUNCH_LOCK" 2>/dev/null || return 1
    (set -C; echo $$ > "$TS_LAUNCH_LOCK/pid") 2>/dev/null
}
ts_launch_lock || { echo 'launch: skipped, another launch for this socket is in progress'; exit 0; }
trap 'rm -rf "$TS_LAUNCH_LOCK"' EXIT
trap 'exit 1' HUP INT TERM
if pgrep -f -- "$TS_LAUNCH_PAT" >/dev/null 2>&1; then echo 'launch: skipped, a daemon for this socket is already running'; exit 0; fi

=== logTrimScript ===
if [ -f '/data/user/0/app/logs/tailscaled.log' ]; then
    LOG_SIZE="$(wc -c < '/data/user/0/app/logs/tailscaled.log' 2>/dev/null || echo 0)"
    if [ "$LOG_SIZE" -gt 2097152 ] 2>/dev/null; then
        tail -n 500 '/data/user/0/app/logs/tailscaled.log' > '/data/user/0/app/logs/tailscaled.log.tmp' && mv '/data/user/0/app/logs/tailscaled.log.tmp' '/data/user/0/app/logs/tailscaled.log'
    fi
fi

