=== applyVerifyScript tt ===
ip addr show dev tailscale0 2>/dev/null | grep -qE 'inet6? (100\.|fd7a:115c:a1e0:)' || echo 'daemon: tailscale0 has no tailnet address'
ip route show table 52 2>/dev/null | grep -q '^default' || echo 'daemon: no default route in table 52 with an exit node selected'
ip route show table 53 2>/dev/null | grep -q . || { echo 'verify: table 53 is empty'; exit 1; }
TS_RULES=$(ip rule show 2>/dev/null)
printf '%s\n' "$TS_RULES" | grep -q '^100:.*fwmark 0x1000000/0x1000000 lookup 53' || { echo 'verify: priority-100 fwmark rule into table 53 missing'; exit 1; }
printf '%s\n' "$TS_RULES" | grep -q '^100:.*to 100\.64\.0\.0/10 .*lookup 53' || { echo 'verify: priority-100 tailnet destination rule into table 53 missing'; exit 1; }
iptables -w -t mangle -C OUTPUT -d 100.64.0.0/10 -j TAILSOCKS_MARK 2>/dev/null || { echo 'verify: mangle OUTPUT jump into TAILSOCKS_MARK missing'; exit 1; }
iptables -w -t nat -S TAILSOCKS_DNS >/dev/null 2>&1 || { echo 'verify: TAILSOCKS_DNS chain missing'; exit 1; }
[ "$(iptables -w -t nat -S TAILSOCKS_DNS 2>/dev/null | grep -c -- '-j DNAT')" -ge 2 ] || { echo 'verify: TAILSOCKS_DNS lacks its DNAT lines'; exit 1; }
echo 'verify: ok'

