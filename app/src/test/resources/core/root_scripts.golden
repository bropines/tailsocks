=== hostsUnbindScript ===
i=0
while [ $i -lt 4 ]; do
    i=$((i+1))
    top=""
    while read -r f1 f2 f3 root mnt rest; do
        if [ "$mnt" = /system/etc/hosts ]; then top="$root"; fi
    done < /proc/self/mountinfo
    ours=0
    case "$top" in '/data/adb/tailsocks/hosts'|'/adb/tailsocks/hosts') ours=1;; esac
    [ $ours = 1 ] || grep -qxF '# marker it'\''s' /system/etc/hosts 2>/dev/null || break
    umount /system/etc/hosts 2>/dev/null || break
done

