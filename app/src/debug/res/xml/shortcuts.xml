<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcuts (long press on the icon). The debug build's copy of src/main's, for its .dev package: keep the two alike.
     Every launcher icon's alias in the manifest names this file; only the enabled one counts.
     On / off goes to ToggleActivity, which is not exported: only this app's own shortcut
     reaches it. TailCat is the tailsocks://tailcat link, opened over the main screen, so
     back leads there. Send file asks the system picker for files, then shows the share sheet. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="toggle"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_power"
        android:shortcutShortLabel="@string/shortcut_toggle_short"
        android:shortcutLongLabel="@string/shortcut_toggle_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.bropines.tailscaled.dev"
            android:targetClass="io.github.bropines.tailscaled.ui.ToggleActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="tailcat"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_tailcat"
        android:shortcutShortLabel="@string/shortcut_tailcat_short"
        android:shortcutLongLabel="@string/shortcut_tailcat_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="tailsocks://tailcat"
            android:targetPackage="io.github.bropines.tailscaled.dev"
            android:targetClass="io.github.bropines.tailscaled.ui.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="send_file"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_send_file"
        android:shortcutShortLabel="@string/shortcut_send_file_short"
        android:shortcutLongLabel="@string/shortcut_send_file_long">
        <intent
            android:action="io.github.bropines.tailscaled.action.PICK_AND_SEND"
            android:targetPackage="io.github.bropines.tailscaled.dev"
            android:targetClass="io.github.bropines.tailscaled.ui.ShareActivity" />
    </shortcut>
</shortcuts>
