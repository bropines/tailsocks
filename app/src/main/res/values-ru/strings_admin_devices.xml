    <!-- Tags -->
    <string name="admin_dev_tags_title">Теги %1$s</string>
    <string name="admin_dev_tags_owner_warning">С тегом устройство перестаёт принадлежать пользователю %1$s: дальше им владеют теги. Просто так это не отменить — вернуть его человеку можно, только сняв теги в веб-консоли или заново войдя на устройстве.</string>
    <string name="admin_dev_tags_clear_warning">Без тегов устройству снова нужен владелец-пользователь: кому оно достанется, решит сервер, и устройству может понадобиться войти заново.</string>
    <string name="admin_dev_tags_save">Сохранить теги</string>

    <!-- IPv4 -->
    <string name="admin_dev_ip_title">IPv4-адрес %1$s</string>
    <string name="admin_dev_ip_label">Новый IPv4-адрес</string>
    <string name="admin_dev_ip_help">Внутри 100.64.0.0/10 и не занятый другим устройством. Текущие подключения к нему оборвутся, а другие узлы найдут его по новому адресу, как только получат обновление.</string>
    <string name="admin_dev_ip_malformed">Это не IPv4-адрес; нужен вида 100.80.0.1.</string>
    <string name="admin_dev_ip_outside">Адрес должен быть внутри 100.64.0.0/10: от 100.64.0.0 до 100.127.255.255.</string>
    <string name="admin_dev_ip_reserved">Этот адрес Tailscale держит за собой.</string>
    <string name="admin_dev_ip_taken">Уже занят: %1$s.</string>
    <string name="admin_dev_ip_unchanged">Это и есть его текущий адрес.</string>
    <string name="admin_dev_ip_continue">Продолжить</string>
    <string name="admin_dev_change_ip">Сменить IPv4-адрес %1$s</string>
    <string name="admin_dev_change_ip_effect">Подключения к нему оборвутся; узлы будут находить его по адресу %1$s, а DNS-кэши ещё какое-то время могут помнить старый.</string>

