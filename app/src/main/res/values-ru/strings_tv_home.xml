<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Signing in without a browser on the device: the link as a QR code (ui/SignIn.kt) -->
    <!-- The logged-out card, on a phone: the link for another device to open -->
    <string name="signin_other_device">Войти с другого устройства</string>
    <string name="signin_other_device_help">Откройте ссылку на любом телефоне или компьютере и войдите там — это устройство продолжит само. Кто войдёт, тот и решит, в чей тейлнет попадёт устройство, поэтому отправляйте ссылку только владельцу тейлнета.</string>
    <!-- %1$s: the device's name, %2$s: the link -->
    <string name="signin_share_message">Ссылка для входа устройства «%1$s» (TailSocks): %2$s\nОткройте её и войдите, чтобы пустить устройство в свой тейлнет.</string>

    <!-- The same on a television: a screen of its own -->
    <string name="tv_signin_title">Войдите с телефона</string>
    <string name="tv_signin_step">Наведите камеру телефона на код и войдите. Этот экран продолжит сам.</string>
    <string name="tv_signin_or_link">Или откройте на любом устройстве:</string>
    <string name="tv_signin_preparing">Получаем код…</string>
    <string name="tv_signin_waiting">Ждём, пока вы войдёте…</string>
    <string name="tv_signin_slow">Сервер входа не отвечает. Если сеть его блокирует, сначала настройте прокси или обход.</string>
    <string name="tv_signin_new_code">Новый код</string>
    <string name="tv_signin_new_code_hint">«Новый код» — если телефон не принимает этот.</string>
    <string name="tv_signin_new_code_failed">Нового кода нет: %1$s</string>
    <string name="tv_signin_not_ready">служба пока не ждёт входа, попробуйте чуть позже</string>
    <string name="tv_signin_later">Не сейчас</string>
    <string name="tv_signin_open">Войти</string>

    <!-- Home on a television: the remote's OK instead of a tap (the status card, the exit node row) -->
    <string name="tv_home_start">OK — запустить</string>
    <string name="tv_home_active">Служба запущена • OK — остановить</string>
    <string name="tv_home_active_root">Система идёт через tailscale0 • OK — остановить</string>
    <string name="tv_home_active_root_yielded">Только тейлнет — устройство держит другой VPN • OK — остановить</string>
    <string name="tv_home_active_root_shared">Ведём приложения вне чужого VPN • OK — остановить</string>
    <string name="tv_home_degraded">%1$s • OK — остановить</string>
    <string name="tv_home_needs_login">Войдите ниже • OK — остановить</string>
    <string name="tv_home_exit_node_none">OK — выбрать выходной узел</string>

    <!-- Stopping asks first: OK on a remote is pressed by accident -->
    <string name="tv_stop_title">Остановить TailSocks?</string>
    <string name="tv_stop_text">Связь с тейлнетом пропадёт, пока вы не запустите его снова.</string>

    <!-- Onboarding on a television: the login step -->
    <string name="tv_onboarding_login_desc">Для входа нужен телефон: когда служба запустится, на этом экране появится код для его камеры. Войти можно и ключом — это подождёт.</string>

    <string name="tv_signin_key_refused">Ключ доступа не принят.</string>
    <string name="tv_signin_key_refused_reason">Ключ доступа не принят: %1$s</string>
</resources>
