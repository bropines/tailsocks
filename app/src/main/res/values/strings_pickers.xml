<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings for the pickers that moved from dropdown menus to bottom sheets, and
  for the Permissions screen. A file of its own so it lands without touching
  strings.xml; Android merges every values/*.xml into one table.
-->
<resources>
    <!-- A number of days, for the audit-log period and the key-expiry picker. -->
    <plurals name="pickers_days">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>

    <!-- Audit logs: how far back to fetch. -->
    <string name="pickers_logs_period_title">Period</string>

    <!-- Admin devices: sort order. The sheet title already says "sort", so these do not. -->
    <string name="pickers_sort_name_az">Name, A to Z</string>
    <string name="pickers_sort_name_za">Name, Z to A</string>
    <string name="pickers_sort_last_seen">Recently seen first</string>
    <string name="pickers_sort_update">Updates available first</string>

    <!-- Tailnet settings: who may join other tailnets. The API values are none, admin, member. -->
    <string name="pickers_role_none">Nobody</string>
    <string name="pickers_role_admin">Admins</string>
    <string name="pickers_role_member">All members</string>

    <!-- Permissions: the folded note under a row whose state the system does not report. -->
    <string name="perm_unknown_note">Android does not tell apps whether this is allowed, so check it on the system screen.</string>
</resources>
