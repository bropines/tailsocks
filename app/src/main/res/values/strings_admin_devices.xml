    <!-- Tags -->
    <string name="admin_dev_tags_title">Tags of %1$s</string>
    <string name="admin_dev_tags_owner_warning">Tagging takes the device away from its user, %1$s: from then on its tags own it. That cannot simply be undone — giving it back to a person means removing the tags in the admin console on the web or logging the device in again.</string>
    <string name="admin_dev_tags_clear_warning">Without tags the device needs a user to own it again: the server decides who, and the device may have to log in again.</string>
    <string name="admin_dev_tags_save">Save tags</string>

    <!-- IPv4 -->
    <string name="admin_dev_ip_title">IPv4 address of %1$s</string>
    <string name="admin_dev_ip_label">New IPv4 address</string>
    <string name="admin_dev_ip_help">Inside 100.64.0.0/10 and not used by another device. Connections to it break, and peers reach it at the new address once they get the update.</string>
    <string name="admin_dev_ip_malformed">Not an IPv4 address, like 100.80.0.1.</string>
    <string name="admin_dev_ip_outside">Must be inside 100.64.0.0/10: from 100.64.0.0 to 100.127.255.255.</string>
    <string name="admin_dev_ip_reserved">Tailscale keeps this address for itself.</string>
    <string name="admin_dev_ip_taken">Already used by %1$s.</string>
    <string name="admin_dev_ip_unchanged">That is its address now.</string>
