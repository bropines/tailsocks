<?xml version="1.0" encoding="utf-8"?>
<!--
  The main account, in the accounts sheet's edit mode (ui/MainActivity.kt): the one that cannot be
  deleted and that the app moves to when the account in use is deleted. It used to be always the
  account the app was installed with.
-->
<resources>
    <!-- Edit mode, under the sheet's title: what the star means -->
    <string name="accounts_primary_help">★ marks the main account: it cannot be deleted, and the app moves to it when the account in use is deleted. Any account can be the main one — then the first can be deleted too.</string>
    <!-- Star button on an account that is not the main one -->
    <string name="accounts_make_primary">Make main</string>
    <!-- The filled star on the main account -->
    <string name="accounts_primary">Main account</string>
</resources>
