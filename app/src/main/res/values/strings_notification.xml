<?xml version="1.0" encoding="utf-8"?>
<!--
  The ongoing connection card in the notification shade. A file of its own so
  it lands without touching strings.xml; Android merges every values/*.xml into
  one table. Where the main screen already has the words (Starting…, Connection
  problem, Sign-in needed, the health titles) the card reuses those, so the two
  never disagree; only what the card says and the screen does not lives here.
-->
<resources>
    <!-- The channel, as the system settings list it. -->
    <string name="notif_channel_status">Connection status</string>
    <!-- The one action on the card. -->
    <string name="notif_action_stop">Stop</string>

    <!-- Live states, read from the daemon on the refresh tick. -->
    <string name="notif_connected">Connected</string>
    <string name="notif_connecting">Connecting…</string>
    <string name="notif_needs_login_text">Open TailSocks to sign in</string>
    <string name="notif_awaiting_approval">Waiting for approval</string>
    <string name="notif_awaiting_approval_text">Approve this device in the admin console</string>
    <string name="notif_os_refused_text">Sign out and in again, or turn “Report the real OS” back off</string>

    <!-- Under "Connected" when no exit node is in use: how the tailnet reaches apps. -->
    <string name="notif_mode_root">Root mode</string>
    <string name="notif_mode_tun">TUN mode</string>
    <!-- %1$s is the SOCKS5 listen address, e.g. 127.0.0.1:1055. -->
    <string name="notif_mode_proxy">SOCKS5 on %1$s</string>

    <!-- The service's own moves: starting, stopping, recovering. -->
    <string name="notif_stopping">Stopping…</string>
    <string name="notif_restarting">Restarting…</string>
    <string name="notif_reconnecting">Reconnecting…</string>
    <string name="notif_reconnecting_text">Restarting the daemon to bring the connection back</string>
    <string name="notif_waiting_network">Waiting for network…</string>
    <string name="notif_waiting_network_text">Reconnects when the device is online again</string>
    <string name="notif_connection_lost">Connection lost</string>
    <string name="notif_connection_lost_text">The daemon stopped unexpectedly</string>
    <string name="notif_root_failed">Root daemon failed to start</string>
</resources>
