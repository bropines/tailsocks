<resources>
    <!-- Remote management, the managed device's own page (ui/RemoteManagedScreen.kt): the two switches
         beyond the main one, what a paired device may do, and the newer lines of the log -->
    <string name="remote_managed_switch_help">A device paired with a code from this screen can see this TailSocks and change part of it over the tailnet. What exactly is listed under “What a paired device may do”.</string>

    <!-- Full control -->
    <string name="remote_full_title">Full control</string>
    <string name="remote_full_help">A paired device of this account can then see the name of every file in this device\'s storage and have any of them sent to itself, add shared folders, offer this device as an exit node or a router, and read the app\'s log with secrets scrubbed — a filter is a filter.\n• It is switched on here and nowhere else. A paired device can only switch it off.\n• Guests never get it.</string>
    <string name="remote_full_confirm_title">Turn on full control?</string>
    <string name="remote_full_confirm_text">Every paired device of this account will be able to see the name of every file in this device\'s storage and have any of them sent to itself, add shared folders, offer this device as an exit node or a router, and read the app\'s log.\n\nSecrets are scrubbed from the log, but a filter is a filter. Whoever holds a paired phone holds all of this.</string>
    <string name="remote_full_confirm_yes">Turn on</string>

    <!-- Guests -->
    <string name="remote_guests_title">Let other people\'s devices pair as guests</string>
    <string name="remote_guests_help_lasts">A guest sees the status and picks the exit node, and its pairing ends by itself after %1$s.</string>
    <string name="remote_guests_help_plain">A guest sees the status and picks the exit node.</string>
    <string name="remote_guests_help_off">• Off: only this account\'s own devices can pair, and a guest already paired is refused until this is on again.</string>
    <string name="remote_guests_help_off_tagged">• This device is tagged, so it has no owner: with this off nobody at all can pair, and a guest already paired is refused until it is on again.</string>
    <string name="remote_paired_help_owners">Only a device signed in to the same account as this one can pair now: guests are not let in. It pairs as an owner and stays until revoked.</string>
    <string name="remote_paired_nobody">Nobody can pair now: this device is tagged, so it has no owner, and guests are not let in.</string>
    <string name="remote_paired_guest_refused">refused while guests are off</string>

