<?xml version="1.0" encoding="utf-8"?>
<!--
  Taildrop where the system has no file picker and no notification shade — a television,
  mostly: the app's own browser in the picker's place, a receive folder by its path, and
  what the inbox says about a new file. A file of its own so it lands without touching
  strings.xml; Android merges every values/*.xml into one table.
-->
<resources>
    <!-- The app's browser asked for files to send: its title, and its button for the number checked. -->
    <string name="taildrop_pick_files_title">Choose files to send</string>
    <string name="taildrop_pick_send_to_format">Send to %1$s</string>
    <plurals name="taildrop_pick_send_files">
        <item quantity="one">Send %d file</item>
        <item quantity="other">Send %d files</item>
    </plurals>

    <!-- The app's browser asked for the folder received files go to. -->
    <string name="taildrop_pick_folder_title">Folder for received files</string>
    <string name="taildrop_pick_folder_confirm">Save received files here</string>

    <!-- The app's browser asked where to save one file of the inbox. %1$s is the file's name. -->
    <string name="taildrop_save_copy_title_format">Save %1$s to…</string>
    <string name="taildrop_save_copy_confirm">Save here</string>

    <!-- The receive folder's line at the top of the inbox, for a folder chosen by its path. %1$s is the folder. -->
    <string name="taildrop_folder_line_format">Received files are saved to %1$s</string>
    <string name="taildrop_folder_change">Change</string>
    <string name="taildrop_folder_needs_access_format">The app has no access to %1$s, so received files wait here. Allow access to storage and they are saved there by themselves.</string>
    <string name="taildrop_folder_unwritable_format">%1$s can\'t be written to: a drive may have been removed. Received files wait here until it is back or another folder is chosen.</string>
    <string name="taildrop_folder_allow">Allow access</string>

    <!-- Labels over the inbox's cards where the newest stand apart. -->
    <string name="taildrop_inbox_new">New</string>
    <string name="taildrop_inbox_earlier">Earlier</string>

    <!-- One line on the screen when a file arrives while the app is open on a television. %1$s is "a.jpg from laptop · Saved to Download/Taildrop". -->
    <string name="taildrop_tv_arrival_format">Received: %1$s</string>
    <string name="taildrop_tv_arrival_waits">it waits in the Taildrop inbox</string>

    <!-- Delete on a file of the inbox asks first where a remote does the pressing. %1$s is the file's name. -->
    <string name="taildrop_delete_confirm_title_format">Delete %1$s?</string>
    <string name="taildrop_delete_confirm_text">The received file is removed from the inbox for good.</string>

    <!-- Opening a received file. %1$s is the extension with its dot, ".pdf". -->
    <string name="taildrop_no_viewer_format">No app on this device opens %1$s files</string>
    <string name="taildrop_no_viewer">No app on this device opens this file</string>
    <string name="taildrop_saved_gone_format">The file is no longer in %1$s</string>
</resources>
