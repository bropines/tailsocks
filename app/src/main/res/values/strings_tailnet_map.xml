<?xml version="1.0" encoding="utf-8"?>
<!--
  The tailnet map (this device in the centre, its peers around it, each link drawn as the
  path in use and as thick as its traffic) and the speed graph on the main screen. Both read
  the same live traffic. The words for a path itself — direct, relay, peer relay — are the
  ones the Peers list uses (strings_peer_path.xml, strings_states.xml).
-->
<resources>
    <!-- The map's title, and the label of the main screen's button that opens it. -->
    <string name="tailnet_map_title">Tailnet map</string>
    <!-- Under the title: how many peers are online, of how many. -->
    <string name="tailnet_map_online_format">Online: %1$d of %2$d</string>
    <!-- The button for the peers a window had no room to draw. -->
    <string name="tailnet_map_more_format">+%1$d more</string>
    <string name="tailnet_map_more_title">Not on the map</string>
    <string name="tailnet_map_more_desc">The map draws the devices in use first. These did not fit on the screen.</string>
    <string name="tailnet_map_empty">No other devices in this tailnet yet</string>
    <!-- A rate pair wherever there is no room for words: down, then up. -->
    <string name="tailnet_map_rate_format" translatable="false">↓ %1$s   ↑ %2$s</string>
    <!-- The same for a screen reader, after a device's name and path. -->
    <string name="tailnet_map_rate_spoken_format">receiving %1$s, sending %2$s</string>
    <!-- A device's sheet: the two directions, each with its rate now and its total. -->
    <string name="tailnet_map_received">Received</string>
    <string name="tailnet_map_sent">Sent</string>
    <string name="tailnet_map_total_format">%1$s in total</string>
    <!-- This device's sheet: its figures are the sum over every peer. -->
    <string name="tailnet_map_self_caption">Traffic with all devices of the tailnet</string>
    <string name="tailnet_map_open_peer">Device details</string>

    <!-- The map's layout schemes: a switch under the header. -->
    <string name="tailnet_map_scheme_label">Map layout</string>
    <string name="tailnet_map_scheme_rings">Rings</string>
    <string name="tailnet_map_scheme_routes">Routes</string>
    <string name="tailnet_map_scheme_tree">Tree</string>
    <!-- The tree's chip that says what its branches are; %1$s is one of the four below. -->
    <string name="tailnet_map_grouping_format">Groups: %1$s</string>
    <string name="tailnet_map_grouping_route">by route</string>
    <string name="tailnet_map_grouping_owner">by owner</string>
    <string name="tailnet_map_grouping_os">by system</string>
    <string name="tailnet_map_grouping_state">by state</string>
    <!-- A group's name where the data has none: devices nothing was sent to yet, devices with a path in use. -->
    <string name="tailnet_map_group_idle">No traffic yet</string>
    <string name="tailnet_map_group_linked">In use</string>
    <string name="tailnet_map_os_other">Other</string>
    <string name="tailnet_map_owner_unknown">Another user</string>
    <!-- What a hub is, in its sheet and for a screen reader. -->
    <string name="tailnet_map_kind_derp">DERP relay</string>
    <string name="tailnet_map_kind_peer_relay">Peer relay</string>
    <string name="tailnet_map_kind_group">Group</string>
    <plurals name="tailnet_map_devices">
        <item quantity="one">%d device</item>
        <item quantity="other">%d devices</item>
    </plurals>
    <!-- A hub's sheet: the list under the figures. -->
    <string name="tailnet_map_hub_through">Reached through this relay</string>
    <string name="tailnet_map_hub_members">In this group</string>
    <!-- The two states of the button over the map's corner. -->
    <string name="tailnet_map_fit">Show the whole map</string>
    <string name="tailnet_map_actual_size">Back to normal size</string>

    <!-- Filters: the top bar's button, the sheet, the chips of what is on. -->
    <string name="tailnet_map_filters">Filters</string>
    <string name="tailnet_map_filters_on_format">Filters, %1$d on</string>
    <string name="tailnet_map_filter_reset">Reset</string>
    <string name="tailnet_map_filter_reset_all">Reset filters</string>
    <string name="tailnet_map_filter_search">Name, address or system</string>
    <string name="tailnet_map_filter_query_format" translatable="false">“%1$s”</string>
    <string name="tailnet_map_filter_section_state">State</string>
    <string name="tailnet_map_filter_section_path">Path</string>
    <string name="tailnet_map_filter_section_os">System</string>
    <string name="tailnet_map_filter_section_owner">Owner</string>
    <string name="tailnet_map_filter_section_role">Role</string>
    <string name="tailnet_map_filter_online">Online only</string>
    <string name="tailnet_map_filter_traffic">With traffic now</string>
    <string name="tailnet_map_filter_not_yet">No path yet</string>
    <string name="tailnet_map_filter_subnet_routers">Subnet routers</string>
    <string name="tailnet_map_filter_shown_format">Shown: %1$d of %2$d</string>
    <string name="tailnet_map_filter_done">Show</string>
    <string name="tailnet_map_filter_empty">No device matches the filters</string>
    <string name="tailnet_map_filter_empty_desc">They hide all %1$d devices of this tailnet.</string>

    <!-- The speed graph card on the main screen. -->
    <string name="speed_graph_title">Traffic</string>
    <string name="speed_graph_idle">No traffic right now</string>
    <string name="speed_graph_stopped">Shown while connected</string>
    <!-- What a screen reader says for the whole card. -->
    <string name="speed_graph_spoken_format">Tailnet traffic: receiving %1$s, sending %2$s</string>

    <!-- Settings: the two switches. -->
    <string name="settings_speed_graph_title">Speed graph on the main screen</string>
    <string name="settings_speed_graph_desc">Under the status card: the download and upload rate over the last minute, and the three devices using the most right now. Read from the daemon only while the screen is open.</string>
    <string name="settings_tailnet_map_title">Tailnet map button</string>
    <string name="settings_tailnet_map_desc">A button on the main screen that opens the map: this device, its peers, and how each one is reached — directly, through a relay or through a peer relay.</string>
</resources>
