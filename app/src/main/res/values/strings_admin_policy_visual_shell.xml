    <!-- The Network page. -->
    <string name="admin_pv_net_options">Connection options</string>
    <string name="admin_pv_net_random_port">Random client port</string>
    <string name="admin_pv_net_random_port_help">Devices use a random UDP port instead of 41641, which some firewalls need. The device attribute randomize-client-port does the same for chosen devices only.</string>
    <string name="admin_pv_net_no_ipv4">No IPv4 addresses</string>
    <string name="admin_pv_net_no_ipv4_help">Devices get only IPv6 tailnet addresses, no 100.x one. The device attribute disable-ipv4 does this for chosen devices and is the documented way now.</string>
    <string name="admin_pv_net_cgnat">Route to the tailnet on Macs</string>
    <string name="admin_pv_net_cgnat_help">How Macs route 100.64.0.0/10. Automatic: one route for the whole range, unless another network on the Mac uses it.</string>
    <string name="admin_pv_net_cgnat_auto">Automatic</string>
    <string name="admin_pv_net_cgnat_always">One route for the whole range</string>
    <string name="admin_pv_net_cgnat_never">A route per device</string>
    <string name="admin_pv_net_cgnat_other">As written: %1$s</string>
    <string name="admin_pv_net_odd_value">Written as a value this page does not know.</string>
    <string name="admin_pv_net_derp">Relay servers (DERP)</string>
    <string name="admin_pv_net_derp_defaults_on">Tailscale\'s relays are used</string>
    <string name="admin_pv_net_derp_defaults_off">Tailscale\'s relays are not used</string>
    <string name="admin_pv_net_derp_off">Turned off: %1$s</string>
    <string name="admin_pv_net_derp_region">region %1$s</string>
    <string name="admin_pv_net_derp_custom">Own relays</string>
