<?xml version="1.0" encoding="utf-8"?>
<!-- Taildrive downloads as a queue: the panel under the share list (ui/TaildriveDownloadUi.kt), its
     notification (core/TaildriveDownloads.kt), and the "Parallel downloads" setting
     (ui/TaildriveDownloadSetting.kt). -->
<resources>
    <!-- The panel's first line while several downloads run or wait; the second part only when some wait. -->
    <string name="taildrive_queue_downloading">Downloading</string>
    <plurals name="taildrive_queue_in_queue">
        <item quantity="one">%d in queue</item>
        <item quantity="other">%d in queue</item>
    </plurals>
    <!-- Under it: how many files are being written right now. -->
    <!-- Next to the sizes: files that are over, of all found. The quantity is the second number. -->
    <plurals name="taildrive_queue_files_done">
        <item quantity="one">%1$d of %2$d file</item>
        <item quantity="other">%1$d of %2$d files</item>
    </plurals>
    <!-- The same while folders are still being walked and more may be found. -->
    <plurals name="taildrive_queue_files_done_counting">
        <item quantity="one">%1$d of %2$d file so far</item>
        <item quantity="other">%1$d of %2$d files so far</item>
    </plurals>
    <!-- A download in the list, by what was selected: "Season 2 and 3 more". -->
    <string name="taildrive_queue_and_more">%1$s and %2$d more</string>
    <!-- A download that waits its turn, and where it will go. -->
    <!-- The list unfolded with nothing running. -->
    <plurals name="taildrive_queue_finished">
        <item quantity="one">%d download finished</item>
        <item quantity="other">%d downloads finished</item>
    </plurals>
    <string name="taildrive_queue_clear">Clear finished</string>
    <!-- Content descriptions of the button that unfolds and folds the list. -->
    <string name="taildrive_queue_show">Show all downloads</string>
    <string name="taildrive_queue_hide">Hide the list</string>

    <!-- The notification: its title while several files are written, and its button while more than one download runs or waits. -->
    <plurals name="taildrive_queue_notify_files">
        <item quantity="one">Downloading %d file</item>
        <item quantity="other">Downloading %d files</item>
    </plurals>
    <plurals name="taildrive_queue_downloads">
        <item quantity="one">%d download</item>
        <item quantity="other">%d downloads</item>
    </plurals>
    <string name="taildrive_queue_cancel_all">Cancel all</string>

    <!-- Settings → Sharing & access → Storage. -->
    <string name="taildrive_parallel_title">Parallel downloads</string>
    <!-- %1$d: how many files from shares download at the same time. -->
    <plurals name="taildrive_parallel_desc">
        <item quantity="one">%1$d file at a time. More is faster on a good connection; fewer is gentler on a slow one.</item>
        <item quantity="other">Up to %1$d files at once. More is faster on a good connection; fewer is gentler on a slow one.</item>
    </plurals>
    <!-- The choices: how many files at once, with a word on each. -->
    <string name="taildrive_parallel_one">One after another</string>
    <string name="taildrive_parallel_two">Lighter on a slow connection</string>
    <string name="taildrive_parallel_three">The default</string>
    <string name="taildrive_parallel_four">Fastest on a good connection</string>
    <!-- What the settings search knows the row by (ui/SettingsCatalog.kt). -->
    <string name="search_sum_taildrive_parallel">How many files download from Taildrive shares at the same time</string>
    <string name="search_kw_taildrive_parallel">parallel, simultaneous, at once, concurrent, download queue, downloads, speed, threads, taildrive</string>
    <string name="taildrive_queue_cancel_item">Cancel this download</string>
    <string name="taildrive_queue_dismiss_item">Remove from the list</string>
</resources>
