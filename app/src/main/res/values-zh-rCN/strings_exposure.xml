    <!-- The rows: a title and a folded explanation each. -->
    <string name="exposure_funnel">Funnel</string>
    <string name="exposure_funnel_help">通过此设备的公网名称提供的端口，互联网上的任何人都可访问。连接无需 tailnet 账号。</string>
    <string name="exposure_tailcat_server">TailCat 服务器</string>
    <string name="exposure_tailcat_server_help">此设备作为 TailCat 服务器：持有其地址的客户端可从任何地方经 Tailscale 中继访问它开放的各端口，以及它提供的出口节点（如有）。若不设客户端密钥列表，任何知道地址的人都可以访问。</string>
    <string name="exposure_remote">远程管理</string>
    <string name="exposure_remote_help">已配对的 TailSocks 设备可通过 tailnet 管理此设备。tailnet 的其他设备都会被拒绝，且只有在显示配对码时才能尝试输入。</string>
    <string name="exposure_remote_full">完全控制</string>
    <string name="exposure_remote_full_help">已配对的所有者可以执行基础之外的操作：共享文件夹、提供出口节点、通告路由、读取诊断信息。</string>
    <string name="exposure_remote_files">文件网络访问</string>
    <string name="exposure_remote_files_help">已配对设备可以列出此设备的文件夹，并通过 tailnet 发送或获取文件。</string>
    <string name="exposure_remote_elevated">临时完全权限</string>
    <string name="exposure_remote_elevated_help">某访客已获得所有者权限，直到所示时间。权限到期自动结束；关闭此开关则立即结束。</string>
    <string name="exposure_taildrive_shares">Taildrive 文件夹</string>
    <string name="exposure_taildrive_shares_help">tailnet 设备可打开的本机文件夹——前提是 tailnet 策略授予其 Taildrive 权限。</string>
    <string name="exposure_taildrop">Taildrop 接收</string>
    <string name="exposure_taildrop_help">TailSocks 运行时，你自己的设备——以及 tailnet 策略允许发送文件的任何设备——都能向这里发送文件。它没有开关：只有阻止入站连接才能停止。</string>
    <string name="exposure_serve">Serve</string>
    <string name="exposure_serve_help">此设备向 tailnet 提供的端口：网页、转发到本机服务的代理、TCP 转发。</string>
    <string name="exposure_exit_node">已提供出口节点</string>
    <string name="exposure_exit_node_help">tailnet 管理员批准后，tailnet 设备可将全部互联网流量经此设备转发。</string>
    <string name="exposure_routes_title">子网路由</string>
    <string name="exposure_routes_help">tailnet 管理员批准路由后，tailnet 设备可通过此设备访问这些网络。</string>
    <string name="exposure_ssh_help">按 tailnet 策略的 ssh 规则放行的连接，可在此设备上打开 shell（root 或 shell 用户）。scp 和 SFTP 同样可用。</string>
    <string name="exposure_app_connector">应用连接器</string>
    <string name="exposure_app_connector_help">tailnet 经应用连接器路由的流量将从此设备的互联网连接发出。</string>
    <string name="exposure_relay">对等中继</string>
    <string name="exposure_relay_help">无法直连的 tailnet 设备在策略允许时，可经此设备的 UDP 端口中转流量。该端口在此设备的真实网络上开放。</string>
    <string name="exposure_lan_access">对本地网络开放的代理</string>
    <string name="exposure_lan_access_help">SOCKS5 代理、HTTP 代理和 DNS 代理监听所有地址：同一 Wi-Fi 上的任何人都可以使用。使用 Root 模式的接口时，tailnet 也可以。</string>
    <string name="exposure_socks5">SOCKS5 代理</string>
    <string name="exposure_socks5_help">应用通过它把流量送入 tailnet，再经出口节点发出。能访问它的人都在使用此设备的连接；用户名和密码可阻止他人。</string>
    <string name="exposure_http">HTTP 代理</string>
    <string name="exposure_http_help">为使用 HTTP 的应用提供同样功能。它没有密码：能访问它的人都可以使用。</string>
    <string name="exposure_dns">DNS 代理</string>
    <string name="exposure_dns_help">应答域名解析，包括 MagicDNS 名称：能访问它的人都可以解析 tailnet 的名称。</string>
    <string name="exposure_web_ui">Web 界面</string>
    <string name="exposure_web_ui_help">Tailscale 为此设备提供的网页：打开即可查看设备状态并为其登录。</string>
    <string name="exposure_drive_proxy">Taildrive 代理</string>
    <string name="exposure_drive_proxy_help">通往 tailnet 与此设备共享的每个文件夹的 WebDAV 入口：能访问它的人可以以此设备的身份打开这些文件夹。对本地网络开放时会始终要求登录。</string>
    <string name="exposure_tailcat_forwards">TailCat 转发</string>
    <string name="exposure_tailcat_forwards_help">本机通向 TailCat 服务器的端口，以及 TailCat 的 SOCKS5 代理。它们监听 127.0.0.1。</string>
    <string name="exposure_byedpi">DPI 绕过代理</string>
    <string name="exposure_byedpi_help">ByeDPI 用于控制连接的代理，位于本设备之外无法访问的随机回环地址。</string>
    <string name="exposure_device_ports">此设备的端口</string>
    <string name="exposure_other_apps">其他应用的服务</string>
    <string name="exposure_other_apps_all">除 TailSocks 自身外的所有端口</string>
    <string name="exposure_other_apps_help">本机其他应用的服务器——网络 adb、SSH 服务器、Syncthing——会对访问规则允许的 tailnet 设备应答，与代理模式下的任何 Tailscale 节点相同。TailSocks 自身的代理不会，除非你将其开放。设置 → 本地代理 中的严格模式还会关闭其余部分。</string>
    <string name="exposure_other_apps_help_strict">严格模式已开启：本机其他应用的服务器中，tailnet 设备只能访问 设置 → 本地代理 中列出的端口。</string>
    <string name="exposure_device_ports_help_vpn">tailnet 地址位于 Android 的 VPN 上：访问规则允许的 tailnet 设备可以访问其他应用中监听所有地址的每个端口。TailSocks 本身在该 VPN 之外，因此它自己的代理都不应答 tailnet。阻止入站连接可关闭全部。</string>
    <string name="exposure_device_ports_help_interface">tailnet 地址位于真实网卡上：访问规则允许的 tailnet 设备可以访问监听所有地址的每个端口——包括其他应用的端口。阻止入站连接可关闭全部。</string>
    <string name="exposure_root_tun">内核接口（Root）</string>
    <string name="exposure_root_tun_help">tailscale0 在 Android VPN 之下承载 tailnet：tailnet 可到达此设备自身的网络栈，包括所有监听全部地址的应用。</string>
    <string name="exposure_root_boot">开机脚本（Root）</string>
    <string name="exposure_root_boot_help">开机时先于应用启动 Tailscale：无需打开 TailSocks，此列表显示的内容就会开放。</string>
    <string name="exposure_root_cli">CLI 封装（Root）</string>
    <string name="exposure_root_cli_help">具备 root 的 shell 和应用可以运行 %1$s 并控制此设备的 Tailscale。它会安装到 /data/adb/service.d，并以模块形式覆盖 /system/bin。</string>
    <string name="exposure_automation">自动化广播</string>
    <string name="exposure_automation_help">知道令牌的本机应用——Tasker、MacroDroid——可以连接和断开，并切换出口节点和账号。</string>
    <string name="exposure_app_functions">AppFunctions</string>
    <string name="exposure_app_functions_help">Android 允许的助手应用可以读取连接、设备和账号信息；若允许外部自动化，它们还可以连接并更改设置。</string>

    <!-- Appended to a listener's explanation: why it is reached from where it is. -->
    <string name="exposure_why_device">只有本机应用可以访问它。</string>
    <string name="exposure_why_opened">它对 tailnet 开放（设置 → 本地代理）：tailnet 设备可通过本机的 tailnet 地址访问它。</string>
    <string name="exposure_why_wildcard">它监听所有地址：本地网络和 tailnet 都可以访问它。</string>
    <string name="exposure_why_wildcard_opened">它监听所有地址（本地网络可访问），且对 tailnet 开放（设置 → 本地代理）。</string>
    <string name="exposure_why_wildcard_closed">它监听所有地址：本地网络可以访问。此模式下 tailnet 不能。</string>
    <string name="exposure_why_lan">它监听本地网络的一个地址，因此本地网络可以访问它。</string>
    <string name="exposure_why_tailnet">它监听此设备的 tailnet 地址。</string>
</resources>
