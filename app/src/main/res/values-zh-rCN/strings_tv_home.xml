<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Signing in without a browser on the device: the link as a QR code (ui/SignIn.kt) -->
    <!-- The logged-out card, on a phone: the link for another device to open -->
    <string name="signin_other_device">在另一台设备上登录</string>
    <string name="signin_other_device_help">在任何手机或电脑上打开此链接并登录：本设备会自行继续。由登录者决定该设备加入哪个 tailnet，因此请只把链接发送给 tailnet 的所有者。</string>
    <!-- %1$s: the device's name, %2$s: the link -->
    <string name="signin_share_message">“%1$s”（TailSocks）的登录链接：%2$s\n打开并登录，即可让该设备加入你的 tailnet。</string>

    <!-- The same on a television: a screen of its own -->
    <string name="tv_signin_title">用手机登录</string>
    <string name="tv_signin_step">用手机摄像头扫描二维码并登录。此屏幕会自行继续。</string>
    <string name="tv_signin_or_link">或在任意设备上打开：</string>
    <string name="tv_signin_preparing">正在获取二维码…</string>
    <string name="tv_signin_waiting">正在等待你登录…</string>
    <string name="tv_signin_slow">登录服务器无响应。在网络受限、无法连通的情况下，请先配置代理或绕过功能。</string>
    <string name="tv_signin_new_code">更换二维码</string>
    <string name="tv_signin_new_code_hint">更换二维码：供手机无法接受当前二维码时使用。</string>
    <string name="tv_signin_new_code_failed">无法更换二维码：%1$s</string>
    <string name="tv_signin_not_ready">服务尚未进入等待登录状态，请稍后重试</string>
    <string name="tv_signin_later">暂不</string>
    <string name="tv_signin_open">登录</string>

    <!-- Home on a television: the remote's OK instead of a tap (the status card, the exit node row) -->
    <string name="tv_home_start">按 OK 键启动</string>
    <string name="tv_home_active">服务正在运行 • 按 OK 键停止</string>
    <string name="tv_home_active_root">由系统经 tailscale0 路由 • 按 OK 键停止</string>
    <string name="tv_home_active_root_yielded">仅 Tailnet——另一个 VPN 持有本机 • 按 OK 键停止</string>
    <string name="tv_home_active_root_shared">正在接载另一个 VPN 排除的应用 • 按 OK 键停止</string>
    <string name="tv_home_degraded">%1$s • 按 OK 键停止</string>
    <string name="tv_home_needs_login">在下方登录 • 按 OK 键停止</string>
    <string name="tv_home_exit_node_none">按 OK 键选择出口节点</string>

    <!-- Stopping asks first: OK on a remote is pressed by accident -->
    <string name="tv_stop_title">停止 TailSocks？</string>
    <string name="tv_stop_text">与 tailnet 的连接会断开，直到你再次启动。</string>

    <!-- Onboarding on a television: the login step -->
    <string name="tv_onboarding_login_desc">登录需要一部手机：服务启动后，此屏幕会显示供手机摄像头扫描的二维码。另一种方式是使用认证密钥，可以稍后再用。</string>

    <!-- Sign-in after a key the server did not accept; %1$s is the daemon's own reason. -->
    <string name="tv_signin_key_refused">认证密钥未被接受。</string>
    <string name="tv_signin_key_refused_reason">认证密钥未被接受：%1$s</string>
</resources>
