<?xml version="1.0" encoding="utf-8"?>
<!--
  The devices this one manages, on the main screen (ui/ManagedOnMain.kt). A device is its own
  name there, and whether it is online is said in the words of the list in Settings
  (strings_remote_manage.xml); these are for the entry that leads to all of them.
-->
<resources>
    <!-- Dashboard tile: opens the list of every device this one manages -->
    <string name="managed_all">受管设备</string>
    <!-- Its second line while nothing is known of who is online: how many there are -->
    <plurals name="managed_count">
        <item quantity="other">%d 台设备</item>
    </plurals>
    <!-- Phone pill: the same entry, with how many there are -->
    <string name="managed_all_count">所有设备 · %d</string>
    <!-- Settings → Appearance: the switch for all of it -->
    <string name="settings_managed_on_main_title">主屏幕上的受管设备</string>
    <string name="settings_managed_on_main_desc">显示最近管理过的设备，以及通往其余设备的按钮。当本设备开始管理其他设备后显示。</string>
</resources>
