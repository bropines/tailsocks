    <!-- Settings search: what a person types to find the switch above (a list, see strings_settings_search_keywords.xml) -->
    <string name="search_kw_update_beta">预发布, 抢先版, 内测, 测试版, 尝鲜, 测试构建, 更新通道, 不稳定版, 每日构建, beta</string>
