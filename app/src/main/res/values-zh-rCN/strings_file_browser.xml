<?xml version="1.0" encoding="utf-8"?>
<!--
  The in-app file browser (ui/FileBrowser.kt), which picks files and folders where the system
  has no picker. A file of its own so it lands without touching strings.xml; Android merges
  every values/*.xml into one table. The caller may pass its own title and confirm label.
-->
<resources>
    <!-- Default titles. -->
    <string name="file_browser_title_files">选择文件</string>
    <string name="file_browser_title_file">选择文件</string>
    <string name="file_browser_title_folder">选择文件夹</string>
    <plurals name="file_browser_selected_format">
        <item quantity="other">已选择 %d 个文件</item>
    </plurals>

    <!-- Places to start from. -->
    <string name="file_browser_places">存储</string>
    <string name="file_browser_internal">内部存储</string>
    <string name="file_browser_downloads">下载</string>
    <string name="file_browser_removable">可移动存储</string>

    <!-- Rows and buttons. -->
    <string name="file_browser_up">上一级</string>
    <string name="file_browser_choose_folder">选择此文件夹</string>
    <plurals name="file_browser_choose_files">
        <item quantity="other">选择 %d 个文件</item>
    </plurals>
    <string name="file_browser_hidden_show">显示隐藏文件</string>
    <string name="file_browser_hidden_hide">不显示隐藏文件</string>
    <string name="file_browser_read_only">应用无法写入此文件夹</string>
    <string name="file_browser_file_format">%1$s · %2$s</string>

    <!-- The side panel. -->
    <string name="file_browser_current_folder">当前文件夹</string>
    <string name="file_browser_hint_files">选择文件可查看，选择文件夹可打开。</string>
    <string name="file_browser_hint_file">选择文件即选中，选择文件夹可打开。</string>
    <string name="file_browser_hint_folder">打开目标文件夹，然后选择它。</string>
    <string name="file_browser_hint_places">选择要浏览的位置。</string>

    <!-- A folder with nothing to show. -->
    <string name="file_browser_empty_title">此文件夹为空</string>
    <string name="file_browser_empty_body">这里没有可显示的内容。</string>
    <string name="file_browser_empty_hidden">隐藏文件未显示。</string>
    <string name="file_browser_go_up">返回上一级</string>

    <!-- A folder that can\'t be opened. -->
    <string name="file_browser_unreadable_title">无法打开此文件夹</string>
    <string name="file_browser_unreadable_gone">它已不存在，可能移除了某个存储设备。</string>
    <string name="file_browser_unreadable_denied">Android 不允许此应用读取。</string>

    <!-- No access to files yet. -->
    <string name="file_browser_no_access_title">尚无权访问你的文件</string>
    <string name="file_browser_no_access_all_files">没有“所有文件”访问权限时，应用只能看到自己的文件夹。</string>
    <string name="file_browser_no_access_storage">没有存储权限时，应用无法看到你的文件。</string>
    <string name="file_browser_grant_all_files">允许访问所有文件</string>
    <string name="file_browser_grant_storage">允许访问存储</string>
    <string name="file_browser_limited">部分文件和文件夹可能被隐藏</string>
    <!-- %1$s is a command for a computer, a single line. -->
    <string name="file_browser_grant_unavailable_format">此设备没有对应的设置页面。请在电脑上运行：%1$s</string>
    <!-- The storage of another device, which has not been given the access to all files; %1$s is its name. -->
    <string name="file_browser_remote_no_access_title">%1$s 尚无法读取其存储</string>
    <string name="file_browser_remote_no_access_body">在它允许“所有文件”访问权限之前，那台设备上的应用只能看到自己的文件夹。</string>
</resources>
