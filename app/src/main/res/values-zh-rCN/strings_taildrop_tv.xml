<?xml version="1.0" encoding="utf-8"?>
<!--
  Taildrop where the system has no file picker and no notification shade — a television,
  mostly: the app's own browser in the picker's place, a receive folder by its path, and
  what the inbox says about a new file. A file of its own so it lands without touching
  strings.xml; Android merges every values/*.xml into one table.
-->
<resources>
    <!-- The app's browser asked for files to send: its title, and its button for the number checked. -->
    <string name="taildrop_pick_files_title">选择要发送的文件</string>
    <string name="taildrop_pick_send_to_format">发送到 %1$s</string>
    <plurals name="taildrop_pick_send_files">
        <item quantity="other">发送 %d 个文件</item>
    </plurals>

    <!-- The app's browser asked for the folder received files go to. -->
    <string name="taildrop_pick_folder_title">接收文件的文件夹</string>
    <string name="taildrop_pick_folder_confirm">将接收的文件保存到这里</string>

    <!-- The app's browser asked where to save one file of the inbox. %1$s is the file's name. -->
    <string name="taildrop_save_copy_title_format">将 %1$s 保存到…</string>
    <string name="taildrop_save_copy_confirm">保存到这里</string>

    <!-- The receive folder's line at the top of the inbox, for a folder chosen by its path. %1$s is the folder. -->
    <string name="taildrop_folder_line_format">接收的文件将保存到 %1$s</string>
    <string name="taildrop_folder_change">更改</string>
    <string name="taildrop_folder_needs_access_format">应用无权访问 %1$s，因此接收的文件暂存在此处。授予存储访问权限后，它们会自动保存到那里。</string>
    <string name="taildrop_folder_unwritable_format">%1$s 无法写入：可能有驱动器被移除。接收的文件会暂存在此处，直到它恢复或选择其他文件夹。</string>
    <string name="taildrop_folder_allow">允许访问</string>

    <!-- Labels over the inbox's cards where the newest stand apart. -->
    <string name="taildrop_inbox_new">最新</string>
    <string name="taildrop_inbox_earlier">更早</string>

    <!-- One line on the screen when a file arrives while the app is open on a television. %1$s is "a.jpg from laptop · Saved to Download/Taildrop". -->
    <string name="taildrop_tv_arrival_format">已接收：%1$s</string>
    <string name="taildrop_tv_arrival_waits">它暂存在 Taildrop 收件箱中</string>

    <!-- Delete on a file of the inbox asks first where a remote does the pressing. %1$s is the file's name. -->
    <string name="taildrop_delete_confirm_title_format">删除 %1$s？</string>
    <string name="taildrop_delete_confirm_text">该接收文件将从收件箱中永久删除。</string>

    <!-- Opening a received file. %1$s is the extension with its dot, ".pdf". -->
    <string name="taildrop_no_viewer_format">本设备上没有应用可以打开 %1$s 文件</string>
    <string name="taildrop_no_viewer">本设备上没有应用可以打开此文件</string>
    <string name="taildrop_saved_gone_format">文件已不在 %1$s 中</string>
</resources>
