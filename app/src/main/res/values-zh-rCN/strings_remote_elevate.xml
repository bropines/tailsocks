<resources>
    <!-- Remote management: full rights for a guest for a while (core/RemoteElevate.kt, ui/RemoteElevate*.kt). -->

    <!-- The managed device's page: the switch, and a guest's row -->
    <string name="remote_elevate_switch_title">允许访客临时获得完整权限</string>
    <string name="remote_elevate_switch_help">开启后，便可临时授予访客所有者的设备在此能做的全部操作，时长从 15 分钟到一天不等——且必须由本设备前的人用屏幕锁确认。访客可以提出请求；远程无法直接授予。\n• 关闭此项会立即结束已授予的权限。\n• 停止 TailSocks、退出登录、账号、密码、Root 模式以及开启完全控制，本来就只能在本设备操作。</string>
    <string name="remote_elevate_give">临时授予完整权限…</string>
    <string name="remote_elevate_give_named">临时授予 %1$s 完整权限</string>
    <string name="remote_elevate_take_back">收回权限</string>
    <string name="remote_elevate_take_back_named">收回 %1$s 的完整权限</string>
    <string name="remote_elevate_row">完整权限 · 至 %1$s</string>
    <string name="remote_elevate_row_full">完整权限及完全控制 · 至 %1$s</string>
    <string name="remote_access_guest_elevate">经本设备前的人确认后，临时拥有所有者的权限</string>
    <string name="remote_can_elevate_request">请求临时获得完整权限</string>

    <!-- The question that gives them -->
    <string name="remote_elevate_title_give">授予 %1$s 完整权限？</string>
    <string name="remote_elevate_title_asked">%1$s 请求完整权限</string>
    <string name="remote_elevate_help">这一次它可以在本设备上做所有者的设备能做的事。但它仍不能停止 TailSocks、退出登录、更改账号或查看密码。你可以随时收回权限。</string>
    <string name="remote_elevate_for_how_long">授权时长</string>
    <string name="remote_elevate_len_15m">15 分钟</string>
    <string name="remote_elevate_len_1h">1 小时</string>
