<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-Android-12 auto-backup content. Cloud backup is off app-wide, but if it
    is ever enabled these keep credentials and node keys out of it.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="admin_api_keys.xml" />
    <!-- Admin console: profiles, Keystore-sealed secrets (useless off this device), its audit log. -->
    <exclude domain="sharedpref" path="admin_profiles.xml" />
    <exclude domain="sharedpref" path="admin_vault.xml" />
    <exclude domain="file" path="admin" />
    <exclude domain="sharedpref" path="tailsocks_global.xml" />
    <exclude domain="file" path="states" />
    <!-- Received Taildrop files moved out of states/ in 4.0; they stay out of
         backups, as they did when they were part of it. -->
    <exclude domain="file" path="taildrop" />
</full-backup-content>
