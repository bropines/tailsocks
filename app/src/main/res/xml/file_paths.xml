<?xml version="1.0" encoding="utf-8"?>
<!--
    Roots for ${applicationId}.fileprovider. Only three things are ever handed to
    another app through it, so only three directories are declared:

      taildrop/ - files received over Taildrop, opened in a viewer app
                  (ui/UIComponents.kt openTaildropFile). They live in
                  files/taildrop/<account>, see core/TaildropPaths.kt.
      Download/ - the APK the in-app updater downloads into
                  getExternalFilesDir(DIRECTORY_DOWNLOADS) and hands to the
                  package installer (ui/MainActivity.kt launchApkInstaller).
      exports/  - the Taildrop history as CSV, shared from the Files screen
                  (core/TaildropHistory.kt exportCsv). cache/exports holds
                  nothing but the latest export.

    These used to be three roots with path="." covering the whole files/, cache/
    and external-files directories, which meant a content:// URI could be minted
    for states/<account>/tailscaled.state (the node private keys), the LocalAPI
    socket and cache/tun.conf (the SOCKS credentials). Do not widen a root: add
    a narrow one for the new consumer instead.
-->
<paths>
    <files-path name="taildrop" path="taildrop/" />
    <external-files-path name="updates" path="Download/" />
    <cache-path name="exports" path="exports/" />
</paths>
