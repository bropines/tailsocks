<?xml version="1.0" encoding="utf-8"?>
<!--
  The in-app file browser (ui/FileBrowser.kt), which picks files and folders where the system
  has no picker. A file of its own so it lands without touching strings.xml; Android merges
  every values/*.xml into one table. The caller may pass its own title and confirm label.
--><resources>
    <!-- Default titles. -->
    <string name="file_browser_title_files"></string>
    <string name="file_browser_title_file"></string>
    <string name="file_browser_title_folder"></string>
    <plurals name="file_browser_selected_format">
    </plurals>
    <!-- Places to start from. -->
    <string name="file_browser_places"></string>
    <string name="file_browser_internal"></string>
    <string name="file_browser_downloads"></string>
    <string name="file_browser_removable"></string>
    <!-- Rows and buttons. -->
    <string name="file_browser_up"></string>
    <string name="file_browser_choose_folder"></string>
    <plurals name="file_browser_choose_files">
    </plurals>
    <string name="file_browser_hidden_show"></string>
    <string name="file_browser_hidden_hide"></string>
    <string name="file_browser_read_only"></string>
    <string name="file_browser_file_format"></string>
    <!-- The side panel. -->
    <string name="file_browser_current_folder"></string>
    <string name="file_browser_hint_files"></string>
    <string name="file_browser_hint_file"></string>
    <string name="file_browser_hint_folder"></string>
    <string name="file_browser_hint_places"></string>
    <!-- A folder with nothing to show. -->
    <string name="file_browser_empty_title"></string>
    <string name="file_browser_empty_body"></string>
    <string name="file_browser_empty_hidden"></string>
    <string name="file_browser_go_up"></string>
    <!-- A folder that can\'t be opened. -->
    <string name="file_browser_unreadable_title"></string>
    <string name="file_browser_unreadable_gone"></string>
    <string name="file_browser_unreadable_denied"></string>
    <!-- No access to files yet. -->
    <string name="file_browser_no_access_title"></string>
    <string name="file_browser_no_access_all_files"></string>
    <string name="file_browser_no_access_storage"></string>
    <string name="file_browser_grant_all_files"></string>
    <string name="file_browser_grant_storage"></string>
    <string name="file_browser_limited"></string>
    <!-- %1$s is a command for a computer, a single line. -->
    <string name="file_browser_grant_unavailable_format"></string>
    <!-- The storage of another device, which has not been given the access to all files; %1$s is its name. -->
    <string name="file_browser_remote_no_access_title"></string>
    <string name="file_browser_remote_no_access_body"></string>
</resources>
