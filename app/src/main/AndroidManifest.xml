<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional, asked for from the watchdog switch: an exact alarm's broadcast may
         start a foreground service from the background, an inexact one may not. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <!-- Browsers that offer Custom Tabs, for the login page (ui/LoginTab.kt). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".core.TailSocksApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher" 
        android:roundIcon="@mipmap/ic_launcher_round" 
        android:theme="@style/Theme.Tailscaled" 
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:hasFragileUserData="true"
        tools:targetApi="34">

        <!-- The launcher's entry is one of the activity-aliases below, not this activity. -->
        <activity android:name=".ui.MainActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <!-- tailsocks:// links open a screen and nothing more (ui/DeepLinks.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tailsocks" />
            </intent-filter>
        </activity>

        <!-- The launcher icons (core/AppIcons.kt): an alias of MainActivity per icon, and
             exactly one enabled. The app switches them with setComponentEnabledSetting; a new
             install shows the fox sock, the only one enabled here. Each carries the launcher
             shortcuts (res/xml/shortcuts.xml): the system reads them from the enabled launcher
             activity, so all must name them, under the same ids. -->
        <activity-alias android:name=".ui.Launcher_fox_sock" android:targetActivity=".ui.MainActivity" android:exported="true" android:enabled="true" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias android:name=".ui.Launcher_flat_curl" android:targetActivity=".ui.MainActivity" android:exported="true" android:enabled="false" android:icon="@mipmap/ic_launcher_flat_curl" android:roundIcon="@mipmap/ic_launcher_flat_curl">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias android:name=".ui.Launcher_line_tail" android:targetActivity=".ui.MainActivity" android:exported="true" android:enabled="false" android:icon="@mipmap/ic_launcher_line_tail" android:roundIcon="@mipmap/ic_launcher_line_tail">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias android:name=".ui.Launcher_pixel_sock" android:targetActivity=".ui.MainActivity" android:exported="true" android:enabled="false" android:icon="@mipmap/ic_launcher_pixel_sock" android:roundIcon="@mipmap/ic_launcher_pixel_sock">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias android:name=".ui.Launcher_pixel_fox" android:targetActivity=".ui.MainActivity" android:exported="true" android:enabled="false" android:icon="@mipmap/ic_launcher_pixel_fox" android:roundIcon="@mipmap/ic_launcher_pixel_fox">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias android:name=".ui.Launcher_sleepy_fox" android:targetActivity=".ui.MainActivity" android:exported="true" android:enabled="false" android:icon="@mipmap/ic_launcher_sleepy_fox" android:roundIcon="@mipmap/ic_launcher_sleepy_fox">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias android:name=".ui.Launcher_facet_fox" android:targetActivity=".ui.MainActivity" android:exported="true" android:enabled="false" android:icon="@mipmap/ic_launcher_facet_fox" android:roundIcon="@mipmap/ic_launcher_facet_fox">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias android:name=".ui.Launcher_sock_thief" android:targetActivity=".ui.MainActivity" android:exported="true" android:enabled="false" android:icon="@mipmap/ic_launcher_sock_thief" android:roundIcon="@mipmap/ic_launcher_sock_thief">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias android:name=".ui.Launcher_mesh_paw" android:targetActivity=".ui.MainActivity" android:exported="true" android:enabled="false" android:icon="@mipmap/ic_launcher_mesh_paw" android:roundIcon="@mipmap/ic_launcher_mesh_paw">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias android:name=".ui.Launcher_stocking" android:targetActivity=".ui.MainActivity" android:exported="true" android:enabled="false" android:icon="@mipmap/ic_launcher_stocking" android:roundIcon="@mipmap/ic_launcher_stocking">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias android:name=".ui.Launcher_pumpkin" android:targetActivity=".ui.MainActivity" android:exported="true" android:enabled="false" android:icon="@mipmap/ic_launcher_pumpkin" android:roundIcon="@mipmap/ic_launcher_pumpkin">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias android:name=".ui.Launcher_knit" android:targetActivity=".ui.MainActivity" android:exported="true" android:enabled="false" android:icon="@mipmap/ic_launcher_knit" android:roundIcon="@mipmap/ic_launcher_knit">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias android:name=".ui.Launcher_hex_tile" android:targetActivity=".ui.MainActivity" android:exported="true" android:enabled="false" android:icon="@mipmap/ic_launcher_hex_tile" android:roundIcon="@mipmap/ic_launcher_hex_tile">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.PermissionsActivity" android:exported="false" />
        <activity android:name=".ui.FirstStartActivity" android:exported="false" />
        <activity android:name=".ui.NetcheckActivity" android:exported="false" />
        <activity android:name=".ui.FilesActivity" android:exported="false" />
        <activity android:name=".ui.LogsActivity" android:exported="false" />
        <activity android:name=".ui.TaildriveActivity" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity android:name=".ui.DnsActivity" android:exported="false" />
        <activity android:name=".ui.ServeActivity" android:exported="false" />
        <activity android:name=".ui.ConsoleActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.PeersActivity" android:exported="false" />
        <activity android:name=".admin.AdminApiActivity" android:exported="false" />

        <activity android:name=".ui.ToggleActivity" android:exported="false" android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true" />

        <activity android:name=".ui.ShareActivity" android:exported="true" android:theme="@style/Theme.Tailscaled.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.TailcatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="tailcat port forwarding" />
        </service>
        <service android:name=".core.TailscaledService" android:directBootAware="true" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="tailscale node service" />
        </service>

        <receiver android:name=".core.WatchdogReceiver" android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="io.github.bropines.tailscaled.WATCHDOG_CHECK" />
            </intent-filter>
        </receiver>

        <service
            android:name=".core.TunVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="vpn tunnel service" />
        </service>

        <activity
            android:name=".core.TunPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />

        <activity
            android:name=".ui.TunExcludedAppsActivity"
            android:label="@string/title_activity_tun_excluded_apps"
            android:exported="false" />

        <service android:name=".core.ProxyTileService" android:exported="true" android:label="TailSocks" android:icon="@drawable/ic_qs_tile" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver android:name=".core.BootReceiver" android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Tasker & Automation Integration Receiver -->
        <receiver android:name=".core.TaskerReceiver" android:enabled="true" android:exported="true">
            <intent-filter>
                <action android:name="io.github.bropines.tailscaled.action.CONNECT" />
                <action android:name="io.github.bropines.tailscaled.action.DISCONNECT" />
                <action android:name="io.github.bropines.tailscaled.action.TOGGLE" />
                <action android:name="io.github.bropines.tailscaled.action.RESTART" />
                <action android:name="io.github.bropines.tailscaled.action.GET_STATUS" />
                <action android:name="io.github.bropines.tailscaled.action.SET_EXIT_NODE" />
                <action android:name="io.github.bropines.tailscaled.action.SWITCH_ACCOUNT" />
                <action android:name="io.github.bropines.tailscaled.action.SET_BYEDPI" />
                <action android:name="io.github.bropines.tailscaled.action.SET_TUN" />
                <action android:name="io.github.bropines.tailscaled.START" />
                <action android:name="io.github.bropines.tailscaled.STOP" />
                <action android:name="io.github.bropines.tailscaled.TOGGLE" />
                <action android:name="io.github.bropines.tailscaled.RESTART" />
                <action android:name="io.github.bropines.tailscaled.GET_STATUS" />
                <action android:name="io.github.bropines.tailscaled.SET_EXIT_NODE" />
                <action android:name="io.github.bropines.tailscaled.SWITCH_ACCOUNT" />
                <action android:name="io.github.bropines.tailscaled.SET_BYEDPI" />
                <action android:name="io.github.bropines.tailscaled.SET_TUN" />
            </intent-filter>
        </receiver>

        <receiver android:name=".ui.TailDropReceiver" android:exported="false" />

        <provider
            android:name=".core.TailsocksFileProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- TailSocks Switcher (Toggle) Widget -->
        <receiver android:name=".ui.ServiceToggleWidgetReceiver" android:exported="false" android:label="TailSocks Switcher">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="io.github.bropines.tailscaled.STATUS_CHANGED" />
                <action android:name="io.github.bropines.tailscaled.STATUS" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_service" />
        </receiver>

        <!-- Exit Node Toggle Widget -->
        <receiver android:name=".ui.ExitNodeToggleWidgetReceiver" android:exported="false" android:label="TailSocks Exit Node">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="io.github.bropines.tailscaled.STATUS_CHANGED" />
                <action android:name="io.github.bropines.tailscaled.STATUS" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_exit_node" />
        </receiver>
        <!-- AppLocalesMetadataHolderService for backward-compatible app-specific language settings -->
        <!-- Jetpack AppFunctions Service (Gemini On-Device AI Integration) -->
        <!-- BIND_APP_FUNCTION_SERVICE exists from API 36. Below it the platform
             has no such permission and never binds the service, which is the
             behaviour we want; tools:targetApi says so rather than leaving lint
             to call it an error. -->
        <service
            android:name=".appfunctions.TailSocksAppFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <!-- The AppSearch apps-indexer only picks up functions whose service
                 declares the schema and the generated v2 metadata asset. Without
                 these two properties the service binds but nothing is indexed, so
                 no assistant ever sees the functions. Both files are generated by
                 the AppFunctions KSP compiler into assets/. -->
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="app_functions_v2.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
    </application>
</manifest>