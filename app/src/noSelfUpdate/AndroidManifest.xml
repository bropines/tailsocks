<?xml version="1.0" encoding="utf-8"?>
<!-- Merged over the main manifest for a release built with -PselfUpdate=false
     (F-Droid): an app that cannot update itself has no business asking to
     install packages. See app/build.gradle.kts. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
</manifest>
