+// viaNetstack reports whether an upstream resolver at ip must be dialled
+// through netstack: only in userspace-networking mode (UseNetstackForIP is set
+// by cmd/tailscaled there and nil with a kernel TUN), for addresses that are a
+// peer or behind a peer's subnet route, and never for the MagicDNS service IPs
+// themselves — forwarding to those would loop back into this resolver. This
+// applies to every userspace-networking tailscaled and tsnet, not just Android.
+func (f *forwarder) viaNetstack(ip netip.Addr) bool {
+	if f.dialer == nil || f.dialer.UseNetstackForIP == nil {
+		return false
+	}
+	if ip == tsaddr.TailscaleServiceIP() || ip == tsaddr.TailscaleServiceIPv6() {
+		return false
+	}
+	return f.dialer.UseNetstackForIP(ip)
+}
+
+// sendUDPNetstack is sendUDP for a resolver on a tailnet address: the query is
+// sent over a netstack UDP connection (tsdial.Dialer.UserDial ->
+// NetstackDialUDP) instead of an OS socket that the OS cannot route.
+func (f *forwarder) sendUDPNetstack(ctx context.Context, fq *forwardQuery, ipp netip.AddrPort, udpFam string) ([]byte, error) {
+	c, err := f.dialer.UserDial(ctx, udpFam, ipp.String())
+	if err != nil {
+		return nil, err
+	}
+	defer c.Close()
+
+	fq.closeOnCtxDone.Add(c)
+	defer fq.closeOnCtxDone.Remove(c)
+
+	if _, err := c.Write(fq.packet); err != nil {
+		metricDNSFwdUDPErrorWrite.Add(1)
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		return nil, err
+	}
+	metricDNSFwdUDPWrote.Add(1)
+
+	// The 1 extra byte is to detect packet truncation.
+	out := make([]byte, maxResponseBytes+1)
+	n, err := c.Read(out)
+	if err != nil {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		metricDNSFwdUDPErrorRead.Add(1)
+		return nil, err
+	}
+	return f.finishUDPResponse(fq, out, n)
+}
