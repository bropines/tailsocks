+// TailSocks: last-resort DNS rescue.
+//
+// While an exit node is selected, tailscaled forwards every query that no
+// split-DNS route claims to that peer's peerapi DoH endpoint
+// (http://<peer>:<port>/dns-query). The peer answers HTTP 403 whenever the
+// requester is not (or is no longer) its exit-node client, which is exactly
+// what happens for a few seconds around an exit-node switch. The forwarder
+// then returns SERVFAIL and the device has no working DNS at all, even though
+// the OS base config names perfectly good resolvers (on Android those are the
+// app's fallbacks, TS_DNS_FALLBACK; see net/dns/noop.go).
+//
+// dnsRescue retries such a query once against those base-config resolvers.
+// It is deliberately narrow: only the default/global route qualifies, because
+// a split-DNS route is a resolver the user chose on purpose and must never
+// silently leak to a public one.
+const (
+	// dnsRescueTimeout bounds a single rescue. It is applied on top of the
+	// caller's context, so a rescue can never outlive the query that
+	// triggered it.
+	dnsRescueTimeout = 4 * time.Second
+
+	// dnsRescueLogPeriod is the minimum gap between two rescue log lines.
+	dnsRescueLogPeriod = 30 * time.Second
+
+	// dnsRescueMaxResolvers caps how many base-config resolvers one rescue
+	// races, so a long TS_DNS_FALLBACK list can't turn a failure into a
+	// burst of queries.
+	dnsRescueMaxResolvers = 4
+)
+
+var (
+	// TS_DNS_RESCUE turns the rescue off ("0"/"false"/"off"/"no"). It
+	// defaults to on when unset: the failure it prevents is total loss of
+	// DNS, and the retry only ever happens after the configured resolvers
+	// have already failed. Parsed leniently on purpose — envknob's boolean
+	// helpers log.Fatalf on a malformed value, and losing the daemon over a
+	// typo in an optional switch would be worse than ignoring it.
+	dnsRescueEnv = envknob.RegisterString("TS_DNS_RESCUE")
+
+	// TS_DNS_FALLBACK is the app's OS base config, read here in the same
+	// format net/dns/noop.go accepts. The forwarder can't ask net/dns for
+	// the base config (that package imports this one), and this is the same
+	// list GetBaseConfig would return.
+	dnsRescueFallbackEnv = envknob.RegisterString("TS_DNS_FALLBACK")
+
+	dnsRescueResolversOnce sync.Once
+	dnsRescueResolversLazy []*dnstype.Resolver
+)
+
+// dnsRescueEnabled reports whether the rescue is switched on.
+func dnsRescueEnabled() bool {
+	switch strings.ToLower(strings.TrimSpace(dnsRescueEnv())) {
+	case "0", "false", "off", "no":
+		return false
+	}
+	return true
+}
+
+// dnsRescueBaseResolvers returns the OS base-config resolvers, parsed once.
+func dnsRescueBaseResolvers() []*dnstype.Resolver {
+	dnsRescueResolversOnce.Do(func() {
+		for _, s := range strings.Split(dnsRescueFallbackEnv(), ",") {
+			s = strings.TrimSpace(s)
+			if s == "" {
+				continue
+			}
+			var ipp netip.AddrPort
+			if v, err := netip.ParseAddrPort(s); err == nil {
+				ipp = v
+			} else if a, err := netip.ParseAddr(s); err == nil {
+				ipp = netip.AddrPortFrom(a, 53)
+			} else {
+				continue
+			}
+			// Never rescue through our own MagicDNS service IPs: the query
+			// would come straight back into this resolver.
+			if ipp.Addr() == tsaddr.TailscaleServiceIP() || ipp.Addr() == tsaddr.TailscaleServiceIPv6() {
+				continue
+			}
+			dnsRescueResolversLazy = append(dnsRescueResolversLazy, &dnstype.Resolver{Addr: ipp.String()})
+			if len(dnsRescueResolversLazy) == dnsRescueMaxResolvers {
+				break
+			}
+		}
+	})
+	return dnsRescueResolversLazy
+}
+
+// dnsRescueEligibleName reports whether domain may be retried against a public
+// base-config resolver. Tailnet names and reverse lookups of Tailscale
+// addresses (the MagicDNS service IPs among them) never may: a public resolver
+// cannot answer them, and asking would leak them.
+func dnsRescueEligibleName(domain dnsname.FQDN) bool {
+	name := string(domain)
+	if name == "" {
+		return false
+	}
+	if name == "ts.net." || strings.HasSuffix(name, ".ts.net.") {
+		return false
+	}
+	if ipStr, ok := unARPA(name); ok {
+		ip, err := netip.ParseAddr(ipStr)
+		if err != nil {
+			return false
+		}
+		if tsaddr.IsTailscaleIP(ip) ||
+			ip == tsaddr.TailscaleServiceIP() || ip == tsaddr.TailscaleServiceIPv6() {
+			return false
+		}
+	}
+	return true
+}
+
+// dnsRescueCandidates returns the base-config resolvers worth retrying,
+// dropping any that just failed — without an exit node the default route's
+// resolvers are these same addresses, and asking them twice would only cost
+// time.
+func dnsRescueCandidates(failed []resolverAndDelay) []resolverAndDelay {
+	base := dnsRescueBaseResolvers()
+	if len(base) == 0 {
+		return nil
+	}
+	failedAddrs := make(map[netip.AddrPort]bool, len(failed))
+	for _, rr := range failed {
+		if ipp, ok := rr.name.IPPort(); ok {
+			failedAddrs[ipp] = true
+		}
+	}
+	var out []resolverAndDelay
+	for _, r := range base {
+		ipp, ok := r.IPPort()
+		if !ok || failedAddrs[ipp] {
+			continue
+		}
+		out = append(out, resolverAndDelay{name: r})
+	}
+	return out
+}
+
+// dnsRescue retries fq against the OS base-config resolvers and returns the
+// response, or nil if the rescue does not apply or did not produce one.
+//
+// res is the response the client would otherwise get; the rescue only runs
+// when it is SERVFAIL or REFUSED. That single test covers every failure mode
+// this exists for: a transport error and a non-200 DoH status both arrive here
+// as a synthesized SERVFAIL, an upstream SERVFAIL/REFUSED rcode over UDP or
+// TCP arrives as the upstream's own bytes, and a DoH endpoint that answers 200
+// with a SERVFAIL body reaches us as a "successful" response.
+//
+// eligible must be true only for the default/global route; see
+// resolversAndRoute.
+func (f *forwarder) dnsRescue(ctx context.Context, fq *forwardQuery, domain dnsname.FQDN, res []byte, failed []resolverAndDelay, eligible bool) []byte {
+	// Cheapest checks first: this runs on the success path of every query.
+	if !eligible {
+		return nil
+	}
+	switch getRCode(res) {
+	case dns.RCodeServerFailure, dns.RCodeRefused:
+	default:
+		return nil
+	}
+	if !dnsRescueEnabled() || !dnsRescueEligibleName(domain) {
+		return nil
+	}
+	rrs := dnsRescueCandidates(failed)
+	if len(rrs) == 0 {
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		return nil
+	}
+	metricDNSFwdRescue.Add(1)
+
+	// Bounded by the caller's context as well as our own deadline, so the
+	// rescue cannot outlive the query it is rescuing.
+	ctx, cancel := context.WithTimeout(ctx, dnsRescueTimeout)
+	defer cancel()
+
+	type rescueResult struct {
+		res  []byte
+		addr string
+		err  error
+	}
+	// Buffered for every sender so none of them can outlive this function
+	// blocked on a send.
+	resc := make(chan rescueResult, len(rrs))
+	for i := range rrs {
+		go func(rr resolverAndDelay) {
+			out, err := f.send(ctx, fq, rr)
+			resc <- rescueResult{out, rr.name.Addr, err}
+		}(rrs[i])
+	}
+	for range rrs {
+		select {
+		case r := <-resc:
+			if r.err != nil {
+				continue
+			}
+			metricDNSFwdRescueSuccess.Add(1)
+			f.logRescue(domain, failed, r.addr)
+			return r.res
+		case <-ctx.Done():
+			f.logf("[v1] dns rescue for %q: %v", domain, ctx.Err())
+			return nil
+		}
+	}
+	f.logf("[v1] dns rescue for %q: no base resolver answered", domain)
+	return nil
+}
+
+// logRescue logs a successful rescue, at most once per dnsRescueLogPeriod, so
+// the Logs screen shows why DNS suddenly started working through a different
+// path without a line per query.
+func (f *forwarder) logRescue(domain dnsname.FQDN, failed []resolverAndDelay, answered string) {
+	now := time.Now().UnixNano()
+	last := f.rescueLogLast.Load()
+	if now-last < int64(dnsRescueLogPeriod) || !f.rescueLogLast.CompareAndSwap(last, now) {
+		return
+	}
+	addrs := make([]string, 0, len(failed))
+	for _, rr := range failed {
+		addrs = append(addrs, rr.name.Addr)
+	}
+	f.logf("dns rescue: %q failed via %s, answered by %s (set TS_DNS_RESCUE=0 to disable)",
+		domain, strings.Join(addrs, ","), answered)
+}
