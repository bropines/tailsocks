@@ -0,0 +1,33 @@
+package ipnstate
+
+import (
+	"testing"
+
+	"tailscale.com/types/key"
+)
+
+// A peer is reported in parts — the netmap's copy names its program, the
+// engine's and magicsock's say nothing about it — and whichever comes first,
+// the merged peer keeps the name.
+func TestAddPeerKeepsApp(t *testing.T) {
+	for _, netmapFirst := range []bool{true, false} {
+		pk := key.NewNode().Public()
+		sb := &StatusBuilder{WantPeers: true}
+		netmap := &PeerStatus{OS: "android", App: "tailsocks", InNetworkMap: true}
+		if netmapFirst {
+			sb.AddPeer(pk, netmap)
+		}
+		sb.AddPeer(pk, &PeerStatus{InMagicSock: true})
+		sb.AddPeer(pk, &PeerStatus{InEngine: true})
+		if !netmapFirst {
+			sb.AddPeer(pk, netmap)
+		}
+		got := sb.Status().Peer[pk]
+		if got.App != "tailsocks" {
+			t.Errorf("netmap first %v: App = %q, want tailsocks", netmapFirst, got.App)
+		}
+		if !got.InNetworkMap || !got.InMagicSock || !got.InEngine {
+			t.Errorf("netmap first %v: merge lost a flag: %+v", netmapFirst, got)
+		}
+	}
+}
