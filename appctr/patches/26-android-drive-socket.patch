+package netstack
+
+// TailSocks: Taildrive for the app without a network in between.
+//
+// A local client reaches the tailnet's shares at 100.100.100.100:8080, and
+// what answers there is the backend's handler for that port. The app's own
+// client used to get there through the daemon's SOCKS5 port, which made
+// Taildrive depend on that port being on, its password and the mode the
+// daemon runs in. cmd/tailscaled/android_drive.go hands the connections of a
+// unix socket beside the daemon's to this instead.
+
+import (
+	"errors"
+	"net"
+	"net/netip"
+
+	"tailscale.com/ipn/ipnlocal"
+)
+
+// ServeTaildriveConn serves c as a connection to 100.100.100.100:8080: the
+// tailnet's Taildrive shares, with the same access checks. It closes c when
+// there is nothing to serve it with.
+func (ns *Impl) ServeTaildriveConn(c net.Conn) error {
+	if !ns.ready.Load() || ns.lb == nil {
+		c.Close()
+		return errors.New("netstack not started")
+	}
+	handler, _ := ns.lb.TCPHandlerForDst(netip.AddrPortFrom(serviceIP, 0), netip.AddrPortFrom(serviceIP, ipnlocal.DriveLocalPort))
+	if handler == nil {
+		c.Close()
+		return errors.New("no Taildrive handler")
+	}
+	return handler(c)
+}
