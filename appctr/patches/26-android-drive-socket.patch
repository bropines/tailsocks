+//go:build linux && !ts_omit_netstack
+
+package main
+
+// TailSocks: the tailnet's Taildrive shares on a unix socket beside the
+// daemon's, for the app.
+//
+// A local WebDAV client reaches the shares at 100.100.100.100:8080, and the
+// app's own client used to get there through the daemon's SOCKS5 port. That
+// tied Taildrive to the port being on, to its password and to the mode the
+// daemon runs in (on Android's VPN the dial to the service IP did not even
+// complete for a while). This socket is the same handler with nothing in
+// between: a connection to it is served exactly as one to
+// 100.100.100.100:8080, access checks included.
+//
+// Who may connect: the daemon's own UID and the owner of the directory the
+// socket is in — the app's data directory. In Root Mode the daemon is root and
+// the app is not, so the file is open to every UID and the peer's credentials
+// decide.
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"syscall"
+	"time"
+
+	"golang.org/x/sys/unix"
+	"tailscale.com/types/logger"
+	"tailscale.com/wgengine/netstack"
+)
+
+// driveSocketName must equal DriveSocketName in appctr/drive.go.
+const driveSocketName = "drive.sock"
+
+// serveTailSocksDrive serves ns's Taildrive on drive.sock beside the daemon's
+// socket. It does nothing without a socket path.
+func serveTailSocksDrive(logf logger.Logf, ns *netstack.Impl) {
+	if args.socketpath == "" {
+		return
+	}
+	dir := filepath.Dir(args.socketpath)
+	path := filepath.Join(dir, driveSocketName)
+	os.Remove(path)
+	ln, err := net.ListenUnix("unix", &net.UnixAddr{Name: path, Net: "unix"})
+	if err != nil {
+		logf("taildrive-socket: %v", err)
+		return
+	}
+	if err := os.Chmod(path, 0o666); err != nil {
+		logf("taildrive-socket: %v", err)
+		ln.Close()
+		return
+	}
+	owner := -1
+	if fi, err := os.Stat(dir); err == nil {
+		if st, ok := fi.Sys().(*syscall.Stat_t); ok {
+			owner = int(st.Uid)
+		}
+	}
+	go func() {
+		for {
+			c, err := ln.AcceptUnix()
+			if err != nil {
+				if errors.Is(err, net.ErrClosed) {
+					return
+				}
+				logf("taildrive-socket: accept: %v", err)
+				time.Sleep(100 * time.Millisecond)
+				continue
+			}
+			go func() {
+				if err := checkDrivePeer(c, owner); err != nil {
+					logf("taildrive-socket: %v", err)
+					c.Close()
+					return
+				}
+				ns.ServeTaildriveConn(c)
+			}()
+		}
+	}()
+}
+
+// checkDrivePeer lets in the daemon's own UID and owner, the app's.
+func checkDrivePeer(c *net.UnixConn, owner int) error {
+	raw, err := c.SyscallConn()
+	if err != nil {
+		return err
+	}
+	var cred *unix.Ucred
+	var credErr error
+	if err := raw.Control(func(fd uintptr) {
+		cred, credErr = unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED)
+	}); err != nil {
+		return err
+	}
+	if credErr != nil {
+		return credErr
+	}
+	if uid := int(cred.Uid); uid != os.Getuid() && uid != owner {
+		return fmt.Errorf("uid %d may not use Taildrive here", uid)
+	}
+	return nil
+}
