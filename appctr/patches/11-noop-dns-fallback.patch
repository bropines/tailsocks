--- orig/net/dns/noop.go
+++ tailscale_src/net/dns/noop.go
@@ -3,12 +3,48 @@
 
 package dns
 
+import (
+	"net/netip"
+	"os"
+	"strings"
+
+	"tailscale.com/net/tsaddr"
+)
+
 type noopManager struct{}
 
 func (m noopManager) SetDNS(OSConfig) error  { return nil }
 func (m noopManager) SupportsSplitDNS() bool { return false }
 func (m noopManager) Close() error           { return nil }
 func (m noopManager) GetBaseConfig() (OSConfig, error) {
+	// TS_DNS_FALLBACK: inject upstream resolvers when the control plane provides
+	// none (e.g. no exit node, no custom DNS in the admin console).
+	// Set by the TailSocks bridge from the user-configured DnsFallbacks option.
+	// Accepts comma-separated "1.2.3.4" or "1.2.3.4:53" entries.
+	if ns := os.Getenv("TS_DNS_FALLBACK"); ns != "" {
+		var nameservers []netip.Addr
+		for _, s := range strings.Split(ns, ",") {
+			s = strings.TrimSpace(s)
+			var ip netip.Addr
+			if ipp, err := netip.ParseAddrPort(s); err == nil {
+				ip = ipp.Addr()
+			} else if a, err := netip.ParseAddr(s); err == nil {
+				ip = a
+			} else {
+				continue
+			}
+			// Never forward to our own MagicDNS service IPs: with netstack
+			// dialling of tailnet resolvers that would loop the resolver into
+			// itself. Mirrors the Linux direct manager's filter.
+			if ip == tsaddr.TailscaleServiceIP() || ip == tsaddr.TailscaleServiceIPv6() {
+				continue
+			}
+			nameservers = append(nameservers, ip)
+		}
+		if len(nameservers) > 0 {
+			return OSConfig{Nameservers: nameservers}, nil
+		}
+	}
 	return OSConfig{}, ErrGetBaseConfigNotSupported
 }
 
