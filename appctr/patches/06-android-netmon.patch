--- /dev/null	2026-10-07 00:25:56.942684671 +0300
+++ tailscale_src/cmd/tailscaled/fix_android_netmon.go	2026-10-09 19:42:15.126232377 +0300
@@ -0,0 +1,188 @@
+//go:build android
+// +build android
+
+package main
+
+import (
+	"encoding/json"
+	"net"
+	"os"
+	"os/signal"
+	"strings"
+	"sync/atomic"
+	"syscall"
+
+	"github.com/wlynxg/anet"
+	"tailscale.com/hostinfo"
+	"tailscale.com/net/netmon"
+	"tailscale.com/tailcfg"
+)
+
+// androidNetMon is this daemon's network monitor, handed over by startup so
+// that the signal handler below can wake it.
+var androidNetMon atomic.Pointer[netmon.Monitor]
+
+// setAndroidNetMon is called once, from tailscaled's own startup.
+func setAndroidNetMon(m *netmon.Monitor) { androidNetMon.Store(m) }
+
+func init() {
+	// What the daemon tells the coordination server about this device.
+	//
+	// The default has been a masquerade since 2026-05-07: OS "linux", App
+	// "tailscale-cli", DeviceModel "Tailsocks", added on the belief that the
+	// coordinator ignored advertised services from "android" nodes. Nothing in
+	// the client reads these fields for behaviour (the only peer-OS check
+	// anywhere refuses tvOS for Taildrop), and the one Android gate that does
+	// matter for Serve/Funnel is the build tag on ipn/localapi/cert.go, which
+	// keys on runtime.GOOS and is lifted by patch 05 — so what the control
+	// plane does with the reported OS is an open question, not a known cost.
+	//
+	// TS_HONEST_HOSTINFO=1 keeps the real OS ("android", already filled in by
+	// hostinfo.New from version.OS) and reports what Go cannot learn on Android
+	// from the environment the app supplies, exactly the fields the official
+	// Android client sets (libtailscale/backend.go: SetOSVersion,
+	// SetDeviceModel, SetPackage — and no App).
+	hostinfo.RegisterHostinfoNewHook(func(hi *tailcfg.Hostinfo) {
+		if os.Getenv("TS_HONEST_HOSTINFO") == "1" {
+			if v := os.Getenv("TS_HI_OS_VERSION"); v != "" {
+				hi.OSVersion = v
+			}
+			if v := os.Getenv("TS_HI_DEVICE_MODEL"); v != "" {
+				hi.DeviceModel = v
+			}
+			if v := os.Getenv("TS_HI_PACKAGE"); v != "" {
+				hi.Package = v
+			}
+			return
+		}
+		hi.App = "tailscale-cli"
+		hi.DeviceModel = "Tailsocks"
+		hi.OS = "linux"
+	})
+
+	// What the daemon reports as its interfaces.
+	//
+	// Live first: anet reads them itself and works here even though netlink is
+	// closed to app processes, and only live data can differ from one call to
+	// the next — which is what makes a change detectable at all. The snapshot
+	// the app passed at launch is the fallback for the Androids where anet
+	// cannot answer; being fixed at exec, it can never report a change, so it
+	// is a starting picture and not a source of truth.
+	netmon.RegisterInterfaceGetter(func() ([]netmon.Interface, error) {
+		if ifs := interfacesFromAnet(); len(ifs) > 0 {
+			return ifs, nil
+		}
+		if ifs := interfacesFromLaunchState(); len(ifs) > 0 {
+			return ifs, nil
+		}
+		// Neither source answered. An empty list beats an error, which would
+		// break netcheck outright.
+		return []netmon.Interface{}, nil
+	})
+
+	// The app knows when the network moved; this daemon does not. Upstream
+	// leaves Android's polling fallback at ten minutes for exactly this
+	// reason — it expects the app to wake the monitor — and the official
+	// client does that in-process. Ours runs the daemon as a child, so the
+	// nudge arrives as a signal from appctr.InjectNetworkState.
+	//
+	// With the nudge comes the name of the interface that now carries the
+	// default route: on Android netmon learns it only through
+	// UpdateLastKnownDefaultRouteInterface, which nothing in a separate daemon
+	// calls. Without it the default interface is "" and never viable, so no
+	// change is ever judged to need a rebind.
+	loadDefaultRoute()
+	wake := make(chan os.Signal, 1)
+	signal.Notify(wake, syscall.SIGUSR1)
+	go func() {
+		for range wake {
+			loadDefaultRoute()
+			if m := androidNetMon.Load(); m != nil {
+				m.InjectEvent()
+			}
+		}
+	}()
+}
+
+// loadDefaultRoute hands netmon the default-route interface the app last
+// wrote to TS_NETROUTE_FILE ("" while there is no network).
+func loadDefaultRoute() {
+	path := os.Getenv("TS_NETROUTE_FILE")
+	if path == "" {
+		return
+	}
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return
+	}
+	netmon.UpdateLastKnownDefaultRouteInterface(strings.TrimSpace(string(b)))
+}
+
+// interfacesFromAnet reads the interfaces from the system. Returns nothing at
+// all if that is not permitted, which is what the launch snapshot is for.
+func interfacesFromAnet() []netmon.Interface {
+	ifs, err := anet.Interfaces()
+	if err != nil {
+		return nil
+	}
+	ret := make([]netmon.Interface, len(ifs))
+	for i := range ifs {
+		addrs, err := anet.InterfaceAddrsByInterface(&ifs[i])
+		if err != nil {
+			// Keep the interface; an address we cannot read is not a reason to
+			// forget that it exists.
+			ret[i] = netmon.Interface{Interface: &ifs[i]}
+			continue
+		}
+		ret[i] = netmon.Interface{Interface: &ifs[i], AltAddrs: addrs}
+	}
+	return ret
+}
+
+// interfacesFromLaunchState parses TS_NET_STATE, the picture the app took when
+// it started this daemon.
+func interfacesFromLaunchState() []netmon.Interface {
+	envState := os.Getenv("TS_NET_STATE")
+	if envState == "" {
+		return nil
+	}
+	var list []struct {
+		Name      string   `json:"name"`
+		Addresses []string `json:"addresses"`
+		Up        bool     `json:"up"`
+		MTU       int      `json:"mtu"`
+	}
+	if err := json.Unmarshal([]byte(envState), &list); err != nil {
+		return nil
+	}
+	ret := make([]netmon.Interface, 0, len(list))
+	for _, iface := range list {
+		if !iface.Up {
+			continue
+		}
+		ni := netmon.Interface{
+			Interface: &net.Interface{
+				Name:  iface.Name,
+				MTU:   iface.MTU,
+				Flags: net.FlagUp,
+			},
+		}
+		for _, addr := range iface.Addresses {
+			ip := net.ParseIP(addr)
+			if ip == nil {
+				continue
+			}
+			// The app does not send masks; a host route is close enough for
+			// telling one state from another.
+			mask := net.CIDRMask(32, 32)
+			if ip.To4() == nil {
+				mask = net.CIDRMask(128, 128)
+			}
+			ni.AltAddrs = append(ni.AltAddrs, &net.IPNet{IP: ip, Mask: mask})
+		}
+		if len(ni.AltAddrs) > 0 {
+			ret = append(ret, ni)
+		}
+	}
+	return ret
+}
