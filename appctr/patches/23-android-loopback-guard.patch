+package ipnlocal
+
+// TailSocks: test-only access that tests of other packages need.
+
+import "net/netip"
+
+// SetPeerAPIPorts stands in for the peerAPI listeners: TCPHandlerForDst hands
+// a connection to one of these ports of a local address to the peerAPI, as it
+// does in the daemon once the listeners are up. For wgengine/netstack's tests
+// of what reaches localhost.
+func (f forTest) SetPeerAPIPorts(ports map[netip.Addr]int) {
+	f.b.peerAPIPorts.Store(ports)
+}
