+package netstack
+
+// TailSocks: which tailnet flows netstack may hand to localhost.
+
+import (
+	"net"
+	"net/netip"
+
+	"tailscale.com/net/tsaddr"
+	"tailscale.com/types/ipproto"
+	"tailscale.com/types/nettype"
+	"tailscale.com/util/clientmetric"
+)
+
+var (
+	metricLoopbackRefusedTCP = clientmetric.NewCounter("netstack_tcp_loopback_refused")
+	metricLoopbackRefusedUDP = clientmetric.NewCounter("netstack_udp_loopback_refused")
+)
+
+// GuardLoopback limits what netstack's default path hands to localhost.
+//
+// Upstream, a TCP flow addressed to a Tailscale IP that nothing took before —
+// DNS on the service IP, Serve and Funnel, the peerAPI (Taildrop, Taildrive,
+// peer DNS), Tailscale SSH and the web client, Tailscale Services — is
+// forwarded to the same port on 127.0.0.1 (acceptTCP), and a UDP flow to one
+// of the node's own addresses likewise (forwardUDP). Every loopback listener
+// on the machine thereby serves every peer the packet filter lets in. On
+// Android, where userspace networking is the default and the apps' local
+// proxies listen on 127.0.0.1 without a password, that is a relay into the
+// device's network and the internet, and a door to whatever those listeners
+// do under this device's identity.
+//
+// With the guard such a flow reaches localhost only when it is addressed to
+// one of this node's own addresses and allow approves its protocol and
+// destination port. Every other one is refused: TCP with a RST, UDP by
+// dropping the flow. Flows the default path does not send to localhost —
+// subnet routes, an exit node's traffic, 4via6, the service IP — are left to
+// it as they are, and so is everything handled before the hook.
+//
+// The guard takes the GetTCPHandlerForFlow and GetUDPHandlerForFlow hooks;
+// one already set keeps the first word. It must be installed before Start.
+func (ns *Impl) GuardLoopback(allow func(proto ipproto.Proto, port uint16) bool) {
+	prevTCP, prevUDP := ns.GetTCPHandlerForFlow, ns.GetUDPHandlerForFlow
+	ns.GetTCPHandlerForFlow = func(src, dst netip.AddrPort) (func(net.Conn), bool) {
+		if prevTCP != nil {
+			if h, intercept := prevTCP(src, dst); intercept {
+				return h, true
+			}
+		}
+		if !ns.refusesLoopback(ipproto.TCP, dst, allow) {
+			return nil, false
+		}
+		metricLoopbackRefusedTCP.Add(1)
+		ns.logf("netstack: refused TCP from %v to %v: not open to the tailnet", src, dst)
+		return nil, true // acceptTCP sends a RST
+	}
+	ns.GetUDPHandlerForFlow = func(src, dst netip.AddrPort) (func(nettype.ConnPacketConn), bool) {
+		if prevUDP != nil {
+			if h, intercept := prevUDP(src, dst); intercept {
+				return h, true
+			}
+		}
+		if !ns.refusesLoopback(ipproto.UDP, dst, allow) {
+			return nil, false
+		}
+		metricLoopbackRefusedUDP.Add(1)
+		return nil, true // acceptUDP closes the endpoint
+	}
+}
+
+// refusesLoopback reports whether the guard refuses a flow to dst that the
+// default path would forward to localhost.
+func (ns *Impl) refusesLoopback(proto ipproto.Proto, dst netip.AddrPort, allow func(ipproto.Proto, uint16) bool) bool {
+	if !ns.forwardsToLoopback(proto, dst.Addr()) {
+		return false
+	}
+	// A Tailscale IP that is not this node's — reachable here as an exit
+	// node's or a subnet router's destination — is never this device's to open.
+	if !ns.isLocalIP(dst.Addr()) {
+		return true
+	}
+	return allow == nil || !allow(proto, dst.Port())
+}
+
+// forwardsToLoopback reports whether the default path, past the flow hooks,
+// sends a flow to dst to localhost: acceptTCP's isTailscaleIP case and
+// forwardUDP's isLocal one. The service IP is acceptTCP's and acceptUDP's own
+// business (DNS, the debug loopback port, a RST or a drop for the rest).
+func (ns *Impl) forwardsToLoopback(proto ipproto.Proto, dst netip.Addr) bool {
+	switch proto {
+	case ipproto.TCP:
+		return tsaddr.IsTailscaleIP(dst) && !viaRange.Contains(dst) && dst != serviceIP && dst != serviceIPv6
+	case ipproto.UDP:
+		return ns.isLocalIP(dst)
+	}
+	return false
+}
--- /dev/null	2026-10-14 07:35:26.525338240 +0300
+++ tailscale_src/wgengine/netstack/loopback_guard_test.go	2026-10-15 13:08:20.059226428 +0300
@@ -0,0 +1,486 @@
+package netstack
+
+// TailSocks: GuardLoopback — what a tailnet flow may reach on localhost.
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/checksum"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"tailscale.com/ipn"
+	"tailscale.com/net/netx"
+	"tailscale.com/net/packet"
+	"tailscale.com/net/tsaddr"
+	"tailscale.com/tailcfg"
+	"tailscale.com/types/ipproto"
+	"tailscale.com/types/netmap"
+	"tailscale.com/types/nettype"
+	"tailscale.com/wgengine/filter"
+)
+
+// The app's listeners, as they are by default.
+const (
+	guardSOCKS5   = 48115 // SOCKS5, without a password unless one is set
+	guardRemote   = 28115 // remote management, while its switch is on
+	guardDrive    = 33445 // the Taildrive proxy
+	guardDNSProxy = 1053  // the DNS proxy, UDP
+)
+
+var (
+	guardPeer   = netip.MustParseAddr("100.101.102.103")
+	guardSelf4  = netip.MustParseAddr("100.101.102.104")
+	guardSelf6  = netip.MustParseAddr("fd7a:115c:a1e0:ab12:4843:cd96:6265:6668")
+	guardOther  = netip.MustParseAddr("100.99.99.99") // a Tailscale IP, not this node's
+	guardSubnet = netip.MustParseAddr("192.0.2.1")    // behind an advertised route
+	guardWeb    = netip.MustParseAddr("203.0.113.5")  // past this node as an exit node
+)
+
+// guardAllow is what the daemon builds from the app's switches: the
+// remote-management port while remote management is on, and the ports the
+// person opened to the tailnet.
+type guardAllow struct {
+	remote atomic.Bool
+	asked  atomic.Int32
+
+	mu   sync.Mutex
+	open map[ipproto.Proto]map[uint16]bool
+}
+
+func (a *guardAllow) allow(proto ipproto.Proto, port uint16) bool {
+	a.asked.Add(1)
+	if proto == ipproto.TCP && port == guardRemote {
+		return a.remote.Load()
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	return a.open[proto][port]
+}
+
+func (a *guardAllow) openPort(proto ipproto.Proto, port uint16) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.open == nil {
+		a.open = map[ipproto.Proto]map[uint16]bool{}
+	}
+	if a.open[proto] == nil {
+		a.open[proto] = map[uint16]bool{}
+	}
+	a.open[proto][port] = true
+}
+
+func selfNetmap() *netmap.NetworkMap {
+	return &netmap.NetworkMap{SelfNode: (&tailcfg.Node{Addresses: []netip.Prefix{
+		netip.PrefixFrom(guardSelf4, 32),
+		netip.PrefixFrom(guardSelf6, 128),
+	}}).View()}
+}
+
+func TestGuardLoopbackDecides(t *testing.T) {
+	a := new(guardAllow)
+	a.remote.Store(true)
+	impl := makeNetstack(t, func(impl *Impl) {
+		impl.GuardLoopback(a.allow)
+	})
+	impl.UpdateNetstackIPs(selfNetmap())
+	via := mustVia99(t, "10.1.2.3")
+
+	tests := []struct {
+		name   string
+		proto  ipproto.Proto
+		dst    netip.AddrPort
+		refuse bool
+	}{
+		{"socks5", ipproto.TCP, netip.AddrPortFrom(guardSelf4, guardSOCKS5), true},
+		{"socks5-ipv6", ipproto.TCP, netip.AddrPortFrom(guardSelf6, guardSOCKS5), true},
+		{"taildrive-proxy", ipproto.TCP, netip.AddrPortFrom(guardSelf4, guardDrive), true},
+		{"remote-management", ipproto.TCP, netip.AddrPortFrom(guardSelf4, guardRemote), false},
+		{"remote-management-ipv6", ipproto.TCP, netip.AddrPortFrom(guardSelf6, guardRemote), false},
+		{"dns-proxy", ipproto.UDP, netip.AddrPortFrom(guardSelf4, guardDNSProxy), true},
+		// Remote management is TCP; the same number in UDP is not it.
+		{"udp-remote-port", ipproto.UDP, netip.AddrPortFrom(guardSelf4, guardRemote), true},
+		// Upstream forwards TCP to any Tailscale IP to localhost, not only to
+		// the node's own: an exit node's or a subnet router's peer could ask.
+		{"another-nodes-address", ipproto.TCP, netip.AddrPortFrom(guardOther, guardRemote), true},
+		// What the default path does not send to localhost is not the guard's.
+		{"subnet-route", ipproto.TCP, netip.AddrPortFrom(guardSubnet, guardSOCKS5), false},
+		{"exit-node", ipproto.TCP, netip.AddrPortFrom(guardWeb, 443), false},
+		{"4via6", ipproto.TCP, netip.AddrPortFrom(via, 80), false},
+		{"service-ip", ipproto.TCP, netip.AddrPortFrom(tsaddr.TailscaleServiceIP(), 8080), false},
+		{"service-ip-v6", ipproto.TCP, netip.AddrPortFrom(tsaddr.TailscaleServiceIPv6(), 53), false},
+		{"udp-subnet-route", ipproto.UDP, netip.AddrPortFrom(guardSubnet, guardDNSProxy), false},
+		// forwardUDP dials another Tailscale IP as it is, not on localhost.
+		{"udp-another-nodes-address", ipproto.UDP, netip.AddrPortFrom(guardOther, guardDNSProxy), false},
+		{"udp-service-ip", ipproto.UDP, netip.AddrPortFrom(tsaddr.TailscaleServiceIP(), 53), false},
+	}
+	src := netip.AddrPortFrom(guardPeer, 1234)
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var refused bool
+			switch tt.proto {
+			case ipproto.TCP:
+				h, intercept := impl.GetTCPHandlerForFlow(src, tt.dst)
+				if h != nil {
+					t.Error("the guard handed out a handler; it only refuses")
+				}
+				refused = intercept
+			case ipproto.UDP:
+				h, intercept := impl.GetUDPHandlerForFlow(src, tt.dst)
+				if h != nil {
+					t.Error("the guard handed out a handler; it only refuses")
+				}
+				refused = intercept
+			}
+			if refused != tt.refuse {
+				t.Errorf("%v %v: refused = %v, want %v", tt.proto, tt.dst, refused, tt.refuse)
+			}
+		})
+	}
+
+	// The switch is asked for every flow: off, the port closes at once.
+	a.remote.Store(false)
+	if _, refused := impl.GetTCPHandlerForFlow(src, netip.AddrPortFrom(guardSelf4, guardRemote)); !refused {
+		t.Error("remote management switched off, and its port is still open")
+	}
+	// What the person opened opens, in its own protocol only.
+	a.openPort(ipproto.TCP, guardSOCKS5)
+	if _, refused := impl.GetTCPHandlerForFlow(src, netip.AddrPortFrom(guardSelf4, guardSOCKS5)); refused {
+		t.Error("SOCKS5 opened to the tailnet, and it is still refused")
+	}
+	if _, refused := impl.GetUDPHandlerForFlow(src, netip.AddrPortFrom(guardSelf4, guardSOCKS5)); !refused {
+		t.Error("opening SOCKS5's TCP port opened its UDP port too")
+	}
+}
+
+// Without an allow list nothing of the node reaches localhost.
+func TestGuardLoopbackNilAllowsNothing(t *testing.T) {
+	impl := makeNetstack(t, func(impl *Impl) { impl.GuardLoopback(nil) })
+	impl.UpdateNetstackIPs(selfNetmap())
+	src := netip.AddrPortFrom(guardPeer, 1234)
+	if _, refused := impl.GetTCPHandlerForFlow(src, netip.AddrPortFrom(guardSelf4, guardRemote)); !refused {
+		t.Error("TCP reached localhost with no allow list")
+	}
+	if _, refused := impl.GetUDPHandlerForFlow(src, netip.AddrPortFrom(guardSelf4, guardDNSProxy)); !refused {
+		t.Error("UDP reached localhost with no allow list")
+	}
+}
+
+// A hook set before the guard keeps the first word; what it lets pass, the
+// guard decides.
+func TestGuardLoopbackKeepsAnEarlierHook(t *testing.T) {
+	const theirs = 7000
+	tcpHandler := func(net.Conn) {}
+	udpHandler := func(nettype.ConnPacketConn) {}
+	impl := makeNetstack(t, func(impl *Impl) {
+		impl.GetTCPHandlerForFlow = func(src, dst netip.AddrPort) (func(net.Conn), bool) {
+			return tcpHandler, dst.Port() == theirs
+		}
+		impl.GetUDPHandlerForFlow = func(src, dst netip.AddrPort) (func(nettype.ConnPacketConn), bool) {
+			return udpHandler, dst.Port() == theirs
+		}
+		impl.GuardLoopback(nil)
+	})
+	impl.UpdateNetstackIPs(selfNetmap())
+	src := netip.AddrPortFrom(guardPeer, 1234)
+	if h, intercept := impl.GetTCPHandlerForFlow(src, netip.AddrPortFrom(guardSelf4, theirs)); h == nil || !intercept {
+		t.Error("TCP: the earlier hook lost its flow")
+	}
+	if h, intercept := impl.GetUDPHandlerForFlow(src, netip.AddrPortFrom(guardSelf4, theirs)); h == nil || !intercept {
+		t.Error("UDP: the earlier hook lost its flow")
+	}
+	if h, intercept := impl.GetTCPHandlerForFlow(src, netip.AddrPortFrom(guardSelf4, guardSOCKS5)); h != nil || !intercept {
+		t.Error("TCP: what the earlier hook let pass was not refused")
+	}
+}
+
+// recordingDialer stands in for forwardTCP's dial: it reports the address and
+// then hangs until the test ends, so acceptTCP stays where it is.
+func recordingDialer(tb testing.TB) (netx.DialFunc, chan string) {
+	done := make(chan struct{})
+	tb.Cleanup(func() { close(done) })
+	dialed := make(chan string, 8)
+	return func(ctx context.Context, network, address string) (net.Conn, error) {
+		select {
+		case dialed <- address:
+		default:
+		}
+		select {
+		case <-ctx.Done():
+		case <-done:
+		}
+		return nil, context.Canceled
+	}, dialed
+}
+
+// guardedNetstack is netstack as cmd/tailscaled sets it up in userspace
+// networking, with the guard and this node's addresses; its LocalBackend
+// serves port servePort to serveBackend and has a peerAPI on peerAPIPort.
+func guardedNetstack(t *testing.T, a *guardAllow, serveBackend net.Addr) *Impl {
+	impl := makeNetstack(t, func(impl *Impl) {
+		impl.ProcessLocalIPs = true
+		impl.ProcessSubnets = true
+		impl.GuardLoopback(a.allow)
+	})
+	nm := selfNetmap()
+	impl.UpdateNetstackIPs(nm)
+	impl.lb.ForTest().SetNetMap(nm)
+	if serveBackend != nil {
+		impl.lb.ForTest().SetServeConfig((&ipn.ServeConfig{TCP: map[uint16]*ipn.TCPPortHandler{
+			servePort: {TCPForward: serveBackend.String()},
+		}}).View())
+	}
+	impl.lb.ForTest().SetPeerAPIPorts(map[netip.Addr]int{guardSelf4: peerAPIPort, guardSelf6: peerAPIPort})
+	impl.lb.Dialer().SetSystemDialerForTest(new(net.Dialer).DialContext)
+	return impl
+}
+
+const servePort, peerAPIPort = 9443, 45678
+
+// A SYN from a peer: forwarded to localhost, or reset by the guard, and the
+// default path of everything that is not the node's own address untouched.
+func TestGuardLoopbackAcceptTCP(t *testing.T) {
+	tests := []struct {
+		name     string
+		remoteOn bool
+		open     uint16 // a TCP port opened to the tailnet
+		dst      netip.AddrPort
+		dialAddr string // where netstack's forwardTCP dials; "" for a RST
+	}{
+		{name: "socks5-is-reset", dst: netip.AddrPortFrom(guardSelf4, guardSOCKS5)},
+		{name: "socks5-ipv6-is-reset", dst: netip.AddrPortFrom(guardSelf6, guardSOCKS5)},
+		{name: "taildrive-proxy-is-reset", dst: netip.AddrPortFrom(guardSelf4, guardDrive)},
+		{name: "socks5-opened-is-forwarded", open: guardSOCKS5, dst: netip.AddrPortFrom(guardSelf4, guardSOCKS5), dialAddr: "127.0.0.1:48115"},
+		{name: "remote-on-is-forwarded", remoteOn: true, dst: netip.AddrPortFrom(guardSelf4, guardRemote), dialAddr: "127.0.0.1:28115"},
+		{name: "remote-on-ipv6-is-forwarded", remoteOn: true, dst: netip.AddrPortFrom(guardSelf6, guardRemote), dialAddr: "127.0.0.1:28115"},
+		{name: "remote-off-is-reset", dst: netip.AddrPortFrom(guardSelf4, guardRemote)},
+		// Upstream would have dialed 127.0.0.1:28115 for it.
+		{name: "another-nodes-address-is-reset", remoteOn: true, dst: netip.AddrPortFrom(guardOther, guardRemote)},
+		{name: "subnet-route-is-dialed", dst: netip.AddrPortFrom(guardSubnet, guardSOCKS5), dialAddr: "192.0.2.1:48115"},
+		{name: "exit-node-traffic-is-dialed", dst: netip.AddrPortFrom(guardWeb, 443), dialAddr: "203.0.113.5:443"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			a := new(guardAllow)
+			a.remote.Store(tt.remoteOn)
+			if tt.open != 0 {
+				a.openPort(ipproto.TCP, tt.open)
+			}
+			impl := guardedNetstack(t, a, nil)
+			dial, dialed := recordingDialer(t)
+			impl.forwardDialFunc = dial
+
+			before := metricLoopbackRefusedTCP.Value()
+			var syn []byte
+			if tt.dst.Addr().Is4() {
+				syn = tcp4syn(t, guardPeer, tt.dst.Addr(), 1234, tt.dst.Port())
+			} else {
+				syn = tcp6syn(t, tsaddr.Tailscale4To6(guardPeer), tt.dst.Addr(), 1234, tt.dst.Port())
+			}
+			var parsed packet.Parsed
+			parsed.Decode(syn)
+			if resp, _ := impl.injectInbound(&parsed, impl.tundev, nil); resp != filter.DropSilently {
+				t.Fatalf("inject: got %v, want filter.DropSilently (netstack's)", resp)
+			}
+			client := parsed.Src.Addr()
+
+			// acceptTCP has returned once the client has no connection in
+			// flight (TestAcceptTCPLoopbackForwardVsRST); a forward hangs in
+			// the recording dialer instead.
+			returned := make(chan struct{})
+			go func() {
+				for {
+					impl.mu.Lock()
+					n := impl.connsInFlightByClient[client]
+					impl.mu.Unlock()
+					if n == 0 {
+						close(returned)
+						return
+					}
+					time.Sleep(time.Millisecond)
+				}
+			}()
+			select {
+			case addr := <-dialed:
+				if tt.dialAddr == "" {
+					t.Fatalf("forwarded to %s; want a RST", addr)
+				}
+				if addr != tt.dialAddr {
+					t.Errorf("dialed %s, want %s", addr, tt.dialAddr)
+				}
+			case <-returned:
+				if tt.dialAddr != "" {
+					t.Fatalf("reset; want a dial to %s", tt.dialAddr)
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("timed out")
+			}
+
+			// Only the node's own Tailscale addresses are the guard's; refusing
+			// a subnet or exit-node flow would have counted here.
+			wantRefusals := int64(0)
+			if tt.dialAddr == "" {
+				wantRefusals = 1
+			}
+			if got := metricLoopbackRefusedTCP.Value() - before; got != wantRefusals {
+				t.Errorf("refusals counted: %d, want %d", got, wantRefusals)
+			}
+		})
+	}
+}
+
+// Serve, the peerAPI (Taildrop, Taildrive, peer DNS) and DNS on the service IP
+// are decided before the guard is asked, so closing loopback changes none of
+// them. A handshake needs a client, so this connects with netstack's own dial
+// to the node's address, which arrives at acceptTCP like a peer's SYN.
+func TestGuardLoopbackComesAfterServeAndPeerAPI(t *testing.T) {
+	serveBackend, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer serveBackend.Close()
+	backendGot := make(chan struct{}, 8)
+	go func() {
+		for {
+			c, err := serveBackend.Accept()
+			if err != nil {
+				return
+			}
+			c.Close()
+			backendGot <- struct{}{}
+		}
+	}()
+
+	a := new(guardAllow)
+	impl := guardedNetstack(t, a, serveBackend.Addr())
+	dial, dialed := recordingDialer(t)
+	impl.forwardDialFunc = dial
+	connect := func(dst netip.AddrPort) error {
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		c, err := impl.DialContextTCP(ctx, dst)
+		if err == nil {
+			c.Close()
+		}
+		return err
+	}
+
+	// The same road refuses what is closed, so a connection below is not luck.
+	before := metricLoopbackRefusedTCP.Value()
+	if err := connect(netip.AddrPortFrom(guardSelf4, guardSOCKS5)); err == nil {
+		t.Fatal("SOCKS5's port answered on the node's address")
+	}
+	if got := metricLoopbackRefusedTCP.Value() - before; got != 1 {
+		t.Fatalf("refusals counted: %d, want 1", got)
+	}
+	asked := a.asked.Load()
+
+	if err := connect(netip.AddrPortFrom(guardSelf4, servePort)); err != nil {
+		t.Errorf("Serve's port: %v", err)
+	}
+	select {
+	case <-backendGot:
+	case <-time.After(5 * time.Second):
+		t.Error("Serve's backend got no connection")
+	}
+	if err := connect(netip.AddrPortFrom(guardSelf4, peerAPIPort)); err != nil {
+		t.Errorf("the peerAPI's port: %v", err)
+	}
+	if err := connect(netip.AddrPortFrom(tsaddr.TailscaleServiceIP(), 53)); err != nil {
+		t.Errorf("DNS on the service IP: %v", err)
+	}
+	select {
+	case addr := <-dialed:
+		t.Errorf("netstack forwarded to %s", addr)
+	default:
+	}
+	if got := a.asked.Load() - asked; got != 0 {
+		t.Errorf("the allow list was asked %d times for flows decided before the guard", got)
+	}
+	if got := metricLoopbackRefusedTCP.Value() - before; got != 1 {
+		t.Errorf("refusals counted: %d, want only the SOCKS5 one", got)
+	}
+}
+
+// UDP from a peer to the node's own address: forwardUDP sends it to the same
+// port on 127.0.0.1 only when that port is open.
+func TestGuardLoopbackForwardUDP(t *testing.T) {
+	backend, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer backend.Close()
+	port := uint16(backend.LocalAddr().(*net.UDPAddr).Port)
+
+	for _, open := range []bool{false, true} {
+		name := map[bool]string{false: "closed-is-dropped", true: "opened-is-forwarded"}[open]
+		t.Run(name, func(t *testing.T) {
+			a := new(guardAllow)
+			if open {
+				a.openPort(ipproto.UDP, port)
+			}
+			impl := makeNetstack(t, func(impl *Impl) {
+				impl.ProcessLocalIPs = true
+				impl.ProcessSubnets = true
+				impl.GuardLoopback(a.allow)
+			})
+			impl.UpdateNetstackIPs(selfNetmap())
+
+			// forwardUDP binds the client's port on 127.0.0.1: take a free one.
+			sport := freeUDPPort(t)
+			before := metricLoopbackRefusedUDP.Value()
+			var parsed packet.Parsed
+			parsed.Decode(udp4datagram(t, guardPeer, guardSelf4, sport, port, []byte("query")))
+			if resp, _ := impl.injectInbound(&parsed, impl.tundev, nil); resp != filter.DropSilently {
+				t.Fatalf("inject: got %v, want filter.DropSilently (netstack's)", resp)
+			}
+
+			wait := 500 * time.Millisecond
+			if open {
+				wait = 5 * time.Second
+			}
+			backend.SetReadDeadline(time.Now().Add(wait))
+			buf := make([]byte, 64)
+			n, _, err := backend.ReadFromUDP(buf)
+			switch {
+			case open && err != nil:
+				t.Fatalf("nothing arrived on 127.0.0.1:%d: %v", port, err)
+			case open && string(buf[:n]) != "query":
+				t.Fatalf("got %q", buf[:n])
+			case !open && err == nil:
+				t.Fatalf("%q arrived on 127.0.0.1:%d though the port is closed", buf[:n], port)
+			}
+			if got, want := metricLoopbackRefusedUDP.Value()-before, map[bool]int64{false: 1, true: 0}[open]; got != want {
+				t.Errorf("refusals counted: %d, want %d", got, want)
+			}
+		})
+	}
+}
+
+// udp4datagram is udp4raw with a UDP checksum that covers the payload too, as
+// the receive path's checksum check wants it.
+func udp4datagram(tb testing.TB, src, dst netip.Addr, sport, dport uint16, payload []byte) []byte {
+	b := udp4raw(tb, src, dst, sport, dport, payload)
+	u := header.UDP(b[header.IPv4MinimumSize:])
+	u.SetChecksum(0)
+	xsum := header.PseudoHeaderChecksum(header.UDPProtocolNumber,
+		tcpip.AddrFrom4Slice(src.AsSlice()), tcpip.AddrFrom4Slice(dst.AsSlice()), uint16(len(u)))
+	xsum = checksum.Checksum(payload, xsum)
+	u.SetChecksum(^u.CalculateChecksum(xsum))
+	return b
+}
+
+func freeUDPPort(tb testing.TB) uint16 {
+	tb.Helper()
+	c, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		tb.Fatal(err)
+	}
+	defer c.Close()
+	return uint16(c.LocalAddr().(*net.UDPAddr).Port)
+}
