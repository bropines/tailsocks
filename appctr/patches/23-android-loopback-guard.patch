@@ -0,0 +1,114 @@
+//go:build !ts_omit_netstack
+
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"tailscale.com/types/ipproto"
+)
+
+func TestParseTailnetOpen(t *testing.T) {
+	ports, bad := parseTailnetOpen([]byte(`# written by the app
+tcp 48115
+
+udp 1053
+  tcp   8118
+tcp 48115
+http 80
+tcp
+tcp 0
+tcp 65536
+udp -1
+tcp 33445 open
+`))
+	want := []openPort{{ipproto.TCP, 8118}, {ipproto.TCP, 48115}, {ipproto.UDP, 1053}}
+	slices.SortFunc(want, compareOpenPorts)
+	if !slices.Equal(ports, want) {
+		t.Errorf("ports %v, want %v", ports, want)
+	}
+	wantBad := []string{"http 80", "tcp", "tcp 0", "tcp 65536", "udp -1", "tcp 33445 open"}
+	if !slices.Equal(bad, wantBad) {
+		t.Errorf("bad %q, want %q", bad, wantBad)
+	}
+}
+
+// expire makes the datapath's next question a fresh read of the list, as
+// tailnetOpenTTL passing would.
+func (a *loopbackAllow) expire() { a.readAt.Store(0) }
+
+func TestLoopbackAllow(t *testing.T) {
+	socket, flip := remoteSwitchFor(t)
+	list := filepath.Join(filepath.Dir(socket), tailnetOpenName)
+	write := func(s string) {
+		t.Helper()
+		if err := os.WriteFile(list, []byte(s), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	a := newLoopbackAllow(t.Logf, socket, newRemoteForwarder(t.Logf, socket, true))
+	asks := func(proto ipproto.Proto, port uint16, want bool) {
+		t.Helper()
+		if got := a.allow(proto, port); got != want {
+			t.Errorf("allow(%v, %d) = %v, want %v", proto, port, got, want)
+		}
+	}
+
+	// Nothing written, remote management off: nothing is open.
+	for _, port := range []uint16{48115, 8118, 1053, 33445, remoteManagementPort} {
+		asks(ipproto.TCP, port, false)
+		asks(ipproto.UDP, port, false)
+	}
+
+	// Remote management follows its switch, without a restart.
+	flip(true)
+	if !a.remote.forwarded() { // the bridge's question reads the switch afresh
+		t.Fatal("the switch is not on")
+	}
+	asks(ipproto.TCP, remoteManagementPort, true)
+	asks(ipproto.UDP, remoteManagementPort, false)
+	flip(false)
+	a.remote.forwarded()
+	asks(ipproto.TCP, remoteManagementPort, false)
+
+	// The person opens SOCKS5 and the DNS proxy.
+	a.expire()
+	asks(ipproto.TCP, 48115, false)
+	write("tcp 48115\nudp 1053\n")
+	// Within the TTL the datapath keeps its last read...
+	asks(ipproto.TCP, 48115, false)
+	// ...and reads again after it.
+	a.expire()
+	asks(ipproto.TCP, 48115, true)
+	asks(ipproto.UDP, 1053, true)
+	asks(ipproto.UDP, 48115, false)
+	asks(ipproto.TCP, 1053, false)
+	asks(ipproto.TCP, 8118, false)
+
+	// And closes them again: the file is gone.
+	if err := os.Remove(list); err != nil {
+		t.Fatal(err)
+	}
+	a.expire()
+	asks(ipproto.TCP, 48115, false)
+	asks(ipproto.UDP, 1053, false)
+
+	// A list that cannot be read opens nothing.
+	if err := os.Mkdir(list, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	a.expire()
+	asks(ipproto.TCP, 48115, false)
+}
+
+// Without a socket path there is no list and no switch to find: everything
+// stays closed.
+func TestLoopbackAllowWithoutASocket(t *testing.T) {
+	a := newLoopbackAllow(t.Logf, "", nil)
+	if a.allow(ipproto.TCP, remoteManagementPort) || a.allow(ipproto.TCP, 48115) || a.allow(ipproto.UDP, 1053) {
+		t.Error("something is open without a socket path")
+	}
+}
