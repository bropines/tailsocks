+//go:build !ts_omit_netstack
+
+package main
+
+// TailSocks: what of this device a peer reaches through the node's own
+// addresses.
+//
+// Upstream netstack hands every connection to the node's addresses that
+// nothing else took — not Serve, not the peerAPI, not quad-100 — to the same
+// port on 127.0.0.1. In userspace networking (proxy mode, the hev engine,
+// Root Mode without its interface) that serves every loopback listener of the
+// device to the tailnet. For other apps' servers that is what any Tailscale
+// node in userspace networking does, and what people use: adb over the
+// network, an SSH server, Syncthing. For the app's own listeners it is a hole:
+// its SOCKS5 and HTTP proxies ask no password unless one is set, its DNS
+// proxy resolves the tailnet's names, its Taildrive proxy opens the shares
+// this device may open under its identity, its Web UI and TailCat's forwards
+// are its own too.
+//
+// netstack.Impl.GuardLoopback refuses what the policy here does not allow.
+// The policy is the app's, a file beside the daemon's socket that
+// core/TailnetReach.kt keeps, one statement a line:
+//
+//	mode default            refuse only the ports listed as closed
+//	mode strict             refuse every port but those listed as open
+//	close tcp 48115         a port refused in default mode
+//	open udp 1234           a port allowed in strict mode
+//
+// Blank lines and lines starting with # are skipped; an open line means
+// nothing in default mode, nor a close line in strict mode. The app writes
+// "close" for each of its own listeners the person did not open to the
+// tailnet, so by default those are refused and everything else is forwarded
+// as upstream does; "strict" is the person's choice to close the rest too.
+//
+// No file, one that cannot be read, or one without a mode the daemon knows (a
+// race at start, an app from before the file): default mode with the app's
+// listeners at their default ports closed, failsafeClosed. Whatever the file
+// says, the remote-management port is its switch's: allowed while it is on,
+// refused while it is off or with no switch to look at — the switch and the
+// look at it are android_remote.go's, and that port is the bridge's own
+// listener.
+//
+// Both are followed without a restart.
+
+import (
+	"bufio"
+	"bytes"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"tailscale.com/types/ipproto"
+	"tailscale.com/types/logger"
+	"tailscale.com/wgengine/netstack"
+)
+
+const (
+	// tailnetReachName is the app's policy, beside the socket.
+	tailnetReachName = "tailnet-reach"
+
+	// tailnetReachTTL is how long the datapath trusts its last read of the
+	// policy, as remoteSwitchTTL does the switch.
+	tailnetReachTTL = time.Second
+)
+
+// failsafeClosed is what default mode closes when the app's policy cannot be
+// read: the app's own listeners at their default ports (GlobalSettings,
+// DriveProxy): SOCKS5, the HTTP proxy and the Web UI (both 8080), the DNS
+// proxy (UDP only), the Taildrive proxy. Sorted.
+var failsafeClosed = []reachPort{
+	{ipproto.TCP, 8080},
+	{ipproto.TCP, 33445},
+	{ipproto.TCP, 48115},
+	{ipproto.UDP, 1053},
+}
+
+// reachPort is a port of the node's addresses, in one protocol.
+type reachPort struct {
+	proto ipproto.Proto
+	port  uint16
+}
+
+func (p reachPort) String() string {
+	return strings.ToLower(p.proto.String()) + " " + strconv.Itoa(int(p.port))
+}
+
+func compareReachPorts(a, b reachPort) int {
+	if a.proto != b.proto {
+		return int(a.proto) - int(b.proto)
+	}
+	return int(a.port) - int(b.port)
+}
+
+// reachPolicy is the app's policy as read.
+type reachPolicy struct {
+	strict bool
+	open   []reachPort // sorted; what strict mode allows
+	closed []reachPort // sorted; what default mode refuses
+	// failsafe: the file was missing or unusable, and why.
+	failsafe string
+}
+
+// allows reports whether the policy lets a peer's flow to p through.
+func (p *reachPolicy) allows(rp reachPort) bool {
+	if p.strict {
+		_, found := slices.BinarySearchFunc(p.open, rp, compareReachPorts)
+		return found
+	}
+	_, found := slices.BinarySearchFunc(p.closed, rp, compareReachPorts)
+	return !found
+}
+
+func (p *reachPolicy) equal(q *reachPolicy) bool {
+	return p.strict == q.strict && p.failsafe == q.failsafe &&
+		slices.Equal(p.open, q.open) && slices.Equal(p.closed, q.closed)
+}
+
+func (p *reachPolicy) String() string {
+	switch {
+	case p.failsafe != "":
+		return fmt.Sprintf("%s; default mode, closed to the tailnet on this node's addresses: %v (the app's own listeners at their default ports)", p.failsafe, p.closed)
+	case p.strict && len(p.open) == 0:
+		return "strict mode; no local port is open to the tailnet beyond what the daemon serves"
+	case p.strict:
+		return fmt.Sprintf("strict mode; open to the tailnet on this node's addresses: %v", p.open)
+	case len(p.closed) == 0:
+		return "default mode; every local port is open to the tailnet"
+	default:
+		return fmt.Sprintf("default mode; closed to the tailnet on this node's addresses: %v", p.closed)
+	}
+}
+
+// loopbackAllow is the allow list of the loopback guard.
+type loopbackAllow struct {
+	logf   logger.Logf
+	file   string           // "" without a socket path: the fail-safe for good
+	remote *remoteForwarder // nil without a socket path
+
+	policy atomic.Pointer[reachPolicy] // nil before the first read
+	readAt atomic.Int64                // UnixNano of the last read; 0 before the first
+}
+
+// guardLoopback closes netstack's road to localhost down to the app's
+// policy. Called by newNetstack after forwardRemoteManagement, before Start.
+func guardLoopback(logf logger.Logf, ns *netstack.Impl) {
+	a := newLoopbackAllow(logf, args.socketpath, remoteForward.Load())
+	ns.GuardLoopback(a.allow)
+}
+
+func newLoopbackAllow(logf logger.Logf, socketPath string, remote *remoteForwarder) *loopbackAllow {
+	a := &loopbackAllow{logf: logf, remote: remote}
+	if socketPath != "" {
+		a.file = filepath.Join(filepath.Dir(socketPath), tailnetReachName)
+	}
+	return a
+}
+
+// allow is the guard's question: may a peer's flow to this port of the node
+// reach localhost?
+func (a *loopbackAllow) allow(proto ipproto.Proto, port uint16) bool {
+	if proto == ipproto.TCP && port == remoteManagementPort {
+		return a.remote != nil && a.remote.keeps(port)
+	}
+	return a.current().allows(reachPort{proto, port})
+}
+
+// current is the policy as of at most tailnetReachTTL ago.
+func (a *loopbackAllow) current() *reachPolicy {
+	if at := a.readAt.Load(); at != 0 && time.Now().UnixNano()-at < int64(tailnetReachTTL) {
+		if p := a.policy.Load(); p != nil {
+			return p
+		}
+	}
+	return a.read()
+}
+
+// read reads the policy and remembers it for the datapath; a change is
+// logged, so a fail-safe that lasts is logged once.
+func (a *loopbackAllow) read() *reachPolicy {
+	p := a.load()
+	a.readAt.Store(time.Now().UnixNano())
+	if old := a.policy.Swap(p); old == nil || !old.equal(p) {
+		a.logf("tailnet: %v", p)
+	}
+	return p
+}
+
+func (a *loopbackAllow) load() *reachPolicy {
+	if a.file == "" {
+		return failsafe("no socket path, no policy")
+	}
+	b, err := os.ReadFile(a.file)
+	switch {
+	case errors.Is(err, fs.ErrNotExist):
+		return failsafe(tailnetReachName + ": no such file")
+	case err != nil:
+		return failsafe(fmt.Sprintf("%s: %v", tailnetReachName, err))
+	}
+	p, bad, err := parseTailnetReach(b)
+	if len(bad) > 0 {
+		a.logf("tailnet: %s: ignored %q", tailnetReachName, bad)
+	}
+	if err != nil {
+		return failsafe(fmt.Sprintf("%s: %v", tailnetReachName, err))
+	}
+	return p
+}
+
+func failsafe(why string) *reachPolicy {
+	return &reachPolicy{closed: failsafeClosed, failsafe: why}
+}
+
+// parseTailnetReach reads the app's policy. A port line that is not one is
+// returned in bad and changes nothing; a policy with no mode line, a mode
+// the daemon does not know, or two modes is an error: what the app meant
+// cannot be told, and the caller takes the fail-safe.
+func parseTailnetReach(b []byte) (p *reachPolicy, bad []string, err error) {
+	p = new(reachPolicy)
+	modes := 0
+	sc := bufio.NewScanner(bytes.NewReader(b))
+	for sc.Scan() {
+		line := strings.TrimSpace(sc.Text())
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		f := strings.Fields(line)
+		switch {
+		case f[0] == "mode":
+			modes++
+			if len(f) != 2 || (f[1] != "default" && f[1] != "strict") {
+				return nil, bad, fmt.Errorf("mode %q is not default or strict", strings.Join(f[1:], " "))
+			}
+			p.strict = f[1] == "strict"
+		case (f[0] == "open" || f[0] == "close") && len(f) == 3:
+			rp, ok := parseReachPort(f[1], f[2])
+			if !ok {
+				bad = append(bad, line)
+			} else if f[0] == "open" {
+				p.open = append(p.open, rp)
+			} else {
+				p.closed = append(p.closed, rp)
+			}
+		default:
+			bad = append(bad, line)
+		}
+	}
+	switch {
+	case modes == 0:
+		return nil, bad, errors.New("no mode line")
+	case modes > 1:
+		return nil, bad, errors.New("more than one mode line")
+	}
+	for _, l := range []*[]reachPort{&p.open, &p.closed} {
+		slices.SortFunc(*l, compareReachPorts)
+		*l = slices.Compact(*l)
+	}
+	return p, bad, nil
+}
+
+// parseReachPort reads "tcp", "48115".
+func parseReachPort(proto, port string) (rp reachPort, ok bool) {
+	switch proto {
+	case "tcp":
+		rp.proto = ipproto.TCP
+	case "udp":
+		rp.proto = ipproto.UDP
+	default:
+		return rp, false
+	}
+	n, err := strconv.ParseUint(port, 10, 16)
+	if err != nil || n == 0 {
+		return rp, false
+	}
+	rp.port = uint16(n)
+	return rp, true
+}
