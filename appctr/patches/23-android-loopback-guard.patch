+//go:build !ts_omit_netstack
+
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"tailscale.com/types/ipproto"
+)
+
+func TestParseTailnetReach(t *testing.T) {
+	p, bad, err := parseTailnetReach([]byte(`# written by the app
+mode default
+
+close tcp 48115
+  close   udp   1053
+close tcp 48115
+open tcp 5555
+close http 80
+close tcp
+close tcp 0
+close tcp 65536
+close udp -1
+close tcp 33445 now
+tcp 8080
+`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if p.strict {
+		t.Error("strict; the file says default")
+	}
+	wantClosed := []reachPort{{ipproto.TCP, 48115}, {ipproto.UDP, 1053}}
+	slices.SortFunc(wantClosed, compareReachPorts)
+	if !slices.Equal(p.closed, wantClosed) {
+		t.Errorf("closed %v, want %v", p.closed, wantClosed)
+	}
+	if want := []reachPort{{ipproto.TCP, 5555}}; !slices.Equal(p.open, want) {
+		t.Errorf("open %v, want %v", p.open, want)
+	}
+	wantBad := []string{"close http 80", "close tcp", "close tcp 0", "close tcp 65536", "close udp -1", "close tcp 33445 now", "tcp 8080"}
+	if !slices.Equal(bad, wantBad) {
+		t.Errorf("bad %q, want %q", bad, wantBad)
+	}
+
+	p, _, err = parseTailnetReach([]byte("mode strict\nopen tcp 8022\nopen udp 1234\nopen tcp 5555\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []reachPort{{ipproto.TCP, 5555}, {ipproto.TCP, 8022}, {ipproto.UDP, 1234}}
+	slices.SortFunc(want, compareReachPorts)
+	if !p.strict || !slices.Equal(p.open, want) {
+		t.Errorf("got strict=%v open=%v, want strict, %v", p.strict, p.open, want)
+	}
+}
+
+// A policy whose mode cannot be told is no policy: the caller takes the
+// fail-safe rather than guess.
+func TestParseTailnetReachWithoutAMode(t *testing.T) {
+	for name, text := range map[string]string{
+		"empty":         "",
+		"comments only": "# nothing\n\n",
+		"no mode":       "close tcp 48115\n",
+		"unknown mode":  "mode paranoid\nclose tcp 48115\n",
+		"bare mode":     "mode\n",
+		"two words":     "mode strict default\n",
+		"two modes":     "mode strict\nopen tcp 5555\nmode default\n",
+		"old format":    "tcp 48115\nudp 1053\n", // the list of 5.1's first builds
+	} {
+		if p, _, err := parseTailnetReach([]byte(text)); err == nil {
+			t.Errorf("%s: parsed as %v; want an error", name, p)
+		}
+	}
+}
+
+func TestReachPolicyAllows(t *testing.T) {
+	def, _, err := parseTailnetReach([]byte("mode default\nclose tcp 48115\nclose udp 1053\nopen tcp 9999\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	strict, _, err := parseTailnetReach([]byte("mode strict\nopen tcp 5555\nopen udp 1234\nclose tcp 8022\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	tests := []struct {
+		name   string
+		policy *reachPolicy
+		port   reachPort
+		want   bool
+	}{
+		{"default: the app's SOCKS5", def, reachPort{ipproto.TCP, 48115}, false},
+		{"default: the app's DNS proxy", def, reachPort{ipproto.UDP, 1053}, false},
+		{"default: the DNS proxy's number in TCP", def, reachPort{ipproto.TCP, 1053}, true},
+		{"default: adb", def, reachPort{ipproto.TCP, 5555}, true},
+		{"default: sshd", def, reachPort{ipproto.TCP, 8022}, true},
+		{"default: an open line changes nothing", def, reachPort{ipproto.TCP, 9999}, true},
+		{"strict: an opened port", strict, reachPort{ipproto.TCP, 5555}, true},
+		{"strict: an opened UDP port", strict, reachPort{ipproto.UDP, 1234}, true},
+		{"strict: the same number in the other protocol", strict, reachPort{ipproto.UDP, 5555}, false},
+		{"strict: anything else", strict, reachPort{ipproto.TCP, 22}, false},
+		{"strict: a close line opens nothing", strict, reachPort{ipproto.TCP, 8022}, false},
+		{"strict: the app's SOCKS5", strict, reachPort{ipproto.TCP, 48115}, false},
+		{"fail-safe: the app's SOCKS5", failsafe("test"), reachPort{ipproto.TCP, 48115}, false},
+		{"fail-safe: the HTTP proxy and the Web UI", failsafe("test"), reachPort{ipproto.TCP, 8080}, false},
+		{"fail-safe: the Taildrive proxy", failsafe("test"), reachPort{ipproto.TCP, 33445}, false},
+		{"fail-safe: the DNS proxy", failsafe("test"), reachPort{ipproto.UDP, 1053}, false},
+		{"fail-safe: adb", failsafe("test"), reachPort{ipproto.TCP, 5555}, true},
+	}
+	for _, tt := range tests {
+		if got := tt.policy.allows(tt.port); got != tt.want {
+			t.Errorf("%s: allows(%v) = %v, want %v", tt.name, tt.port, got, tt.want)
+		}
+	}
+	if !slices.IsSortedFunc(failsafeClosed, compareReachPorts) {
+		t.Error("failsafeClosed is not sorted; the binary search misses")
+	}
+}
+
+// expire makes the datapath's next question a fresh read of the policy, as
+// tailnetReachTTL passing would.
+func (a *loopbackAllow) expire() { a.readAt.Store(0) }
+
+// reachFor returns an allow list for an app's files/ directory in a
+// temporary place, the switch of remote management, and a func that writes
+// the policy ("" removes it).
+func reachFor(t *testing.T) (a *loopbackAllow, flip func(on bool), write func(string)) {
+	t.Helper()
+	socket, flip := remoteSwitchFor(t)
+	file := filepath.Join(filepath.Dir(socket), tailnetReachName)
+	a = newLoopbackAllow(t.Logf, socket, newRemoteForwarder(t.Logf, socket, true))
+	return a, flip, func(s string) {
+		t.Helper()
+		if s == "" {
+			if err := os.Remove(file); err != nil && !os.IsNotExist(err) {
+				t.Fatal(err)
+			}
+			return
+		}
+		if err := os.WriteFile(file, []byte(s), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func asks(t *testing.T, a *loopbackAllow, proto ipproto.Proto, port uint16, want bool) {
+	t.Helper()
+	if got := a.allow(proto, port); got != want {
+		t.Errorf("allow(%v, %d) = %v, want %v", proto, port, got, want)
+	}
+}
+
+func TestLoopbackAllowDefaultMode(t *testing.T) {
+	a, _, write := reachFor(t)
+	// The app's SOCKS5 on a port of its choosing, and its DNS proxy.
+	write("mode default\nclose tcp 1080\nclose udp 1053\n")
+	asks(t, a, ipproto.TCP, 1080, false)
+	asks(t, a, ipproto.UDP, 1053, false)
+	// Other apps' services, as upstream serves them.
+	asks(t, a, ipproto.TCP, 5555, true)
+	asks(t, a, ipproto.TCP, 8022, true)
+	asks(t, a, ipproto.UDP, 21027, true)
+	// The default ports are the fail-safe's, not the policy's: SOCKS5 moved.
+	asks(t, a, ipproto.TCP, 48115, true)
+
+	// The person opens SOCKS5 to the tailnet: its close line goes.
+	write("mode default\nclose udp 1053\n")
+	// Within the TTL the datapath keeps its last read...
+	asks(t, a, ipproto.TCP, 1080, false)
+	// ...and reads again after it.
+	a.expire()
+	asks(t, a, ipproto.TCP, 1080, true)
+	asks(t, a, ipproto.UDP, 1053, false)
+}
+
+func TestLoopbackAllowStrictMode(t *testing.T) {
+	a, _, write := reachFor(t)
+	write("mode strict\nopen tcp 48115\n")
+	asks(t, a, ipproto.TCP, 48115, true)
+	asks(t, a, ipproto.UDP, 1053, false)
+	asks(t, a, ipproto.TCP, 5555, false)
+	asks(t, a, ipproto.TCP, 8022, false)
+
+	// adb added to the ports left open, without a restart.
+	write("mode strict\nopen tcp 48115\nopen tcp 5555\n")
+	a.expire()
+	asks(t, a, ipproto.TCP, 5555, true)
+	asks(t, a, ipproto.UDP, 5555, false)
+	asks(t, a, ipproto.TCP, 8022, false)
+
+	// Back to default: everything but what is closed.
+	write("mode default\nclose udp 1053\n")
+	a.expire()
+	asks(t, a, ipproto.TCP, 8022, true)
+	asks(t, a, ipproto.UDP, 1053, false)
+}
+
+// No policy, an unreadable one, one whose mode cannot be told: the app's own
+// listeners at their default ports are closed and the rest is served, as in
+// default mode.
+func TestLoopbackAllowFailsafe(t *testing.T) {
+	a, _, write := reachFor(t)
+	failsafeHolds := func(why string) {
+		t.Helper()
+		a.expire()
+		for _, p := range failsafeClosed {
+			if a.allow(p.proto, p.port) {
+				t.Errorf("%s: %v is open", why, p)
+			}
+		}
+		asks(t, a, ipproto.TCP, 5555, true)
+		asks(t, a, ipproto.TCP, 8022, true)
+		if p := a.policy.Load(); p == nil || p.failsafe == "" {
+			t.Errorf("%s: not the fail-safe: %v", why, p)
+		}
+	}
+
+	failsafeHolds("no file")
+	write("mode strict\n")
+	a.expire()
+	asks(t, a, ipproto.TCP, 5555, false)
+
+	write("tcp 48115\n")
+	failsafeHolds("the old list")
+	write("mode lax\n")
+	failsafeHolds("an unknown mode")
+	write("")
+	if err := os.Mkdir(a.file, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	failsafeHolds("a directory")
+}
+
+// The fail-safe is logged when it begins, not at every read.
+func TestLoopbackAllowLogsChanges(t *testing.T) {
+	socket, _ := remoteSwitchFor(t)
+	var logged []string
+	a := newLoopbackAllow(func(format string, args ...any) {
+		logged = append(logged, strings.TrimSpace(format))
+	}, socket, nil)
+	for range 3 {
+		a.expire()
+		a.allow(ipproto.TCP, 48115)
+	}
+	if len(logged) != 1 {
+		t.Errorf("logged %d times, want once: %q", len(logged), logged)
+	}
+}
+
+// Remote management's port is its switch's, in every mode and in the
+// fail-safe: the policy neither opens nor closes it.
+func TestLoopbackAllowRemoteManagement(t *testing.T) {
+	a, flip, write := reachFor(t)
+	for _, policy := range []string{
+		"",               // the fail-safe
+		"mode default\n", // nothing closed
+		"mode strict\n",  // nothing open
+		"mode strict\nopen tcp 28115\n",
+		"mode default\nclose tcp 28115\n",
+	} {
+		write(policy)
+		a.expire()
+		flip(false)
+		a.remote.forwarded() // the bridge's question reads the switch afresh
+		asks(t, a, ipproto.TCP, remoteManagementPort, false)
+		flip(true)
+		a.remote.forwarded()
+		asks(t, a, ipproto.TCP, remoteManagementPort, true)
+		// The same number in UDP is the policy's.
+		asks(t, a, ipproto.UDP, remoteManagementPort, !strings.HasPrefix(policy, "mode strict"))
+	}
+}
+
+// Without a socket path there is no policy and no switch to find: the
+// fail-safe holds, and remote management's port is closed.
+func TestLoopbackAllowWithoutASocket(t *testing.T) {
+	a := newLoopbackAllow(t.Logf, "", nil)
+	for _, p := range failsafeClosed {
+		if a.allow(p.proto, p.port) {
+			t.Errorf("%v is open without a socket path", p)
+		}
+	}
+	if a.allow(ipproto.TCP, remoteManagementPort) {
+		t.Error("remote management's port is open with no switch to look at")
+	}
+	if !a.allow(ipproto.TCP, 5555) {
+		t.Error("another app's port is closed without a socket path")
+	}
+}
