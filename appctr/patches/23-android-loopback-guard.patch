+//go:build !ts_omit_netstack
+
+package main
+
+// TailSocks: what of this device a peer reaches through the node's own
+// addresses.
+//
+// Upstream netstack hands every connection to the node's addresses that
+// nothing else took — not Serve, not the peerAPI, not quad-100 — to the same
+// port on 127.0.0.1. In userspace networking (proxy mode, the hev engine,
+// Root Mode without its interface) that opened every loopback listener of the
+// device to the tailnet: the app's SOCKS5 and HTTP proxies, which ask no
+// password unless one is set, its DNS proxy, its Taildrive proxy (the shares
+// this device may open, read under its identity), other apps' local servers.
+// netstack.Impl.GuardLoopback closes that down to an allow list, built here
+// from what the app says:
+//
+//   - the remote-management port, while its switch is on — the switch and the
+//     look at it are android_remote.go's;
+//   - the ports the person opened to the tailnet (Settings → Local proxies →
+//     Reachable from the tailnet), one "tcp <port>" or "udp <port>" per line
+//     in tailnet-open beside the daemon's socket, which the app keeps
+//     (core/TailnetReach.kt). No file: nothing is open.
+//
+// Both are followed without a restart. Everything else to the node's own
+// addresses is refused, whatever listens on 127.0.0.1.
+
+import (
+	"bufio"
+	"bytes"
+	"errors"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"tailscale.com/types/ipproto"
+	"tailscale.com/types/logger"
+	"tailscale.com/wgengine/netstack"
+)
+
+const (
+	// tailnetOpenName is the app's list of opened ports, beside the socket.
+	tailnetOpenName = "tailnet-open"
+
+	// tailnetOpenTTL is how long the datapath trusts its last read of the
+	// list, as remoteSwitchTTL does the switch.
+	tailnetOpenTTL = time.Second
+)
+
+// openPort is a port of the node's addresses, in one protocol.
+type openPort struct {
+	proto ipproto.Proto
+	port  uint16
+}
+
+func (p openPort) String() string {
+	return strings.ToLower(p.proto.String()) + " " + strconv.Itoa(int(p.port))
+}
+
+// loopbackAllow is the allow list of the loopback guard.
+type loopbackAllow struct {
+	logf   logger.Logf
+	file   string           // "" without a socket path: nothing is ever open
+	remote *remoteForwarder // nil without a socket path
+
+	open   atomic.Pointer[[]openPort] // sorted; nil before the first read
+	readAt atomic.Int64               // UnixNano of the last read; 0 before the first
+}
+
+// guardLoopback closes netstack's road to localhost down to the allow list.
+// Called by newNetstack after forwardRemoteManagement, before Start.
+func guardLoopback(logf logger.Logf, ns *netstack.Impl) {
+	a := newLoopbackAllow(logf, args.socketpath, remoteForward.Load())
+	ns.GuardLoopback(a.allow)
+}
+
+func newLoopbackAllow(logf logger.Logf, socketPath string, remote *remoteForwarder) *loopbackAllow {
+	a := &loopbackAllow{logf: logf, remote: remote}
+	if socketPath != "" {
+		a.file = filepath.Join(filepath.Dir(socketPath), tailnetOpenName)
+	}
+	return a
+}
+
+// allow is the guard's question: may a peer's flow to this port of the node
+// reach localhost?
+func (a *loopbackAllow) allow(proto ipproto.Proto, port uint16) bool {
+	if proto == ipproto.TCP && port == remoteManagementPort && a.remote != nil && a.remote.keeps(port) {
+		return true
+	}
+	_, found := slices.BinarySearchFunc(a.ports(), openPort{proto, port}, compareOpenPorts)
+	return found
+}
+
+// ports is the list as of at most tailnetOpenTTL ago.
+func (a *loopbackAllow) ports() []openPort {
+	if at := a.readAt.Load(); at != 0 && time.Now().UnixNano()-at < int64(tailnetOpenTTL) {
+		if p := a.open.Load(); p != nil {
+			return *p
+		}
+	}
+	return a.read()
+}
+
+// read reads the list and remembers it for the datapath.
+func (a *loopbackAllow) read() []openPort {
+	var ports []openPort
+	if a.file != "" {
+		b, err := os.ReadFile(a.file)
+		switch {
+		case err == nil:
+			var bad []string
+			ports, bad = parseTailnetOpen(b)
+			if len(bad) > 0 {
+				a.logf("tailnet: %s: ignored %q", tailnetOpenName, bad)
+			}
+		case errors.Is(err, fs.ErrNotExist):
+		default:
+			// Unreadable is closed: nothing is opened on a guess.
+			a.logf("tailnet: %s: %v; nothing is open", tailnetOpenName, err)
+		}
+	}
+	a.readAt.Store(time.Now().UnixNano())
+	if old := a.open.Swap(&ports); old == nil || !slices.Equal(*old, ports) {
+		if len(ports) == 0 {
+			a.logf("tailnet: no local port is open to the tailnet beyond what the daemon serves")
+		} else {
+			a.logf("tailnet: open to the tailnet on this node's addresses: %v", ports)
+		}
+	}
+	return ports
+}
+
+// parseTailnetOpen reads the app's list: "tcp 48115", "udp 1053", one a
+// line; blank lines and lines starting with # are skipped. What is not such a
+// line is returned in bad and opens nothing.
+func parseTailnetOpen(b []byte) (ports []openPort, bad []string) {
+	sc := bufio.NewScanner(bytes.NewReader(b))
+	for sc.Scan() {
+		line := strings.TrimSpace(sc.Text())
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		f := strings.Fields(line)
+		var p openPort
+		ok := len(f) == 2
+		if ok {
+			switch f[0] {
+			case "tcp":
+				p.proto = ipproto.TCP
+			case "udp":
+				p.proto = ipproto.UDP
+			default:
+				ok = false
+			}
+		}
+		if ok {
+			n, err := strconv.ParseUint(f[1], 10, 16)
+			ok = err == nil && n > 0
+			p.port = uint16(n)
+		}
+		if !ok {
+			bad = append(bad, line)
+			continue
+		}
+		ports = append(ports, p)
+	}
+	slices.SortFunc(ports, compareOpenPorts)
+	return slices.Compact(ports), bad
+}
+
+func compareOpenPorts(a, b openPort) int {
+	if a.proto != b.proto {
+		return int(a.proto) - int(b.proto)
+	}
+	return int(a.port) - int(b.port)
+}
