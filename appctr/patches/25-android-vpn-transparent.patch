@@ -0,0 +1,49 @@
+//go:build !ts_omit_netstack
+
+package main
+
+// TailSocks native TUN: transparent mode (wgengine/netstack/local_egress.go).
+//
+// Android's lockdown ("Block connections without VPN") refuses every
+// connection that is not routed into the VPN; without an exit node that is
+// the whole internet. In transparent mode the app routes everything into the
+// VPN and netstack ends the host's connections outside the tailnet, dialling
+// them from this process, which the VPN leaves out. The app decides it — on
+// only while the lockdown is on, no exit node is selected and the person left
+// the option on — and says so with every device it hands over: at launch in
+// TS_ANDROID_VPN_EGRESS, and in each device swap (android_vpn_swap.go), set
+// before the engine moves so the new device's routes and the mode change
+// together.
+
+import (
+	"sync/atomic"
+
+	"tailscale.com/envknob"
+	"tailscale.com/types/logger"
+	"tailscale.com/wgengine/netstack"
+)
+
+// androidVPNNetstack is the netstack of a daemon on Android's VPN, for the
+// swaps that follow.
+var androidVPNNetstack atomic.Pointer[netstack.Impl]
+
+// attachAndroidVPNEgress takes ns for transparent mode and applies the
+// launch's setting. Called by newNetstack; nothing outside androidVPNMode.
+func attachAndroidVPNEgress(logf logger.Logf, ns *netstack.Impl) {
+	if !androidVPNMode {
+		return
+	}
+	androidVPNNetstack.Store(ns)
+	ns.SetLocalEgress(envknob.Bool("TS_ANDROID_VPN_EGRESS"))
+}
+
+// setAndroidVPNEgress switches transparent mode for the device about to be
+// swapped in. False when no netstack is attached.
+func setAndroidVPNEgress(on bool) bool {
+	ns := androidVPNNetstack.Load()
+	if ns == nil {
+		return false
+	}
+	ns.SetLocalEgress(on)
+	return true
+}
