+package netstack
+
+// TailSocks: transparent mode for Android's VPN.
+//
+// On TailSocks's native TUN engine the phone's VPN carries the tailnet
+// ranges and, behind an exit node, everything else. Android's lockdown
+// ("Block connections without VPN") then refuses every connection that is
+// not routed into the VPN — without an exit node, the whole internet. In
+// transparent mode the app routes everything into the VPN anyway, and the
+// connections the host opens to addresses outside the tailnet are ended here
+// and dialled again from this process, which the VPN leaves out: the same
+// forwarding a userspace subnet router does for its peers (acceptTCP,
+// forwardUDP), here for the phone's own apps. TCP and UDP only — ICMP to the
+// internet is not carried.
+//
+// The app switches it with the device it hands over: on only while Android's
+// lockdown is on, no exit node is selected and the person left the option on
+// (cmd/tailscaled/android_vpn_swap.go).
+
+import (
+	"net/netip"
+
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"tailscale.com/net/packet"
+	"tailscale.com/net/tsaddr"
+	"tailscale.com/types/ipproto"
+)
+
+// SetLocalEgress turns transparent mode on or off.
+func (ns *Impl) SetLocalEgress(on bool) {
+	if ns.localEgress.Swap(on) != on {
+		if on {
+			ns.logf("netstack: transparent mode on: the host's connections outside the tailnet are dialled from here")
+		} else {
+			ns.logf("netstack: transparent mode off")
+		}
+	}
+}
+
+// LocalEgress reports whether transparent mode is on.
+func (ns *Impl) LocalEgress() bool {
+	return ns.localEgress.Load()
+}
+
+// isLocalEgress reports whether p, sent by the host, is transparent mode's to
+// end here: TCP or UDP to a unicast address outside the tailnet, the 4via6
+// range and this node's own addresses, that no peer routes. The service IP,
+// the tailnet, accepted subnet routes and a selected exit node keep their
+// paths — the last also covers the moment between an exit node being chosen
+// and the app switching this mode off with the new device.
+func (ns *Impl) isLocalEgress(p *packet.Parsed) bool {
+	if !ns.localEgress.Load() {
+		return false
+	}
+	if p.IPProto != ipproto.TCP && p.IPProto != ipproto.UDP {
+		return false
+	}
+	dst := p.Dst.Addr().Unmap()
+	if !dst.IsGlobalUnicast() || tsaddr.IsTailscaleIP(dst) || viaRange.Contains(dst) || ns.isLocalIP(dst) {
+		return false
+	}
+	// The node's outbound routes, lock-free unless a peer matches.
+	if ns.lb != nil {
+		if _, routed := ns.lb.PeerForIP(dst); routed {
+			return false
+		}
+	}
+	return true
+}
+
+// isLocalEgressReply reports whether pkt, leaving netstack, answers one of
+// transparent mode's flows: from an address outside the tailnet to one of this
+// node's own, which is where the host's connection came from. It goes back to
+// the host — not out to WireGuard, which would only hand it back to netstack.
+// No other flow of netstack's answers the node itself from outside the tailnet.
+func (ns *Impl) isLocalEgressReply(pkt *stack.PacketBuffer) bool {
+	if !ns.localEgress.Load() {
+		return false
+	}
+	var src, dst netip.Addr
+	switch v := pkt.Network().(type) {
+	case header.IPv4:
+		src = netip.AddrFrom4(v.SourceAddress().As4())
+		dst = netip.AddrFrom4(v.DestinationAddress().As4())
+	case header.IPv6:
+		src = netip.AddrFrom16(v.SourceAddress().As16())
+		dst = netip.AddrFrom16(v.DestinationAddress().As16())
+	default:
+		return false
+	}
+	if tsaddr.IsTailscaleIP(src) || viaRange.Contains(src) {
+		return false
+	}
+	return ns.isLocalIP(dst)
+}
