+package netstack
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"testing"
+	"time"
+
+	"tailscale.com/net/packet"
+	"tailscale.com/tailcfg"
+	"tailscale.com/types/ipproto"
+	"tailscale.com/types/key"
+	"tailscale.com/types/netmap"
+	"tailscale.com/wgengine/filter"
+)
+
+// TailSocks's transparent mode: which of the host's packets it ends here.
+func TestLocalEgressDecides(t *testing.T) {
+	self4 := netip.MustParseAddr("100.64.1.2")
+	self6 := netip.MustParseAddr("fd7a:115c:a1e0::123")
+	impl := makeNetstack(t, func(impl *Impl) {
+		// The shape of tailscaled on Android's VPN (cmd/tailscaled/netstack.go).
+		impl.ProcessSubnets = false
+		impl.ProcessLocalIPs = false
+		impl.atomicIsLocalIPFunc.Store(func(a netip.Addr) bool { return a == self4 || a == self6 })
+	})
+
+	tests := []struct {
+		name  string
+		proto ipproto.Proto
+		dst   string
+		want  bool // ended here with transparent mode on
+	}{
+		{"internet-tcp", ipproto.TCP, "203.0.113.7:443", true},
+		{"internet-udp", ipproto.UDP, "198.51.100.9:443", true},
+		{"internet-v6", ipproto.TCP, "[2001:db8::7]:443", true},
+		{"lan", ipproto.TCP, "192.168.1.1:80", true},
+		{"lan-dns", ipproto.UDP, "192.168.1.1:53", true},
+		{"tailnet-peer", ipproto.TCP, "100.101.102.103:22", false},
+		{"tailnet-peer-v6", ipproto.TCP, "[fd7a:115c:a1e0::99]:22", false},
+		{"service-ip", ipproto.UDP, "100.100.100.100:53", false},
+		{"self", ipproto.TCP, "100.64.1.2:8080", false},
+		{"multicast", ipproto.UDP, "224.0.0.251:5353", false},
+		{"link-local", ipproto.UDP, "169.254.1.1:67", false},
+		{"broadcast", ipproto.UDP, "255.255.255.255:67", false},
+		{"icmp", ipproto.ICMPv4, "203.0.113.7:0", false},
+	}
+	for _, on := range []bool{false, true} {
+		impl.SetLocalEgress(on)
+		for _, tt := range tests {
+			p := &packet.Parsed{
+				IPVersion: 4,
+				IPProto:   tt.proto,
+				Src:       netip.AddrPortFrom(self4, 40000),
+				Dst:       netip.MustParseAddrPort(tt.dst),
+			}
+			if p.Dst.Addr().Is6() {
+				p.IPVersion = 6
+				p.Src = netip.AddrPortFrom(self6, 40000)
+			}
+			if got := impl.isLocalEgress(p); got != (on && tt.want) {
+				t.Errorf("transparent %v, %s: isLocalEgress = %v, want %v", on, tt.name, got, on && tt.want)
+			}
+		}
+	}
+}
+
+// With transparent mode on, a connection the host opens to the internet is
+// accepted by netstack and dialled from this process to the same address.
+func TestLocalEgressDialsTheDestination(t *testing.T) {
+	self4 := netip.MustParseAddr("100.64.1.2")
+	impl := makeNetstack(t, func(impl *Impl) {
+		impl.ProcessSubnets = false
+		impl.ProcessLocalIPs = false
+		impl.atomicIsLocalIPFunc.Store(func(a netip.Addr) bool { return a == self4 })
+	})
+	dialed := make(chan string, 1)
+	done := make(chan struct{})
+	t.Cleanup(func() { close(done) })
+	impl.forwardDialFunc = func(ctx context.Context, network, address string) (net.Conn, error) {
+		select {
+		case dialed <- network + " " + address:
+		default:
+		}
+		select {
+		case <-ctx.Done():
+		case <-done:
+		}
+		return nil, context.Canceled
+	}
+
+	dst := netip.MustParseAddr("203.0.113.7")
+	syn := func() *packet.Parsed {
+		var p packet.Parsed
+		p.Decode(tcp4syn(t, self4, dst, 40001, 443))
+		return &p
+	}
+
+	// Off: the packet goes on its way, to WireGuard, as before.
+	if resp, _ := impl.handleLocalPackets(syn(), impl.tundev, nil); resp != filter.Accept {
+		t.Fatalf("transparent off: got %v, want filter.Accept", resp)
+	}
+
+	impl.SetLocalEgress(true)
+	if resp, _ := impl.handleLocalPackets(syn(), impl.tundev, nil); resp != filter.DropSilently {
+		t.Fatalf("transparent on: got %v, want filter.DropSilently", resp)
+	}
+	select {
+	case got := <-dialed:
+		if want := "tcp 203.0.113.7:443"; got != want {
+			t.Fatalf("dialled %q, want %q", got, want)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("netstack never dialled the destination")
+	}
+}
+
+// A destination a peer routes — an accepted subnet route, a selected exit
+// node — stays WireGuard's even with transparent mode on.
+func TestLocalEgressLeavesPeerRoutes(t *testing.T) {
+	self4 := netip.MustParseAddr("100.64.1.2")
+	impl := makeNetstack(t, func(impl *Impl) {
+		impl.ProcessSubnets = false
+		impl.ProcessLocalIPs = false
+		impl.atomicIsLocalIPFunc.Store(func(a netip.Addr) bool { return a == self4 })
+	})
+	subnet := netip.MustParsePrefix("10.20.0.0/16")
+	peer := (&tailcfg.Node{
+		ID:            2,
+		StableID:      "router",
+		Key:           key.NewNode().Public(),
+		Addresses:     []netip.Prefix{netip.MustParsePrefix("100.101.102.103/32")},
+		AllowedIPs:    []netip.Prefix{netip.MustParsePrefix("100.101.102.103/32"), subnet},
+		PrimaryRoutes: []netip.Prefix{subnet},
+		HomeDERP:      1, // reachable; the route manager skips peers it cannot talk to
+	}).View()
+	impl.lb.ForTest().SetNetMap(&netmap.NetworkMap{
+		SelfNode: (&tailcfg.Node{ID: 1, Addresses: []netip.Prefix{netip.PrefixFrom(self4, 32)}}).View(),
+		Peers:    []tailcfg.NodeView{peer},
+	})
+	impl.lb.ForTest().SetRouteAll(true)
+	if _, ok := impl.lb.PeerForIP(netip.MustParseAddr("10.20.1.1")); !ok {
+		t.Fatal("the backend does not route the peer's subnet")
+	}
+	impl.SetLocalEgress(true)
+	pkt := func(dst string) *packet.Parsed {
+		return &packet.Parsed{IPVersion: 4, IPProto: ipproto.TCP, Src: netip.AddrPortFrom(self4, 40000), Dst: netip.MustParseAddrPort(dst)}
+	}
+	if impl.isLocalEgress(pkt("10.20.1.1:22")) {
+		t.Error("an accepted subnet route was taken for the internet")
+	}
+	if !impl.isLocalEgress(pkt("203.0.113.7:443")) {
+		t.Error("the internet was left to WireGuard")
+	}
+}
+
+// The answers of transparent mode's flows go back to the host; nothing else
+// of netstack's changes its way.
+func TestLocalEgressRepliesGoToTheHost(t *testing.T) {
+	self4 := netip.MustParseAddr("100.64.1.2")
+	impl := makeNetstack(t, func(impl *Impl) {
+		impl.ProcessSubnets = false
+		impl.ProcessLocalIPs = false
+		impl.atomicIsLocalIPFunc.Store(func(a netip.Addr) bool { return a == self4 })
+	})
+	reply := func(src, dst string) bool {
+		pkt := makeUDP4PacketBuffer(netip.MustParseAddrPort(src), netip.MustParseAddrPort(dst))
+		defer pkt.DecRef()
+		return impl.shouldSendToHost(pkt)
+	}
+	if reply("203.0.113.7:443", "100.64.1.2:40001") {
+		t.Fatal("transparent off: a reply from the internet was sent to the host")
+	}
+	impl.SetLocalEgress(true)
+	if !reply("203.0.113.7:443", "100.64.1.2:40001") {
+		t.Error("transparent on: the internet's reply to the host went out instead")
+	}
+	if reply("100.101.102.103:22", "100.64.1.2:40001") {
+		t.Error("a peer's packet to this node was sent to the host")
+	}
+	if reply("203.0.113.7:443", "100.101.102.103:40001") {
+		t.Error("a packet to another node was sent to the host")
+	}
+	if !reply("100.100.100.100:53", "100.64.1.2:40001") {
+		t.Error("MagicDNS's answer no longer goes to the host")
+	}
+}
