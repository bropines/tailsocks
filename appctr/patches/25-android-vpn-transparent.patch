+package ipnlocal
+
+// TailSocks: test-only access for wgengine/netstack's tests of transparent
+// mode (local_egress.go).
+
+// SetRouteAll stands in for the "accept routes" pref reaching the route
+// manager, which in the daemon follows a prefs change: the netmap's subnet
+// routes then route to their peers (PeerForIP).
+func (f forTest) SetRouteAll(on bool) {
+	f.b.currentNode().updateRouteManagerPrefs(routePrefs{RouteAll: on})
+}
