+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build !ts_omit_outboundproxy
+
+package main
+
+import (
+	"context"
+	"net"
+	"testing"
+)
+
+func TestProxyTargetIsLocal(t *testing.T) {
+	for addr, want := range map[string]bool{
+		"127.0.0.1:80":            true,
+		"127.8.8.8:80":            true,
+		"[::1]:80":                true,
+		"[::ffff:127.0.0.1]:80":   true,
+		"0.0.0.0:80":              true,
+		"[::]:80":                 true,
+		"localhost:80":            true,
+		"LOCALHOST.:80":           true,
+		"app.localhost:80":        true,
+		"100.64.0.1:80":           false,
+		"192.168.1.20:80":         false,
+		"example.com:443":         false,
+		"localhost.example.com:1": false,
+	} {
+		if got := proxyTargetIsLocal(addr); got != want {
+			t.Errorf("proxyTargetIsLocal(%q) = %v, want %v", addr, got, want)
+		}
+	}
+}
+
+func TestGuardProxyDial(t *testing.T) {
+	dialed := 0
+	dial := func(ctx context.Context, network, addr string) (net.Conn, error) {
+		dialed++
+		a, b := net.Pipe()
+		b.Close()
+		return a, nil
+	}
+	loop, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer loop.Close()
+	// A loopback listener keeps the plain dialer, loopback targets included.
+	if c, err := guardProxyDial(loop, dial)(context.Background(), "tcp", "127.0.0.1:1"); err != nil {
+		t.Fatalf("loopback listener: %v", err)
+	} else {
+		c.Close()
+	}
+
+	// The same listener, once the tailnet is let through to its port, is open
+	// beyond the device: peers reach it through netstack from loopback.
+	reach := func(port uint16) bool { return port == listenerPort(loop.Addr()) }
+	proxyTailnetReach.Store(&reach)
+	if _, err := guardProxyDial(loop, dial)(context.Background(), "tcp", "127.0.0.1:1"); err == nil {
+		t.Fatal("a loopback listener open to the tailnet dialed loopback")
+	}
+	proxyTailnetReach.Store(nil)
+
+	open, err := net.Listen("tcp", "0.0.0.0:0")
+	if err != nil {
+		t.Skipf("no wildcard listener here: %v", err)
+	}
+	defer open.Close()
+	guarded := guardProxyDial(open, dial)
+	before := dialed
+	if _, err := guarded(context.Background(), "tcp", "127.0.0.1:1"); err == nil {
+		t.Fatal("an open listener dialed loopback")
+	}
+	if dialed != before {
+		t.Fatal("a refused target was dialed anyway")
+	}
+	if c, err := guarded(context.Background(), "tcp", "100.64.0.1:80"); err != nil {
+		t.Fatalf("an open listener refused a tailnet address: %v", err)
+	} else {
+		c.Close()
+	}
+}
