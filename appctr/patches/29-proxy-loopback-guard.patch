+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package main
+
+import "sync/atomic"
+
+// TailSocks: proxyTailnetReach answers whether the tailnet may reach a TCP
+// port of this node through netstack's road to localhost — the loopback
+// guard's policy (android_loopback.go), set when that guard is installed and
+// nil without it. The proxies ask it about their own port: a listener on
+// 127.0.0.1 that peers are let through to is open beyond the device all the
+// same, and its clients arrive from loopback like any local app's. Kept in a
+// file without build tags, since the guard and the proxies are each compiled
+// out by a tag of their own.
+var proxyTailnetReach atomic.Pointer[func(port uint16) bool]
