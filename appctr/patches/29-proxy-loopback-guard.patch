+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build !ts_omit_outboundproxy
+
+package main
+
+// TailSocks: a proxy opened beyond this device must not lead back into it.
+//
+// The SOCKS5 and HTTP proxies dial wherever the client asks, and "127.0.0.1"
+// asked of a proxy means the machine the proxy runs on. Bound to loopback that
+// is harmless: whoever can connect is already on the device. Bound to the
+// Wi-Fi or the tailnet interface ("LAN access", "Reachable from the tailnet"),
+// it handed every neighbour the phone's localhost — the web UI, the Taildrive
+// proxy, adb, any other app's local server — past the loopback guard that
+// netstack applies to tailnet peers (patch 23), which a proxy dial never
+// meets.
+//
+// While a listener is open beyond the device, a destination that is loopback
+// or unspecified by its text is refused before any dial, and a connection that
+// turned out to end on loopback (a name that resolves there) is closed. That
+// covers the proxy opened to the tailnet in userspace networking too, where
+// peers arrive through netstack at the loopback listener and look like local
+// apps: the guard asks the loopback guard's own policy about the port. A
+// listener only this device reaches keeps the plain dialer.
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"strings"
+)
+
+type proxyDialFunc func(ctx context.Context, network, addr string) (net.Conn, error)
+
+var errProxyLoopback = errors.New("this proxy is open beyond the device and does not connect to the device itself")
+
+// guardProxyDial returns dial behind the loopback guard for ln. The guard
+// stands while ln is open beyond the device: bound to anything but loopback,
+// or bound to loopback on a port the tailnet is let through to (asked on every
+// dial, because that policy changes without a restart). A listener that only
+// this device reaches dials as before.
+func guardProxyDial(ln net.Listener, dial proxyDialFunc) proxyDialFunc {
+	if ln == nil {
+		return dial
+	}
+	onLoopback := listenerOnLoopback(ln.Addr())
+	port := listenerPort(ln.Addr())
+	return func(ctx context.Context, network, addr string) (net.Conn, error) {
+		if onLoopback && !tailnetReaches(port) {
+			return dial(ctx, network, addr)
+		}
+		if proxyTargetIsLocal(addr) {
+			return nil, errProxyLoopback
+		}
+		c, err := dial(ctx, network, addr)
+		if err != nil {
+			return nil, err
+		}
+		if addrIsLoopback(c.RemoteAddr()) {
+			c.Close()
+			return nil, errProxyLoopback
+		}
+		return c, nil
+	}
+}
+
+// listenerOnLoopback reports whether a listener at a accepts only from this
+// device. An address that cannot be read counts as open: the guard is the
+// safe side to err on.
+func listenerOnLoopback(a net.Addr) bool {
+	if a == nil {
+		return false
+	}
+	ap, err := netip.ParseAddrPort(a.String())
+	if err != nil {
+		return false
+	}
+	return ap.Addr().Unmap().IsLoopback()
+}
+
+func listenerPort(a net.Addr) uint16 {
+	if a == nil {
+		return 0
+	}
+	ap, err := netip.ParseAddrPort(a.String())
+	if err != nil {
+		return 0
+	}
+	return ap.Port()
+}
+
+// tailnetReaches reports whether peers are let through to port on loopback.
+func tailnetReaches(port uint16) bool {
+	if port == 0 {
+		return false
+	}
+	reach := proxyTailnetReach.Load()
+	return reach != nil && (*reach)(port)
+}
+
+// proxyTargetIsLocal reports whether the host of hostPort names this device by
+// its text alone: a loopback or unspecified address, or "localhost".
+func proxyTargetIsLocal(hostPort string) bool {
+	host, _, err := net.SplitHostPort(hostPort)
+	if err != nil {
+		host = hostPort
+	}
+	host = strings.TrimSuffix(strings.ToLower(strings.TrimSpace(host)), ".")
+	if host == "localhost" || strings.HasSuffix(host, ".localhost") {
+		return true
+	}
+	if i := strings.IndexByte(host, '%'); i >= 0 {
+		host = host[:i]
+	}
+	ip, err := netip.ParseAddr(host)
+	if err != nil {
+		return false
+	}
+	ip = ip.Unmap()
+	return ip.IsLoopback() || ip.IsUnspecified()
+}
+
+func addrIsLoopback(a net.Addr) bool {
+	if a == nil {
+		return false
+	}
+	if ap, err := netip.ParseAddrPort(a.String()); err == nil {
+		return ap.Addr().Unmap().IsLoopback()
+	}
+	return false
+}
