+//go:build linux
+
+package androidvpn
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func fdOf(t *testing.T, f *os.File) int {
+	t.Helper()
+	raw, err := f.SyscallConn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fd int
+	if err := raw.Control(func(u uintptr) { fd = int(u) }); err != nil {
+		t.Fatal(err)
+	}
+	return fd
+}
+
+func sameFile(t *testing.T, a, b int) bool {
+	t.Helper()
+	var sa, sb unix.Stat_t
+	if err := unix.Fstat(a, &sa); err != nil {
+		t.Fatal(err)
+	}
+	if err := unix.Fstat(b, &sb); err != nil {
+		t.Fatal(err)
+	}
+	return sa.Dev == sb.Dev && sa.Ino == sb.Ino
+}
+
+func TestSendHandsOverTheDescriptor(t *testing.T) {
+	path := filepath.Join(t.TempDir(), SocketName)
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+	defer w.Close()
+
+	got := make(chan int, 1)
+	l, err := Serve(path, t.Logf, func(fd int) (string, error) {
+		got <- fd
+		return "tun7", nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	if st, err := os.Stat(path); err != nil || st.Mode().Perm() != 0o600 {
+		t.Fatalf("socket mode %v, %v; want 0600", st.Mode(), err)
+	}
+
+	name, err := Send(path, r, 2*time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if name != "tun7" {
+		t.Errorf("name %q, want tun7", name)
+	}
+	fd := <-got
+	defer syscall.Close(fd)
+	if fd == fdOf(t, r) {
+		t.Fatal("the daemon got the sender's own descriptor number")
+	}
+	if !sameFile(t, fd, fdOf(t, r)) {
+		t.Fatal("the received descriptor is another file")
+	}
+}
+
+// The open file description, O_NONBLOCK included, is shared with the daemon's
+// copy: Send must leave it as it found it.
+func TestSendKeepsNonBlocking(t *testing.T) {
+	path := filepath.Join(t.TempDir(), SocketName)
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+	defer w.Close()
+	fd := fdOf(t, r)
+	if err := unix.SetNonblock(fd, true); err != nil {
+		t.Fatal(err)
+	}
+	l, err := Serve(path, t.Logf, func(fd int) (string, error) {
+		syscall.Close(fd)
+		return "tun0", nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	if _, err := Send(path, r, 2*time.Second); err != nil {
+		t.Fatal(err)
+	}
+	flags, err := unix.FcntlInt(uintptr(fd), unix.F_GETFL, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if flags&unix.O_NONBLOCK == 0 {
+		t.Fatal("Send put the descriptor back into blocking mode")
+	}
+}
+
+func TestSendReportsARefusal(t *testing.T) {
+	path := filepath.Join(t.TempDir(), SocketName)
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+	defer w.Close()
+	l, err := Serve(path, t.Logf, func(fd int) (string, error) {
+		syscall.Close(fd)
+		return "", errors.New("batch size differs")
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	if _, err := Send(path, r, 2*time.Second); err == nil || err.Error() != "batch size differs" {
+		t.Fatalf("Send = %v, want the daemon's refusal", err)
+	}
+}
+
+func TestSendWithoutADaemon(t *testing.T) {
+	path := filepath.Join(t.TempDir(), SocketName)
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+	defer w.Close()
+	if _, err := Send(path, r, time.Second); err == nil {
+		t.Fatal("Send with nobody listening succeeded")
+	}
+	// A socket file left by a daemon that is gone.
+	l, err := Serve(path, t.Logf, func(fd int) (string, error) { return "", nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	l.Close()
+	if _, err := Send(path, r, time.Second); err == nil {
+		t.Fatal("Send to a closed socket succeeded")
+	}
+}
