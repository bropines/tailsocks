+// Package androidvpn lets TailSocks's daemon move to a new Android VPN
+// interface without a restart.
+//
+// On the native TUN engine the app's VpnService establishes the interface and
+// the daemon reads and writes it (--tun=android-vpn, cmd/tailscaled). Android
+// fixes a VPN's routes when it is established, so an exit node switched on or
+// off, or a change in the accepted subnet routes, means a new interface and a
+// new descriptor. [SwapDevice] is the tun.Device the engine keeps for its
+// whole life, and [SwapDevice.Swap] puts the new interface under it; [Serve]
+// and [Send] carry the descriptor from the app to the daemon.
+package androidvpn
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"sync"
+	"time"
+
+	"github.com/tailscale/wireguard-go/tun"
+	"tailscale.com/types/logger"
+)
+
+// swapGrace is how long an error from the current device waits for a swap
+// before it reaches the engine. Android takes the old interface down the
+// moment the app establishes the new one, and the new descriptor arrives a
+// moment later; wireguard-go closes the whole engine on a read error, so an
+// error in that window must not get through. A variable for the tests.
+var swapGrace = 5 * time.Second
+
+var errClosed = errors.New("android VPN device closed")
+
+// SwapDevice is a tun.Device whose underlying device can be replaced while
+// the engine runs. It reads from and writes to the current device; a Read
+// blocked on a device that Swap retired returns with that device's close and
+// goes on with the new one, so the engine never sees it.
+//
+// BatchSize is fixed by the first device, as tun.Device requires: a device
+// with another batch size is refused. Events are the first device's, then a
+// swapped-in device's MTU updates; Up and Down from a later device are not
+// passed on, since the engine is already up and the old device going down is
+// the swap itself.
+type SwapDevice struct {
+	logf   logger.Logf
+	batch  int
+	events chan tun.Event
+	done   chan struct{}
+	wg     sync.WaitGroup // event forwarders
+
+	mu      sync.Mutex
+	cur     tun.Device
+	swapped chan struct{} // closed and replaced by every Swap
+	closed  bool
+	swaps   int
+}
+
+// NewSwapDevice wraps dev, the device the engine starts on.
+func NewSwapDevice(dev tun.Device, logf logger.Logf) *SwapDevice {
+	s := &SwapDevice{
+		logf:    logf,
+		batch:   dev.BatchSize(),
+		events:  make(chan tun.Event, 8),
+		done:    make(chan struct{}),
+		cur:     dev,
+		swapped: make(chan struct{}),
+	}
+	s.forward(dev, true)
+	return s
+}
+
+// forward passes dev's events on until dev closes them or s closes. A device
+// swapped in later passes only its MTU updates; see SwapDevice.
+func (s *SwapDevice) forward(dev tun.Device, first bool) {
+	s.wg.Add(1)
+	go func() {
+		defer s.wg.Done()
+		for {
+			select {
+			case ev, ok := <-dev.Events():
+				if !ok {
+					return
+				}
+				if !first {
+					ev &= tun.EventMTUUpdate
+					if ev == 0 {
+						continue
+					}
+				}
+				select {
+				case s.events <- ev:
+				case <-s.done:
+					return
+				}
+			case <-s.done:
+				return
+			}
+		}
+	}()
+}
+
+// current is the device in use and the channel the next Swap closes; nil
+// after Close.
+func (s *SwapDevice) current() (tun.Device, chan struct{}) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		return nil, nil
+	}
+	return s.cur, s.swapped
+}
+
+// Swaps is how many times the device was replaced.
+func (s *SwapDevice) Swaps() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.swaps
+}
+
+// Swap makes dev the device in use and closes the one it replaces. On error
+// dev is left to the caller.
+func (s *SwapDevice) Swap(dev tun.Device) error {
+	if got := dev.BatchSize(); got != s.batch {
+		return fmt.Errorf("new device reads %d packets at a time, the engine was built for %d", got, s.batch)
+	}
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		return errClosed
+	}
+	old := s.cur
+	s.cur = dev
+	s.swaps++
+	close(s.swapped)
+	s.swapped = make(chan struct{})
+	s.mu.Unlock()
+
+	s.forward(dev, false)
+	// The new device is in place before the old one closes, so a Read that the
+	// close wakes finds it.
+	if err := old.Close(); err != nil {
+		s.logf("android-vpn: closing the previous device: %v", err)
+	}
+	return nil
+}
+
+// settle decides what to do with err from dev: true to read or write again
+// (dev was swapped out, now or within swapGrace), false to return it.
+func (s *SwapDevice) settle(dev tun.Device, swapped chan struct{}, wait bool) bool {
+	cur, _ := s.current()
+	if cur == nil {
+		return false
+	}
+	if cur != dev {
+		return true
+	}
+	if !wait {
+		return false
+	}
+	t := time.NewTimer(swapGrace)
+	defer t.Stop()
+	select {
+	case <-swapped:
+		return true
+	case <-s.done:
+		return false
+	case <-t.C:
+		return false
+	}
+}
+
+// Read reads from the current device. See SwapDevice.
+func (s *SwapDevice) Read(slab []byte, packets []tun.ReadPacket) (int, error) {
+	for {
+		dev, swapped := s.current()
+		if dev == nil {
+			return 0, os.ErrClosed
+		}
+		n, err := dev.Read(slab, packets)
+		if err == nil || errors.Is(err, tun.ErrTooManySegments) {
+			return n, err
+		}
+		if n > 0 {
+			// The entries are valid even with an error; a later Read reports
+			// the error again if it is the device's for good.
+			return n, nil
+		}
+		if s.settle(dev, swapped, true) {
+			continue
+		}
+		return n, err
+	}
+}
+
+// Write writes to the current device. A write that a swap caught, and that
+// the old device took none of, goes to the new one. What the count means
+// differs between devices — packets for some, bytes for wireguard-go's Linux
+// TUN, which also goes on past a failed packet — so a write it took part of
+// is not repeated.
+func (s *SwapDevice) Write(bufs [][]byte, offset int) (int, error) {
+	dev, swapped := s.current()
+	if dev == nil {
+		return 0, os.ErrClosed
+	}
+	n, err := dev.Write(bufs, offset)
+	if err == nil || n != 0 {
+		return n, err
+	}
+	if s.settle(dev, swapped, false) {
+		if next, _ := s.current(); next != nil {
+			return next.Write(bufs, offset)
+		}
+	}
+	return n, err
+}
+
+// File is the current device's descriptor.
+func (s *SwapDevice) File() *os.File {
+	dev, _ := s.current()
+	if dev == nil {
+		return nil
+	}
+	return dev.File()
+}
+
+// MTU is the current device's.
+func (s *SwapDevice) MTU() (int, error) {
+	dev, _ := s.current()
+	if dev == nil {
+		return 0, os.ErrClosed
+	}
+	return dev.MTU()
+}
+
+// Name is the current device's interface name; Android names each new VPN
+// interface anew (tun0, tun1, …).
+func (s *SwapDevice) Name() (string, error) {
+	dev, _ := s.current()
+	if dev == nil {
+		return "", os.ErrClosed
+	}
+	return dev.Name()
+}
+
+// Events is fed as SwapDevice says, and closed by Close.
+func (s *SwapDevice) Events() <-chan tun.Event {
+	return s.events
+}
+
+// BatchSize is the first device's, for the device's whole life.
+func (s *SwapDevice) BatchSize() int {
+	return s.batch
+}
+
+// Close closes the current device and the events channel.
+func (s *SwapDevice) Close() error {
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		return nil
+	}
+	s.closed = true
+	dev := s.cur
+	close(s.done)
+	s.mu.Unlock()
+
+	err := dev.Close()
+	s.wg.Wait()
+	close(s.events)
+	return err
+}
