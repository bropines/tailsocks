@@ -0,0 +1,53 @@
+//go:build linux
+
+package main
+
+// TailSocks native TUN: moving the engine to a new VpnService device without a
+// restart.
+//
+// Android fixes a VPN's routes at establish(), so an exit node switched on or
+// off, or other accepted subnet routes, mean a new interface. The app
+// establishes it while the old one still stands (Android takes the old one
+// down at that moment), sends a duplicate of the new descriptor to the socket
+// served here, and the engine's androidvpn.SwapDevice moves onto it; the old
+// descriptor is closed with the device it belonged to. Anything that goes
+// wrong is answered as an error, and the app then relaunches the daemon on the
+// new device the way it did before this existed.
+
+import (
+	"path/filepath"
+
+	"github.com/tailscale/wireguard-go/tun"
+	"tailscale.com/net/androidvpn"
+	"tailscale.com/net/netmon"
+	"tailscale.com/types/logger"
+)
+
+// serveAndroidVPNSwap listens beside the daemon's socket for new devices for
+// sw. Without a socket path, or when the socket cannot be made, the daemon
+// runs as before and every device change relaunches it.
+func serveAndroidVPNSwap(logf logger.Logf, sw *androidvpn.SwapDevice) {
+	if args.socketpath == "" {
+		return
+	}
+	path := filepath.Join(filepath.Dir(args.socketpath), androidvpn.SocketName)
+	_, err := androidvpn.Serve(path, logf, func(fd int) (string, error) {
+		dev, name, err := tun.CreateUnmonitoredTUNFromFD(fd) // closes fd on error
+		if err != nil {
+			return "", err
+		}
+		if err := sw.Swap(dev); err != nil {
+			dev.Close()
+			return "", err
+		}
+		// netmon tells the Tailscale interface apart by this name, and
+		// Android gives every new VPN interface a new one.
+		netmon.SetTailscaleInterfaceProps(name, 0)
+		mtu, _ := dev.MTU()
+		logf("android-vpn: moved to the new VpnService device %q (mtu %d), swap %d", name, mtu, sw.Swaps())
+		return name, nil
+	})
+	if err != nil {
+		logf("android-vpn: no device swaps, every route change relaunches the daemon: %v", err)
+	}
+}
