+package androidvpn
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/tailscale/wireguard-go/tun"
+)
+
+// fakeDev is a tun.Device fed and drained through channels.
+type fakeDev struct {
+	name    string
+	batch   int
+	in      chan []byte // packets Read returns
+	readErr chan error  // an error Read returns instead
+	out     chan []byte // packets Write took
+	gate    chan struct{}
+	events  chan tun.Event
+	closed  chan struct{}
+	once    sync.Once
+}
+
+func newFake(name string) *fakeDev {
+	return &fakeDev{
+		name:    name,
+		batch:   1,
+		in:      make(chan []byte, 8),
+		readErr: make(chan error, 1),
+		out:     make(chan []byte, 8),
+		events:  make(chan tun.Event, 4),
+		closed:  make(chan struct{}),
+	}
+}
+
+func (d *fakeDev) Read(slab []byte, packets []tun.ReadPacket) (int, error) {
+	select {
+	case p := <-d.in:
+		n := copy(slab[tun.ReadPacketSpacing:], p)
+		packets[0] = tun.ReadPacket{Offset: tun.ReadPacketSpacing, Size: n}
+		return 1, nil
+	case err := <-d.readErr:
+		return 0, err
+	case <-d.closed:
+		return 0, os.ErrClosed
+	}
+}
+
+func (d *fakeDev) Write(bufs [][]byte, offset int) (int, error) {
+	if d.gate != nil {
+		<-d.gate
+	}
+	select {
+	case <-d.closed:
+		return 0, os.ErrClosed
+	default:
+	}
+	for _, b := range bufs {
+		d.out <- append([]byte(nil), b[offset:]...)
+	}
+	return len(bufs), nil
+}
+
+func (d *fakeDev) File() *os.File           { return nil }
+func (d *fakeDev) MTU() (int, error)        { return 1280, nil }
+func (d *fakeDev) Name() (string, error)    { return d.name, nil }
+func (d *fakeDev) Events() <-chan tun.Event { return d.events }
+func (d *fakeDev) BatchSize() int           { return d.batch }
+func (d *fakeDev) Close() error {
+	d.once.Do(func() {
+		close(d.closed)
+		close(d.events)
+	})
+	return nil
+}
+
+func (d *fakeDev) isClosed() bool {
+	select {
+	case <-d.closed:
+		return true
+	default:
+		return false
+	}
+}
+
+type readResult struct {
+	pkt []byte
+	err error
+}
+
+// reader reads s until an error, like wireguard-go's TUN reader.
+func reader(s *SwapDevice) <-chan readResult {
+	ch := make(chan readResult, 16)
+	go func() {
+		slab := make([]byte, 2048)
+		packets := make([]tun.ReadPacket, 1)
+		for {
+			n, err := s.Read(slab, packets)
+			for i := range n {
+				p := packets[i]
+				ch <- readResult{pkt: append([]byte(nil), slab[p.Offset:p.Offset+p.Size]...)}
+			}
+			if err != nil {
+				ch <- readResult{err: err}
+				close(ch)
+				return
+			}
+		}
+	}()
+	return ch
+}
+
+func expectPacket(t *testing.T, ch <-chan readResult, want string) {
+	t.Helper()
+	select {
+	case r := <-ch:
+		if r.err != nil {
+			t.Fatalf("Read returned %v, want packet %q", r.err, want)
+		}
+		if string(r.pkt) != want {
+			t.Fatalf("Read returned %q, want %q", r.pkt, want)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatalf("no packet %q", want)
+	}
+}
+
+func expectNothing(t *testing.T, ch <-chan readResult, d time.Duration) {
+	t.Helper()
+	select {
+	case r := <-ch:
+		t.Fatalf("unexpected read result: %q, %v", r.pkt, r.err)
+	case <-time.After(d):
+	}
+}
+
+func TestReadMovesToTheNewDevice(t *testing.T) {
+	a, b := newFake("tun0"), newFake("tun1")
+	s := NewSwapDevice(a, t.Logf)
+	defer s.Close()
+	ch := reader(s)
+
+	a.in <- []byte("one")
+	expectPacket(t, ch, "one")
+
+	// The reader is now blocked on a: the swap closes a under it.
+	if err := s.Swap(b); err != nil {
+		t.Fatal(err)
+	}
+	if !a.isClosed() {
+		t.Fatal("the swapped-out device is still open")
+	}
+	b.in <- []byte("two")
+	expectPacket(t, ch, "two")
+	expectNothing(t, ch, 50*time.Millisecond)
+	if got, _ := s.Name(); got != "tun1" {
+		t.Errorf("Name = %q, want tun1", got)
+	}
+	if s.Swaps() != 1 {
+		t.Errorf("Swaps = %d, want 1", s.Swaps())
+	}
+}
+
+func TestReadErrorWaitsForTheSwap(t *testing.T) {
+	a, b := newFake("tun0"), newFake("tun1")
+	s := NewSwapDevice(a, t.Logf)
+	defer s.Close()
+	ch := reader(s)
+
+	// Android took the old interface down; the new descriptor is on its way.
+	a.readErr <- syscall.EIO
+	expectNothing(t, ch, 50*time.Millisecond)
+	if err := s.Swap(b); err != nil {
+		t.Fatal(err)
+	}
+	b.in <- []byte("after")
+	expectPacket(t, ch, "after")
+}
+
+func TestReadErrorWithoutASwapReachesTheEngine(t *testing.T) {
+	defer func(d time.Duration) { swapGrace = d }(swapGrace)
+	swapGrace = 50 * time.Millisecond
+	a := newFake("tun0")
+	s := NewSwapDevice(a, t.Logf)
+	defer s.Close()
+	ch := reader(s)
+
+	a.readErr <- syscall.EIO
+	select {
+	case r := <-ch:
+		if !errors.Is(r.err, syscall.EIO) {
+			t.Fatalf("Read returned %q, %v; want EIO", r.pkt, r.err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("the device's own error never reached the engine")
+	}
+}
+
+func TestCloseEndsABlockedRead(t *testing.T) {
+	a := newFake("tun0")
+	s := NewSwapDevice(a, t.Logf)
+	ch := reader(s)
+	expectNothing(t, ch, 20*time.Millisecond)
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case r := <-ch:
+		if !errors.Is(r.err, os.ErrClosed) {
+			t.Fatalf("Read after Close returned %q, %v", r.pkt, r.err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("Close did not end the blocked Read")
+	}
+	if err := s.Close(); err != nil {
+		t.Errorf("second Close: %v", err)
+	}
+	if err := s.Swap(newFake("tun1")); err == nil {
+		t.Error("Swap after Close succeeded")
+	}
+	if _, ok := <-s.Events(); ok {
+		t.Error("the events channel is still open after Close")
+	}
+}
+
+func TestWriteGoesToTheCurrentDevice(t *testing.T) {
+	a, b := newFake("tun0"), newFake("tun1")
+	s := NewSwapDevice(a, t.Logf)
+	defer s.Close()
+	buf := [][]byte{[]byte("..hello")}
+	if n, err := s.Write(buf, 2); n != 1 || err != nil {
+		t.Fatalf("Write = %d, %v", n, err)
+	}
+	if got := <-a.out; !bytes.Equal(got, []byte("hello")) {
+		t.Fatalf("a got %q", got)
+	}
+	if err := s.Swap(b); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := s.Write(buf, 2); n != 1 || err != nil {
+		t.Fatalf("Write after the swap = %d, %v", n, err)
+	}
+	if got := <-b.out; !bytes.Equal(got, []byte("hello")) {
+		t.Fatalf("b got %q", got)
+	}
+}
+
+func TestAWriteCaughtByTheSwapGoesToTheNewDevice(t *testing.T) {
+	a, b := newFake("tun0"), newFake("tun1")
+	a.gate = make(chan struct{})
+	s := NewSwapDevice(a, t.Logf)
+	defer s.Close()
+
+	done := make(chan error, 1)
+	go func() {
+		_, err := s.Write([][]byte{[]byte("late")}, 0)
+		done <- err
+	}()
+	time.Sleep(20 * time.Millisecond) // the write is inside a
+	if err := s.Swap(b); err != nil {
+		t.Fatal(err)
+	}
+	close(a.gate) // a finds itself closed and refuses the packet
+	if err := <-done; err != nil {
+		t.Fatalf("Write = %v", err)
+	}
+	select {
+	case got := <-b.out:
+		if string(got) != "late" {
+			t.Fatalf("b got %q", got)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("the packet never reached the new device")
+	}
+}
+
+func TestSwapRefusesAnotherBatchSize(t *testing.T) {
+	a, b := newFake("tun0"), newFake("tun1")
+	b.batch = 64
+	s := NewSwapDevice(a, t.Logf)
+	defer s.Close()
+	if err := s.Swap(b); err == nil {
+		t.Fatal("a device with another batch size was taken")
+	}
+	if a.isClosed() || b.isClosed() {
+		t.Fatal("a refused swap closed a device")
+	}
+	if got, _ := s.Name(); got != "tun0" {
+		t.Errorf("Name = %q after a refused swap", got)
+	}
+}
+
+func TestEvents(t *testing.T) {
+	a, b := newFake("tun0"), newFake("tun1")
+	a.events <- tun.EventUp
+	s := NewSwapDevice(a, t.Logf)
+	expectEvent := func(want tun.Event) {
+		t.Helper()
+		select {
+		case got := <-s.Events():
+			if got != want {
+				t.Fatalf("event %v, want %v", got, want)
+			}
+		case <-time.After(2 * time.Second):
+			t.Fatalf("no event %v", want)
+		}
+	}
+	expectEvent(tun.EventUp)
+	if err := s.Swap(b); err != nil {
+		t.Fatal(err)
+	}
+	// The engine is up already: the new device's Up is not news, its MTU is.
+	b.events <- tun.EventUp
+	b.events <- tun.EventDown
+	b.events <- tun.EventMTUUpdate
+	expectEvent(tun.EventMTUUpdate)
+	select {
+	case ev := <-s.Events():
+		t.Fatalf("unexpected event %v", ev)
+	case <-time.After(50 * time.Millisecond):
+	}
+	s.Close()
+	if _, ok := <-s.Events(); ok {
+		t.Fatal("events not closed")
+	}
+}
