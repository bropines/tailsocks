@@ -0,0 +1,202 @@
+//go:build linux
+
+package androidvpn
+
+// The descriptor of a new VPN interface goes from the app to the daemon over a
+// unix socket beside the daemon's own (SCM_RIGHTS). Only the daemon's own UID
+// may hand one over: the socket is 0600 in the app's data directory, and the
+// peer's credentials are checked again on every connection.
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"syscall"
+	"time"
+
+	"golang.org/x/sys/unix"
+	"tailscale.com/types/logger"
+)
+
+// SocketName is the socket's file name, beside tailscaled.sock.
+const SocketName = "tun-swap.sock"
+
+const (
+	requestMax = 1024
+	connWait   = 10 * time.Second
+)
+
+type request struct {
+	Op string `json:"op"` // "swap"
+}
+
+type reply struct {
+	Name  string `json:"name,omitempty"` // the new interface, on success
+	Error string `json:"error,omitempty"`
+}
+
+// Serve listens at path for new VPN descriptors and gives each one to accept,
+// which owns it from then on — it closes it on error. accept returns the new
+// interface's name. Close the returned Closer to stop listening.
+func Serve(path string, logf logger.Logf, accept func(fd int) (string, error)) (io.Closer, error) {
+	_ = os.Remove(path)
+	l, err := net.ListenUnix("unixpacket", &net.UnixAddr{Name: path, Net: "unixpacket"})
+	if err != nil {
+		return nil, err
+	}
+	if err := os.Chmod(path, 0o600); err != nil {
+		_ = l.Close()
+		return nil, err
+	}
+	go func() {
+		for {
+			c, err := l.AcceptUnix()
+			if err != nil {
+				if !errors.Is(err, net.ErrClosed) {
+					logf("android-vpn: swap socket: %v", err)
+				}
+				return
+			}
+			go handle(c, logf, accept)
+		}
+	}()
+	return l, nil
+}
+
+func handle(c *net.UnixConn, logf logger.Logf, accept func(fd int) (string, error)) {
+	defer c.Close()
+	_ = c.SetDeadline(time.Now().Add(connWait))
+	buf := make([]byte, requestMax)
+	oob := make([]byte, syscall.CmsgSpace(4*4))
+	n, oobn, _, _, err := c.ReadMsgUnix(buf, oob)
+	if err != nil {
+		return
+	}
+	fds := receivedFDs(oob[:oobn])
+	answer := func(name string, err error) {
+		r := reply{Name: name}
+		if err != nil {
+			r.Error = err.Error()
+		}
+		b, _ := json.Marshal(r)
+		_, _ = c.Write(b)
+	}
+	if err := checkPeer(c); err != nil {
+		closeFDs(fds)
+		answer("", err)
+		return
+	}
+	var req request
+	if err := json.Unmarshal(buf[:n], &req); err != nil {
+		closeFDs(fds)
+		answer("", fmt.Errorf("request: %w", err))
+		return
+	}
+	if req.Op != "swap" {
+		closeFDs(fds)
+		answer("", fmt.Errorf("unknown op %q", req.Op))
+		return
+	}
+	if len(fds) != 1 {
+		closeFDs(fds)
+		answer("", fmt.Errorf("one descriptor expected, got %d", len(fds)))
+		return
+	}
+	name, err := accept(fds[0])
+	if err != nil {
+		logf("android-vpn: a new VpnService device was refused: %v", err)
+	}
+	answer(name, err)
+}
+
+// checkPeer: only this process's own UID — the app — hands over a device.
+func checkPeer(c *net.UnixConn) error {
+	raw, err := c.SyscallConn()
+	if err != nil {
+		return err
+	}
+	var cred *unix.Ucred
+	var credErr error
+	if err := raw.Control(func(fd uintptr) {
+		cred, credErr = unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED)
+	}); err != nil {
+		return err
+	}
+	if credErr != nil {
+		return credErr
+	}
+	if int(cred.Uid) != os.Getuid() {
+		return fmt.Errorf("uid %d may not hand over a VPN device", cred.Uid)
+	}
+	return nil
+}
+
+func receivedFDs(oob []byte) []int {
+	msgs, err := syscall.ParseSocketControlMessage(oob)
+	if err != nil {
+		return nil
+	}
+	var fds []int
+	for i := range msgs {
+		if got, err := syscall.ParseUnixRights(&msgs[i]); err == nil {
+			fds = append(fds, got...)
+		}
+	}
+	return fds
+}
+
+func closeFDs(fds []int) {
+	for _, fd := range fds {
+		_ = syscall.Close(fd)
+	}
+}
+
+// Send hands the daemon listening at path a duplicate of f's descriptor and
+// waits up to timeout for it to move its engine onto that device. f stays the
+// caller's. It returns the new interface's name.
+//
+// The descriptor is read through SyscallConn rather than f.Fd: Fd puts a
+// non-blocking file back into blocking mode, and the open file description —
+// with its O_NONBLOCK flag — is the one the daemon reads, which would leave
+// the daemon's reads blocking and its device impossible to close.
+func Send(path string, f *os.File, timeout time.Duration) (string, error) {
+	raw, err := f.SyscallConn()
+	if err != nil {
+		return "", err
+	}
+	c, err := net.DialUnix("unixpacket", nil, &net.UnixAddr{Name: path, Net: "unixpacket"})
+	if err != nil {
+		return "", fmt.Errorf("swap socket: %w", err)
+	}
+	defer c.Close()
+	_ = c.SetDeadline(time.Now().Add(timeout))
+	b, err := json.Marshal(request{Op: "swap"})
+	if err != nil {
+		return "", err
+	}
+	var werr error
+	if err := raw.Control(func(fd uintptr) {
+		_, _, werr = c.WriteMsgUnix(b, syscall.UnixRights(int(fd)), nil)
+	}); err != nil {
+		return "", err
+	}
+	if werr != nil {
+		return "", fmt.Errorf("swap socket: %w", werr)
+	}
+	buf := make([]byte, requestMax)
+	n, err := c.Read(buf)
+	if err != nil {
+		return "", fmt.Errorf("swap socket: %w", err)
+	}
+	var r reply
+	if err := json.Unmarshal(buf[:n], &r); err != nil {
+		return "", fmt.Errorf("swap socket reply: %w", err)
+	}
+	if r.Error != "" {
+		return "", errors.New(r.Error)
+	}
+	return r.Name, nil
+}
