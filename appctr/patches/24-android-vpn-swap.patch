@@ -0,0 +1,202 @@
+//go:build linux
+
+package androidvpn
+
+// A swap on real kernel TUN devices, the way Android does it: a second
+// interface takes the address and the routes, the first is taken down (Vpn's
+// jniReset), and the daemon gets the new descriptor over the socket. It needs
+// CAP_NET_ADMIN in a network namespace of its own, so it runs only when asked:
+//
+//	ANDROIDVPN_REAL_TUN=1 unshare -rn go test -run RealTUN ./net/androidvpn/
+
+import (
+	"encoding/binary"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+	"unsafe"
+
+	"github.com/tailscale/wireguard-go/tun"
+	"golang.org/x/sys/unix"
+)
+
+// openTUN creates interface name as Android's VpnService does: IFF_TUN,
+// IFF_NO_PI, no virtio header.
+func openTUN(t *testing.T, name string) *os.File {
+	t.Helper()
+	fd, err := unix.Open("/dev/net/tun", unix.O_RDWR|unix.O_CLOEXEC, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var ifr [unix.IFNAMSIZ + 64]byte
+	copy(ifr[:], name)
+	binary.NativeEndian.PutUint16(ifr[unix.IFNAMSIZ:], unix.IFF_TUN|unix.IFF_NO_PI)
+	if _, _, errno := unix.Syscall(unix.SYS_IOCTL, uintptr(fd), uintptr(unix.TUNSETIFF), uintptr(unsafe.Pointer(&ifr[0]))); errno != 0 {
+		unix.Close(fd)
+		t.Fatalf("TUNSETIFF %s: %v", name, errno)
+	}
+	return os.NewFile(uintptr(fd), name)
+}
+
+func ip(t *testing.T, args ...string) {
+	t.Helper()
+	if out, err := exec.Command("ip", args...).CombinedOutput(); err != nil {
+		t.Fatalf("ip %v: %v\n%s", args, err, out)
+	}
+}
+
+// udp4 is an IPv4/UDP packet from src to dst, without a UDP checksum.
+func udp4(src, dst netip4, sport, dport uint16, payload []byte) []byte {
+	p := make([]byte, 28+len(payload))
+	p[0] = 0x45
+	binary.BigEndian.PutUint16(p[2:], uint16(len(p)))
+	p[8] = 64
+	p[9] = unix.IPPROTO_UDP
+	copy(p[12:16], src[:])
+	copy(p[16:20], dst[:])
+	var sum uint32
+	for i := 0; i < 20; i += 2 {
+		sum += uint32(binary.BigEndian.Uint16(p[i:]))
+	}
+	for sum > 0xffff {
+		sum = sum>>16 + sum&0xffff
+	}
+	binary.BigEndian.PutUint16(p[10:], ^uint16(sum))
+	binary.BigEndian.PutUint16(p[20:], sport)
+	binary.BigEndian.PutUint16(p[22:], dport)
+	binary.BigEndian.PutUint16(p[24:], uint16(8+len(payload)))
+	copy(p[28:], payload)
+	return p
+}
+
+type netip4 [4]byte
+
+func TestRealTUNSwap(t *testing.T) {
+	if os.Getenv("ANDROIDVPN_REAL_TUN") == "" {
+		t.Skip("set ANDROIDVPN_REAL_TUN=1 and run under unshare -rn")
+	}
+	self := netip4{10, 99, 0, 1}
+	peer := netip4{10, 99, 1, 5}
+
+	// The first VPN: what the daemon starts on.
+	f0 := openTUN(t, "swp0")
+	ip(t, "link", "set", "lo", "up")
+	ip(t, "addr", "add", "10.99.0.1/32", "dev", "swp0")
+	ip(t, "link", "set", "swp0", "up")
+	ip(t, "route", "add", "10.99.1.0/24", "dev", "swp0")
+	// The daemon's copy: its own descriptor of the same device.
+	fd0, err := unix.Dup(int(f0.Fd()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	dev0, name0, err := tun.CreateUnmonitoredTUNFromFD(fd0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if name0 != "swp0" {
+		t.Fatalf("name %q", name0)
+	}
+	s := NewSwapDevice(dev0, t.Logf)
+	defer s.Close()
+	ch := reader(s)
+
+	// An app's datagram to a peer comes out of the device.
+	sendTo := func(payload string) {
+		t.Helper()
+		c, err := net.Dial("udp4", "10.99.1.5:9")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer c.Close()
+		if _, err := c.Write([]byte(payload)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	expectDatagram := func(want string) {
+		t.Helper()
+		deadline := time.After(3 * time.Second)
+		for {
+			select {
+			case r := <-ch:
+				if r.err != nil {
+					t.Fatalf("Read: %v", r.err)
+				}
+				if len(r.pkt) >= 28 && r.pkt[9] == unix.IPPROTO_UDP && string(r.pkt[28:]) == want {
+					return
+				}
+				// Anything else the kernel sends (router solicitations…) is not ours.
+			case <-deadline:
+				t.Fatalf("datagram %q never came out of the device", want)
+			}
+		}
+	}
+	sendTo("before")
+	expectDatagram("before")
+
+	// Android establishes the new VPN: a new interface with the same address
+	// and the routes, and the old one reset.
+	f1 := openTUN(t, "swp1")
+	defer f1.Close()
+	ip(t, "addr", "add", "10.99.0.1/32", "dev", "swp1")
+	ip(t, "link", "set", "swp1", "up")
+	ip(t, "route", "replace", "10.99.1.0/24", "dev", "swp1")
+	ip(t, "addr", "flush", "dev", "swp0")
+	ip(t, "link", "set", "swp0", "down")
+
+	// The descriptor goes over the socket, as the bridge sends it.
+	path := filepath.Join(t.TempDir(), SocketName)
+	l, err := Serve(path, t.Logf, func(fd int) (string, error) {
+		dev, name, err := tun.CreateUnmonitoredTUNFromFD(fd)
+		if err != nil {
+			return "", err
+		}
+		if err := s.Swap(dev); err != nil {
+			dev.Close()
+			return "", err
+		}
+		return name, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	name, err := Send(path, f1, 2*time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if name != "swp1" {
+		t.Fatalf("swapped to %q, want swp1", name)
+	}
+	f0.Close() // the app's and the bridge's copies go too
+
+	sendTo("after")
+	expectDatagram("after")
+
+	// And a peer's datagram written by the engine reaches an app on the new interface.
+	ln, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IP(self[:]), Port: 4242})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	pkt := udp4(peer, self, 5353, 4242, []byte("inbound"))
+	buf := make([]byte, 16+len(pkt))
+	copy(buf[16:], pkt)
+	if _, err := s.Write([][]byte{buf}, 16); err != nil {
+		t.Fatalf("Write: %v", err)
+	}
+	_ = ln.SetReadDeadline(time.Now().Add(3 * time.Second))
+	got := make([]byte, 64)
+	n, from, err := ln.ReadFromUDP(got)
+	if err != nil {
+		t.Fatalf("the written datagram never arrived: %v", err)
+	}
+	if string(got[:n]) != "inbound" || !from.IP.Equal(net.IP(peer[:])) {
+		t.Fatalf("got %q from %v", got[:n], from)
+	}
+	if out, _ := exec.Command("ip", "-br", "link").CombinedOutput(); len(out) > 0 {
+		t.Logf("links after the swap:\n%s", out)
+	}
+}
