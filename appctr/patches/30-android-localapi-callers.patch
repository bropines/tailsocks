+//go:build !android
+
+package main
+
+import (
+	"net"
+
+	"tailscale.com/types/logger"
+)
+
+// guardLocalAPIListener is Android's (localapi_guard_android.go); elsewhere
+// upstream's own peer-credential checks stand.
+func guardLocalAPIListener(logf logger.Logf, ln net.Listener, socketPath string) net.Listener {
+	return ln
+}
