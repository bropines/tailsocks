+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build android
+
+package main
+
+import "testing"
+
+func TestLocalAPICallerAllowed(t *testing.T) {
+	const self, app = 0, 10365 // Root Mode: the daemon is root, the app owns the directory
+	for uid, want := range map[int]bool{0: true, app: true, 2000: false, 10366: false} {
+		if got := localAPICallerAllowed(uid, self, app); got != want {
+			t.Errorf("root daemon: uid %d allowed = %v, want %v", uid, got, want)
+		}
+	}
+	// The app's own child daemon: daemon and owner are the same UID.
+	if !localAPICallerAllowed(app, app, app) || localAPICallerAllowed(10366, app, app) {
+		t.Error("app daemon: only the app and root may call")
+	}
+	// A directory that could not be read names nobody.
+	if localAPICallerAllowed(-1, 0, -1) {
+		t.Error("an unread owner must not match an unread caller")
+	}
+}
