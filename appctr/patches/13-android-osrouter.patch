+// purgeDesktopIPRulesAndroid removes the desktop-Linux policy rules that a
+// previous TailSocks core, which ran this router unmodified, may have left
+// behind: "5210 lookup main", "5230 lookup default", "5250 unreachable" and
+// "5270 lookup 52". A stale 5270 would send the new daemon's marked packets
+// into tailscale0 as soon as table 52 holds an exit-node default route. Rules
+// are matched by priority plus table/type, never blindly by priority, so a
+// third-party rule at the same pref is left alone. Both families are swept
+// regardless of IPv6 availability, and errors are only logged.
+func (r *linuxRouter) purgeDesktopIPRulesAndroid() {
+	families := []addrFamily{v4, v6}
+	if r.useIPCommand() {
+		// 'ip rule del' exits 2 (or 254 on old iproute2) for a missing rule.
+		rg := newRunGroup([]int{2, 254}, r.cmd)
+		for _, family := range families {
+			for _, rule := range baseIPRules {
+				args := []string{
+					"ip", family.dashArg(),
+					"rule", "del",
+					"pref", strconv.Itoa(rule.Priority + r.ipPolicyPrefBase),
+				}
+				if rule.Table != 0 {
+					args = append(args, "table", mustRouteTable(rule.Table).ipCmdArg())
+				} else {
+					args = append(args, "type", "unreachable")
+				}
+				rg.Run(args...)
+			}
+		}
+		if rg.ErrAcc != nil {
+			r.logf("android: purging stale desktop ip rules: %v", rg.ErrAcc)
+		}
+		return
+	}
+	for _, family := range families {
+	rules:
+		for _, ru := range baseIPRules {
+			// Note: ru is a value type here; safe to mutate it. Mark/Mask -1
+			// match any mark, as delIPRules does.
+			ru.Family = family.netlinkInt()
+			ru.Mark = -1
+			ru.Mask = -1
+			ru.Goto = -1
+			ru.SuppressIfgroup = -1
+			ru.SuppressPrefixlen = -1
+			ru.Priority += r.ipPolicyPrefBase
+			// RTM_DELRULE removes one matching rule per call; loop in case
+			// several identical rules accumulated.
+			for range 8 {
+				err := netlink.RuleDel(&ru)
+				if errors.Is(err, errENOENT) {
+					continue rules
+				}
+				if err != nil {
+					// E.g. EAFNOSUPPORT without IPv6; nothing else of this
+					// family will work either.
+					r.logf("android: purging stale desktop ip rules (%s): %v", family.dashArg(), err)
+					break rules
+				}
+				r.logf("android: removed stale desktop ip rule pref %d (%s) left by a previous core", ru.Priority, family.dashArg())
+			}
+		}
+	}
+}
