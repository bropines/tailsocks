+// androidV6Available is getV6Available for Android, where there is no
+// netfilter runner to ask. Global IPv6 support is probed once with
+// linuxfw.CheckIPv6 (the procfs knobs plus a netlink rule listing, the same
+// probe the runners memoize for HasIPV6; it touches no netfilter) and combined
+// with the per-interface snapshot exactly like the desktop path.
+func (r *linuxRouter) androidV6Available() bool {
+	r.androidV6.Do(func() {
+		if err := linuxfw.CheckIPv6(r.logf); err != nil {
+			r.logf("android: IPv6 unavailable, skipping IPv6 addresses and routes: %v", err)
+			return
+		}
+		r.androidV6.ok = true
+	})
+	if !r.androidV6.ok {
+		return false
+	}
+	switch memoV6(r.interfaceV6UsableMemo.Load()) {
+	case memoV6Usable:
+		return true
+	case memoV6Unusable:
+		return false
+	default: // memoV6Unset: no snapshot active, read live.
+		return r.interfaceV6Usable()
+	}
+}
