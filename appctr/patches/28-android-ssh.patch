--- /dev/null	2026-10-28 02:24:56.833023069 +0300
+++ tailscale_src/util/osuser/android.go	2026-10-28 18:29:26.553448860 +0300
@@ -0,0 +1,154 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+// Tailsocks: the users Tailscale SSH can log in as on Android, where there is
+// no passwd database, no getent, and os/user implements no lookups. Called from
+// lookup, GetGroupIds and ssh/tailssh only when runtime.GOOS is "android".
+
+package osuser
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/user"
+	"path/filepath"
+	"strings"
+)
+
+// AndroidShell is the login shell of every Android user.
+const AndroidShell = "/system/bin/sh"
+
+// androidHome is where a session starts: writable by both users, and where
+// scp puts a file sent without a path, as adb push users expect.
+const androidHome = "/data/local/tmp"
+
+// androidUsers are the users a session can run as. The groups are the ones
+// adbd gives the shell user (system/core/adb/daemon/main.cpp: input, log, adb,
+// sdcard_rw, sdcard_r, ext_data_rw, ext_obb_rw, net_bt_admin, net_bt, inet,
+// net_bw_stats, readproc, uhid, readtracefs); without inet a non-root session
+// has no network. root is given the same so its tools see what shell's do.
+var androidUsers = []struct {
+	name, uid string
+}{
+	{"root", "0"},
+	{"shell", "2000"},
+}
+
+var androidGroups = []string{
+	"1004", "1007", "1011", "1015", "1028", "1078", "1079",
+	"3001", "3002", "3003", "3006", "3009", "3011", "3012",
+}
+
+func lookupAndroid(usernameOrUID string) (*user.User, error) {
+	for _, u := range androidUsers {
+		if usernameOrUID == u.name || usernameOrUID == u.uid {
+			return &user.User{
+				Uid:      u.uid,
+				Gid:      u.uid,
+				Username: u.name,
+				Name:     u.name,
+				HomeDir:  androidHome,
+			}, nil
+		}
+	}
+	return nil, fmt.Errorf("user %q: Tailscale SSH on Android logs in as %s", usernameOrUID, strings.Join(AndroidUsernames(), " or "))
+}
+
+func androidGroupIds(u *user.User) ([]string, error) {
+	return append([]string{u.Gid}, androidGroups...), nil
+}
+
+// AndroidUsernames lists the users for the admin console's SSH hints.
+func AndroidUsernames() []string {
+	names := make([]string, len(androidUsers))
+	for i, u := range androidUsers {
+		names[i] = u.name
+	}
+	return names
+}
+
+// AndroidPath is adb shell's PATH. root also gets the root managers' tool
+// directories (KernelSU, APatch, Magisk), where su and their CLIs live.
+func AndroidPath(u *user.User) string {
+	p := "/product/bin:/apex/com.android.runtime/bin:/apex/com.android.art/bin:/system_ext/bin:/system/bin:/system/xbin:/odm/bin:/vendor/bin:/vendor/xbin"
+	if u.Uid == "0" {
+		p = "/debug_ramdisk:/sbin:" + p + ":/data/adb/ksu/bin:/data/adb/ap/bin:/data/adb/magisk"
+	}
+	return p
+}
+
+// androidEnvKey reports the variables a shell on Android expects from init:
+// app_process, and with it am, pm and similar tools, does not start without
+// BOOTCLASSPATH and the ANDROID_* roots. Only these are passed on, never the
+// daemon's own environment, which may hold the app's settings.
+func androidEnvKey(k string) bool {
+	switch k {
+	case "BOOTCLASSPATH", "DEX2OATBOOTCLASSPATH", "SYSTEMSERVERCLASSPATH",
+		"STANDALONE_SYSTEMSERVER_JARS", "EXTERNAL_STORAGE", "ASEC_MOUNTPOINT":
+		return true
+	}
+	// ANDROID_SOCKET_* name descriptors of the process they were read from.
+	return strings.HasPrefix(k, "ANDROID_") && !strings.HasPrefix(k, "ANDROID_SOCKET_")
+}
+
+var androidEnvDefaults = []string{
+	"ANDROID_ROOT=/system",
+	"ANDROID_DATA=/data",
+	"ANDROID_STORAGE=/storage",
+	"ANDROID_ASSETS=/system/app",
+	"ANDROID_ART_ROOT=/apex/com.android.art",
+	"ANDROID_I18N_ROOT=/apex/com.android.i18n",
+	"ANDROID_TZDATA_ROOT=/apex/com.android.tzdata",
+	"EXTERNAL_STORAGE=/sdcard",
+}
+
+// AndroidEnviron returns the Android variables for a session whose
+// environment so far is have: from the daemon's own environment, then from
+// zygote's (init starts it with the full set; root can read it), then the
+// platform defaults. TMPDIR points at the directory both users can write.
+func AndroidEnviron(have []string) []string {
+	seen := map[string]bool{}
+	for _, kv := range have {
+		k, _, _ := strings.Cut(kv, "=")
+		seen[k] = true
+	}
+	var out []string
+	add := func(kvs []string) {
+		for _, kv := range kvs {
+			k, _, ok := strings.Cut(kv, "=")
+			if !ok || seen[k] || !androidEnvKey(k) {
+				continue
+			}
+			seen[k] = true
+			out = append(out, kv)
+		}
+	}
+	add(os.Environ())
+	add(zygoteEnviron())
+	add(androidEnvDefaults)
+	if !seen["TMPDIR"] {
+		out = append(out, "TMPDIR="+androidHome)
+	}
+	return out
+}
+
+func zygoteEnviron() []string {
+	procs, _ := filepath.Glob("/proc/[0-9]*/cmdline")
+	for _, p := range procs {
+		cmd, err := os.ReadFile(p)
+		if err != nil {
+			continue
+		}
+		name, _, _ := bytes.Cut(cmd, []byte{0})
+		if string(name) != "zygote64" && string(name) != "zygote" {
+			continue
+		}
+		env, err := os.ReadFile(filepath.Join(filepath.Dir(p), "environ"))
+		if err != nil || len(env) == 0 {
+			continue
+		}
+		return strings.Split(strings.TrimRight(string(env), "\x00"), "\x00")
+	}
+	return nil
+}
