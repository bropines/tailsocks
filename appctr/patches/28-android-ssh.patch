@@ -0,0 +1,86 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+// Tailsocks: the Android user table and session environment (android.go).
+
+package osuser
+
+import (
+	"slices"
+	"strings"
+	"testing"
+)
+
+func TestLookupAndroid(t *testing.T) {
+	for _, in := range []string{"root", "0"} {
+		u, err := lookupAndroid(in)
+		if err != nil || u.Uid != "0" || u.Username != "root" {
+			t.Errorf("lookupAndroid(%q) = %+v, %v; want root", in, u, err)
+		}
+	}
+	for _, in := range []string{"shell", "2000"} {
+		u, err := lookupAndroid(in)
+		if err != nil || u.Uid != "2000" || u.Gid != "2000" || u.Username != "shell" {
+			t.Errorf("lookupAndroid(%q) = %+v, %v; want shell", in, u, err)
+		}
+	}
+	for _, in := range []string{"u0_a375", "10375", "system", "1000", ""} {
+		if u, err := lookupAndroid(in); err == nil {
+			t.Errorf("lookupAndroid(%q) = %+v; want an error", in, u)
+		}
+	}
+}
+
+func TestAndroidGroupsCarryInet(t *testing.T) {
+	u, _ := lookupAndroid("shell")
+	ids, err := androidGroupIds(u)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ids[0] != "2000" {
+		t.Errorf("first group = %q; want the primary 2000", ids[0])
+	}
+	// Without inet a session that is not root has no network on Android.
+	if !slices.Contains(ids, "3003") {
+		t.Errorf("groups %v lack inet (3003)", ids)
+	}
+}
+
+func TestAndroidPath(t *testing.T) {
+	root, _ := lookupAndroid("root")
+	shell, _ := lookupAndroid("shell")
+	if p := AndroidPath(shell); !strings.Contains(p, "/system/bin") || strings.Contains(p, "/data/adb") {
+		t.Errorf("shell PATH = %q", p)
+	}
+	if p := AndroidPath(root); !strings.Contains(p, "/system/bin") || !strings.Contains(p, "/data/adb/ksu/bin") {
+		t.Errorf("root PATH = %q", p)
+	}
+}
+
+func TestAndroidEnvironKeepsSecretsOut(t *testing.T) {
+	t.Setenv("TS_SOCKS5_PASS", "hunter2")
+	t.Setenv("ALL_PROXY", "socks5://user:pass@127.0.0.1:1080")
+	t.Setenv("BOOTCLASSPATH", "/apex/a.jar:/apex/b.jar")
+	t.Setenv("ANDROID_SOCKET_zygote", "17")
+	t.Setenv("ANDROID_DATA", "/data")
+
+	env := AndroidEnviron([]string{"PATH=/system/bin", "HOME=/data/local/tmp"})
+	joined := strings.Join(env, "\n")
+	if strings.Contains(joined, "hunter2") || strings.Contains(joined, "pass@") {
+		t.Errorf("environment carries the daemon's secrets:\n%s", joined)
+	}
+	for _, kv := range env {
+		k, _, _ := strings.Cut(kv, "=")
+		switch {
+		case k == "ALL_PROXY", k == "TS_SOCKS5_PASS", strings.HasPrefix(k, "ANDROID_SOCKET_"):
+			t.Errorf("environment carries %s", k)
+		case k == "PATH", k == "HOME":
+			t.Errorf("environment sets %s again", k)
+		}
+	}
+	for _, want := range []string{"BOOTCLASSPATH=/apex/a.jar:/apex/b.jar", "ANDROID_DATA=/data", "ANDROID_ROOT=/system", "TMPDIR=/data/local/tmp"} {
+		if !slices.Contains(env, want) {
+			t.Errorf("environment lacks %q:\n%s", want, joined)
+		}
+	}
+}
