+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build android
+
+// Tailsocks: incubator_linux.go is left out on Android (it talks to logind over
+// D-Bus); this keeps its pty naming, so sessions get SSH_TTY and a utmp-style
+// name like Linux ones.
+
+package tailssh
+
+import (
+	"fmt"
+	"os"
+	"syscall"
+	"unsafe"
+)
+
+func init() {
+	ptyName = func(f *os.File) (string, error) {
+		var n uint32
+		_, _, e := syscall.Syscall(syscall.SYS_IOCTL, f.Fd(), syscall.TIOCGPTN, uintptr(unsafe.Pointer(&n)))
+		if e != 0 {
+			return "", e
+		}
+		return fmt.Sprintf("pts/%d", n), nil
+	}
+}
