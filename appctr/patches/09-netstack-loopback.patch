+// packetAddrs returns a packet's source and destination addresses, or zero
+// values for a packet that is neither IPv4 nor IPv6.
+func packetAddrs(pkt *stack.PacketBuffer) (src, dst netip.Addr) {
+	switch v := pkt.Network().(type) {
+	case header.IPv4:
+		return netip.AddrFrom4(v.SourceAddress().As4()), netip.AddrFrom4(v.DestinationAddress().As4())
+	case header.IPv6:
+		return netip.AddrFrom16(v.SourceAddress().As16()), netip.AddrFrom16(v.DestinationAddress().As16())
+	}
+	return netip.Addr{}, netip.Addr{}
+}
