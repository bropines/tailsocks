+// hostTUN is a TUN with a host behind it, as on Android's VPN: not a fake
+// one, so netstack sends packets meant for the host to it, and it counts them.
+type hostTUN struct {
+	tun.Device
+	writes atomic.Int64
+}
+
+func (h *hostTUN) IsFakeTun() bool { return false }
+
+func (h *hostTUN) Write(bufs [][]byte, offset int) (int, error) {
+	h.writes.Add(int64(len(bufs)))
+	return h.Device.Write(bufs, offset)
+}
+
+// makeNetstackOnTUN is makeNetstack on dev, shaped as tailscaled is on
+// Android's VPN (cmd/tailscaled/netstack.go), with self as the node's address.
+func makeNetstackOnTUN(tb testing.TB, dev tun.Device, self netip.Addr, config func(*Impl)) *Impl {
+	sys := tsd.NewSystem()
+	sys.Set(new(mem.Store))
+	dialer := new(tsdial.Dialer)
+	logf := tstest.WhileTestRunningLogger(tb)
+	eng, err := wgengine.NewUserspaceEngine(logf, wgengine.Config{
+		Tun:           dev,
+		Dialer:        dialer,
+		SetSubsystem:  sys.Set,
+		HealthTracker: sys.HealthTracker.Get(),
+		Metrics:       sys.UserMetricsRegistry(),
+		EventBus:      sys.Bus.Get(),
+	})
+	if err != nil {
+		tb.Fatal(err)
+	}
+	tb.Cleanup(func() { eng.Close() })
+	sys.Set(eng)
+
+	ns, err := Create(logf, sys.Tun.Get(), eng, sys.MagicSock.Get(), dialer, sys.DNSManager.Get(), sys.ProxyMapper())
+	if err != nil {
+		tb.Fatal(err)
+	}
+	tb.Cleanup(func() { ns.Close() })
+	sys.Set(ns)
+
+	lb, err := ipnlocal.NewLocalBackend(logf, logid.PublicID{}, sys, 0)
+	if err != nil {
+		tb.Fatalf("NewLocalBackend: %v", err)
+	}
+	tb.Cleanup(lb.Shutdown)
+
+	ns.ProcessLocalIPs = false
+	ns.ProcessSubnets = false
+	ns.CheckLocalTransportEndpoints = true
+	if config != nil {
+		config(ns)
+	}
+	if err := ns.Start(lb); err != nil {
+		tb.Fatalf("Start: %v", err)
+	}
+	ns.UpdateNetstackIPs(&netmap.NetworkMap{
+		SelfNode: (&tailcfg.Node{ID: 1, Addresses: []netip.Prefix{netip.PrefixFrom(self, 32)}}).View(),
+	})
+	return ns
+}
+
+// On Android's VPN the daemon reaches 100.100.100.100 through netstack — the
+// SOCKS5 server's connections to Taildrive and MagicDNS — and that connection
+// has to complete inside gVisor: neither its first packet nor the answers go
+// to WireGuard or to the host.
+func TestOwnServiceFlowStaysInNetstack(t *testing.T) {
+	self4 := netip.MustParseAddr("100.64.1.2")
+
+	// What the service IP forwards to: the debug loopback port, a listener
+	// on this machine's loopback that echoes.
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				defer c.Close()
+				io.Copy(c, c)
+			}()
+		}
+	}()
+	port := ln.Addr().(*net.TCPAddr).Port
+
+	host := &hostTUN{Device: tstun.NewFake()}
+	impl := makeNetstackOnTUN(t, host, self4, func(impl *Impl) {
+		impl.loopbackPort = &port
+	})
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	c, err := impl.DialContextTCP(ctx, netip.AddrPortFrom(serviceIP, uint16(port)))
+	if err != nil {
+		t.Fatalf("dial 100.100.100.100:%d through netstack: %v", port, err)
+	}
+	defer c.Close()
+	c.SetDeadline(time.Now().Add(10 * time.Second))
+	if _, err := c.Write([]byte("taildrive")); err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, len("taildrive"))
+	if _, err := io.ReadFull(c, buf); err != nil {
+		t.Fatalf("read the echo: %v", err)
+	}
+	if string(buf) != "taildrive" {
+		t.Fatalf("echo = %q", buf)
+	}
+	if n := host.writes.Load(); n != 0 {
+		t.Errorf("%d packets of netstack's own connection went to the host", n)
+	}
+}
+
+// What the routing decides, packet by packet: netstack's own flows to the
+// service IP loop back; an answer to the host's connection to it — no
+// endpoint of netstack's own on that side — still goes to the host.
+func TestOwnServiceFlowQueues(t *testing.T) {
+	self4 := netip.MustParseAddr("100.64.1.2")
+	impl := makeNetstackOnTUN(t, &hostTUN{Device: tstun.NewFake()}, self4, nil)
+
+	queue := func(src, dst string) outboundQueue {
+		pkt := makeUDP4PacketBuffer(netip.MustParseAddrPort(src), netip.MustParseAddrPort(dst))
+		defer pkt.DecRef()
+		return impl.outboundQueueForPacket(pkt)
+	}
+	if got := queue("100.64.1.2:40001", "100.100.100.100:53"); got != outboundLoopback {
+		t.Errorf("netstack's own packet to the service IP: queue %v, want loopback", got)
+	}
+	if got := queue("100.100.100.100:53", "100.64.1.2:40001"); got != outboundToHost {
+		t.Errorf("an answer to the host's DNS query: queue %v, want the host", got)
+	}
+
+	// A connected UDP endpoint of netstack's own — the SOCKS5 server's UDP
+	// to MagicDNS — and its answer loops back.
+	uc, err := impl.DialContextUDP(context.Background(), netip.MustParseAddrPort("100.100.100.100:53"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer uc.Close()
+	local := netip.MustParseAddrPort(uc.LocalAddr().String())
+	if got := queue("100.100.100.100:53", local.String()); got != outboundLoopback {
+		t.Errorf("the answer to netstack's own query from %v: queue %v, want loopback", local, got)
+	}
+}
