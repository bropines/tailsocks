+// isOwnServiceFlow reports whether pkt belongs to a connection netstack opened
+// itself to an address it serves, with a real TUN beneath it.
+//
+// TailSocks android-vpn: the daemon's UID is outside the VPN, so it dials the
+// service IP through netstack — the SOCKS5 server's connections to
+// 100.100.100.100, which is how the app reaches Taildrive and MagicDNS. Such a
+// connection begins and ends in gVisor, but upstream sends its packets away:
+// the first, to the service IP, out to WireGuard (injected packets skip the
+// quad-100 intercept), where no peer takes it; the answers, from the service
+// IP to this node's address, to the host, whose kernel knows no such
+// connection and resets it. Both stay in gVisor. An answer to the host's own
+// connection to the service IP still goes to the host: gVisor has no endpoint
+// on the host's side of it.
+func (ns *Impl) isOwnServiceFlow(pkt *stack.PacketBuffer) bool {
+	src, dst := packetAddrs(pkt)
+	switch {
+	case dst == serviceIP || dst == serviceIPv6:
+		return ns.isLocalIP(src)
+	case src == serviceIP || src == serviceIPv6 || ns.isVIPServiceIP(src):
+		return ns.isLocalIP(dst) && ns.hasEndpointForReply(pkt, src, dst)
+	}
+	return false
+}
+
+// hasEndpointForReply reports whether gVisor has an endpoint that pkt, sent
+// from src to dst, is the answer to: one whose local end is pkt's destination.
+func (ns *Impl) hasEndpointForReply(pkt *stack.PacketBuffer, src, dst netip.Addr) bool {
+	var srcPort, dstPort uint16
+	var transProto tcpip.TransportProtocolNumber
+	switch pkt.TransportProtocolNumber {
+	case header.TCPProtocolNumber:
+		h := header.TCP(pkt.TransportHeader().Slice())
+		if len(h) < header.TCPMinimumSize {
+			return false
+		}
+		srcPort, dstPort, transProto = h.SourcePort(), h.DestinationPort(), tcp.ProtocolNumber
+	case header.UDPProtocolNumber:
+		h := header.UDP(pkt.TransportHeader().Slice())
+		if len(h) < header.UDPMinimumSize {
+			return false
+		}
+		srcPort, dstPort, transProto = h.SourcePort(), h.DestinationPort(), udp.ProtocolNumber
+	default:
+		return false
+	}
+	netProto := ipv4.ProtocolNumber
+	if dst.Is6() {
+		netProto = ipv6.ProtocolNumber
+	}
+	id := stack.TransportEndpointID{
+		LocalAddress:  tcpip.AddrFromSlice(dst.AsSlice()),
+		LocalPort:     dstPort,
+		RemoteAddress: tcpip.AddrFromSlice(src.AsSlice()),
+		RemotePort:    srcPort,
+	}
+	return ns.ipstack.FindTransportEndpoint(netProto, transProto, id, nicID) != nil
+}
+
+// packetAddrs returns a packet's source and destination addresses, or zero
+// values for a packet that is neither IPv4 nor IPv6.
+func packetAddrs(pkt *stack.PacketBuffer) (src, dst netip.Addr) {
+	switch v := pkt.Network().(type) {
+	case header.IPv4:
+		return netip.AddrFrom4(v.SourceAddress().As4()), netip.AddrFrom4(v.DestinationAddress().As4())
+	case header.IPv6:
+		return netip.AddrFrom16(v.SourceAddress().As16()), netip.AddrFrom16(v.DestinationAddress().As16())
+	}
+	return netip.Addr{}, netip.Addr{}
+}
