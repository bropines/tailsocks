+// isLocalToNetstack reports whether ip is handled locally by this netstack instance
+// (either as a node local IP, service IP, or VIP service IP).
+func (ns *Impl) isLocalToNetstack(ip netip.Addr) bool {
+	return ns.isLocalIP(ip) || ip == serviceIP || ip == serviceIPv6 || ns.isVIPServiceIP(ip)
+}
