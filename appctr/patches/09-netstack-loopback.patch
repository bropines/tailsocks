+// IsFakeTUN reports whether the underlying TUN device is a fake TUN.
+func (t *Wrapper) IsFakeTUN() bool {
+	if t == nil || t.tdev == nil {
+		return false
+	}
+	type fakeTunDetector interface {
+		IsFakeTun() bool
+	}
+	if f, ok := t.tdev.(fakeTunDetector); ok {
+		return f.IsFakeTun()
+	}
+	return false
+}
+
+
 func (t *Wrapper) MTU() (int, error) {
 	return t.tdev.MTU()
 }
