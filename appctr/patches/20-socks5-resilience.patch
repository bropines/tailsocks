+// How long a client has to get through the greeting, the optional
+// authentication and the request. Without it a client that connects and then
+// says nothing holds a goroutine and a file descriptor for as long as the
+// daemon lives — and on a listener reachable from the LAN that is how the
+// daemon runs out of descriptors.
+const handshakeTimeout = 10 * time.Second
+
+// How long an outbound dial may take before the client is told the connection
+// failed.
+//
+// Upstream hard-codes five seconds, which is shorter than a DERP reconnect
+// (derphttp gives itself ten): when the relays are being reset, every dial in
+// that window fails although the path is coming back. Fifteen seconds rides
+// out the reconnect and still answers the client rather than hanging.
+const defaultDialTimeout = 15 * time.Second
+
+// dialTimeout is defaultDialTimeout unless TS_SOCKS5_DIAL_TIMEOUT overrides it
+// with a Go duration ("20s"). An unparseable value is ignored.
+func dialTimeout() time.Duration {
+	if v := os.Getenv("TS_SOCKS5_DIAL_TIMEOUT"); v != "" {
+		if d, err := time.ParseDuration(v); err == nil && d > 0 {
+			return d
+		}
+	}
+	return defaultDialTimeout
+}
