+// TailSocks: a way to wake every polling monitor in the process at once.
+//
+// On Android the polling interval is ten minutes, on the assumption that the
+// app calls InjectEvent on its monitor when the network moves. A monitor that
+// belongs to a library instead — tailcat's client, run inside the app — has
+// no handle to call that on, so it would not notice a Wi-Fi to cellular
+// switch for ten minutes. WakePollingMonitors makes each of them return from
+// Receive now; the Monitor then re-reads the interfaces as after a poll.
+var (
+	pollWakeMu sync.Mutex
+	pollWake   = make(chan struct{})
+)
+
+// WakePollingMonitors makes every polling monitor in this process poll now.
+func WakePollingMonitors() {
+	pollWakeMu.Lock()
+	close(pollWake)
+	pollWake = make(chan struct{})
+	pollWakeMu.Unlock()
+}
+
+func pollWakeChan() <-chan struct{} {
+	pollWakeMu.Lock()
+	defer pollWakeMu.Unlock()
+	return pollWake
+}
+
 func (pm *pollingMon) Receive() (message, error) {
 	d := 10 * time.Second
 	if runtime.GOOS == "android" {
