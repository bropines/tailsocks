+// staticHosts parses TS_STATIC_HOSTS once: comma- or semicolon-separated
+// "host=ip" pairs (an IPv6 address may be wrapped in brackets). It lets the
+// pinned single-host resolver still answer for the proxy host set by the
+// TailSocks app when the control plane is reached through a proxy.
+var staticHosts = sync.OnceValue(func() map[string][]netip.Addr {
+	m := map[string][]netip.Addr{}
+	for _, pair := range strings.FieldsFunc(os.Getenv("TS_STATIC_HOSTS"), func(r rune) bool { return r == ',' || r == ';' }) {
+		host, ipStr, ok := strings.Cut(strings.TrimSpace(pair), "=")
+		if !ok {
+			continue
+		}
+		host = strings.ToLower(strings.TrimSuffix(strings.TrimSpace(host), "."))
+		ipStr = strings.Trim(strings.TrimSpace(ipStr), "[]")
+		ip, err := netip.ParseAddr(ipStr)
+		if host == "" || err != nil {
+			continue
+		}
+		m[host] = append(m[host], ip.Unmap())
+	}
+	return m
+})
+
+func pickStaticIPs(ips []netip.Addr) (ip, v6 netip.Addr, allIPs []netip.Addr, err error) {
+	for _, a := range ips {
+		if !ip.IsValid() && a.Is4() {
+			ip = a
+		}
+		if !v6.IsValid() && a.Is6() {
+			v6 = a
+		}
+	}
+	if !ip.IsValid() {
+		ip = v6
+	}
+	return ip, v6, ips, nil
+}
